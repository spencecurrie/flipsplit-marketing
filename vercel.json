{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "comment": [
    "Redirects for URLs that exist on the old WordPress site but not on this one.",
    "Derived by diffing the old Yoast sitemaps (284 URLs) against this build (240).",
    "Blog posts are NOT listed here: /blog/<slug>/ paths carried over unchanged.",
    "Anything absent from this file 404s deliberately - old test and template",
    "pages (/sample-page/, /loi/test/, /results-blocks/, /single-blog/,",
    "/location-tampleate-sample-2025/) that should never have been indexed."
  ],
  "redirects": [
    { "source": "/blog/fs-reviews", "destination": "/reviews/", "permanent": true },
    { "source": "/blog/fs-reviews/:path*", "destination": "/reviews/", "permanent": true },
    { "source": "/blog/results", "destination": "/reviews/", "permanent": true },
    { "source": "/blog/results/:path*", "destination": "/reviews/", "permanent": true },
    { "source": "/flip-stories", "destination": "/reviews/", "permanent": true },
    { "source": "/flip-stories/:path*", "destination": "/reviews/", "permanent": true },

    { "source": "/blog/cat-story/:path*", "destination": "/blog/", "permanent": true },
    { "source": "/blog/author/:path*", "destination": "/blog/", "permanent": true },
    { "source": "/single-blog", "destination": "/blog/", "permanent": true },

    { "source": "/request-an-offer", "destination": "/request-offer/", "permanent": true },
    { "source": "/old-how-it-works", "destination": "/how-it-works/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home-2", "destination": "/", "permanent": true },
    { "source": "/opt-out-preferences", "destination": "/privacy-policy/", "permanent": true },

    { "source": "/login", "destination": "https://app.flipsplit.com/login", "permanent": true },
    { "source": "/forgot-password", "destination": "https://app.flipsplit.com/login", "permanent": true },
    { "source": "/overview", "destination": "https://app.flipsplit.com/overview", "permanent": true },
    { "source": "/application-submitted", "destination": "https://app.flipsplit.com/", "permanent": true },

    { "source": "/for-agents", "destination": "/how-it-works/", "permanent": false },
    { "source": "/pricing", "destination": "/how-it-works/", "permanent": false }
  ]
}
