---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'Customer Reviews | FlipSplit';
const pageDescription = 'Real reviews from homeowners who sold with FlipSplit. See what our customers say about our transparent process, fair offers, and profit-sharing model.';

const REVIEWS_URL = 'https://www.reviews.io/company-reviews/store/flipsplit';

const reviews = [
  { name: 'Sabrina E.', location: 'Southern California', initial: 'S', quote: 'They sent inspectors out before making an offer, were completely transparent throughout, and the quoted price matched the final payment exactly. Closing was convenient and everything went exactly as described. No surprises.' },
  { name: 'Rosemarie Jimenez', location: 'Los Angeles, CA', initial: 'R', quote: 'Everything that was discussed happened exactly as promised. The team was professional, friendly, informative, and responsive from start to finish. I felt confident in every step of the process.' },
  { name: 'Kim Topolski', location: 'Orange County, CA', initial: 'K', quote: 'FlipSplit made the entire transaction smooth even though my home was in less than perfect condition. Quick sale, no showings, and a direct transaction that took all the stress out of selling.' },
  { name: 'Deanna Azar', location: 'Inland Empire, CA', initial: 'D', quote: 'The process was quick, easy, fair, and genuinely pleasant from beginning to end. I didn’t expect selling my home to feel this stress-free. I would absolutely recommend FlipSplit to anyone.' },
  { name: 'Jennifer Cheng', location: 'San Diego, CA', initial: 'J', quote: 'Stephen walked me through every pro and con thoroughly so I could make an informed decision. The team remained flexible and responsive to all of my questions and inquiries throughout the entire process.' },
  { name: 'Nick Boyd', location: 'Los Angeles, CA', initial: 'N', quote: 'Fair offer, completely transparent throughout, and they delivered on every promise they made. I plan to use FlipSplit again in the future and have already recommended them to friends and family.' },
  { name: 'Eddie Francis', location: 'Southern California', initial: 'E', quote: 'I had a 10-day deadline and FlipSplit made it happen. The team handled everything professionally over Zoom meetings, explained what to expect at every stage, and never once made me feel rushed or pressured.' },
  { name: 'William Campbell', location: 'Orange County, CA', initial: 'W', quote: 'Easy, quick, and transparent. They met every commitment they made. The profit-sharing model on resale is a genuine differentiator — I walked away feeling like I got a fair deal, not a discounted one.' },
  { name: 'Felipe Ramirez Salazar', location: 'San Diego, CA', initial: 'F', quote: 'Excellent service from start to finish. The home renovation achieved top dollar at resale. Stephen was responsive and professional at every stage. Couldn’t be happier with how it all turned out.' },
];

const check = (size: number) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>`;

const trust = [
  { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>', label: 'No pressure. No obligations.', body: 'Every offer is free with zero commitment to accept.' },
  { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12C4 7.5 7.7 5 12 5s8 2.5 9.5 7c-1.5 4.5-5.2 7-9.5 7s-8-2.5-9.5-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>', label: '100% transparent offers.', body: 'We show you every number — comps, reno costs, projected resale.' },
  { icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M14.5 9c-.5-1-1.4-1.5-2.5-1.5-1.7 0-3 .9-3 2s1.3 2 3 2 3 .9 3 2-1.3 2-3 2c-1.1 0-2-.5-2.5-1.5"></path><path d="M12 6v1.5"></path><path d="M12 16.5V18"></path></svg>', label: 'You get paid twice.', body: 'Cash at closing, plus a potential bonus check if the home beats our projection.' },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <main>
    <!-- Hero -->
    <section id="top" class="pt-24 pb-20 border-b border-line">
      <div class="wrap max-w-[980px]! text-center">
        <span class="pill"><Fragment set:html={check(12)} />Verified Reviews</span>
        <h1 class="mt-5 text-[64px] max-[700px]:text-[42px] leading-[1.04] tracking-[-0.045em] font-semibold">Real homeowners.<br />Real results.</h1>
        <p class="mt-5 mx-auto text-[18px] leading-[1.55] text-muted max-w-[640px]">Every review is verified through REVIEWS.IO. We don't cherry-pick — this is our complete public record.</p>

        <div class="tnum mt-12 mx-auto max-w-[860px] border border-line rounded-2xl text-center grid grid-cols-4 max-[700px]:grid-cols-2">
          <div class="px-4 py-[26px]">
            <div class="text-[44px] leading-none font-semibold tracking-[-0.04em]">5.0</div>
            <div aria-label="5 out of 5 stars" role="img" class="mt-2 text-[15px] tracking-[2px]">★★★★★</div>
            <div class="mt-1.5 text-[13px] text-muted">Average rating</div>
          </div>
          <div class="px-4 py-[26px] border-l border-line">
            <div class="text-[44px] leading-none font-semibold tracking-[-0.04em]">100%</div>
            <div class="mt-3.5 mx-auto h-1.5 max-w-[120px] rounded-[3px] bg-ink" aria-hidden="true"></div>
            <div class="mt-2 text-[13px] text-muted">5-star reviews</div>
          </div>
          <div class="px-4 py-[26px] border-l border-line max-[700px]:border-l-0 max-[700px]:border-t">
            <div class="text-[44px] leading-none font-semibold tracking-[-0.04em]">10+</div>
            <div class="mt-[26px] text-[13px] text-muted">Verified homeowners</div>
          </div>
          <div class="px-4 py-[26px] border-l border-line max-[700px]:border-t flex items-center justify-center">
            <a href={REVIEWS_URL} target="_blank" rel="noopener" class="no-underline text-ink flex flex-col items-center gap-1 group">
              <span class="text-[15px] font-bold tracking-[0.02em]">REVIEWS.IO</span>
              <span class="text-[13px] text-muted">Verified source</span>
              <span class="mt-1.5 inline-flex items-center gap-1.5 text-[13px] font-medium px-2.5 py-1 border border-line-strong rounded-lg group-hover:text-muted">View all<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured review -->
    <section class="py-20">
      <div class="wrap max-w-[980px]!">
        <figure class="m-0 border-2 border-ink rounded-2xl p-8 flex gap-6 items-start max-[700px]:flex-col">
          <div class="shrink-0 w-14 h-14 rounded-full bg-ink text-white flex items-center justify-center text-[20px] font-semibold" aria-hidden="true">P</div>
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3">
              <span aria-label="5 out of 5 stars" role="img" class="text-[16px] tracking-[2px]">★★★★★</span>
              <span class="font-mono text-[11px] px-2 py-1 border border-line-strong rounded-md">Featured Review</span>
            </div>
            <blockquote class="mt-[18px] text-[19px] leading-[1.6] font-medium tracking-[-0.01em]">“FlipSplit gave my mother a better offer than any of their competitors. She received her full cash payment at closing, and then — months later — she got a profit-sharing check when the renovated home sold for more than projected. The renovations they did genuinely benefited the whole neighborhood. Highly recommend.”</blockquote>
            <figcaption class="mt-5 flex items-center gap-3 pt-4 border-t border-hairline">
              <span><span class="block text-[15px] font-semibold">Peter Lien</span><span class="block text-[13px] text-muted">Southern California</span></span>
              <span class="ml-auto inline-flex items-center gap-1.5 text-[12px] px-2 py-1 border border-line rounded-md"><Fragment set:html={check(12)} />Verified purchase</span>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- Reviews grid -->
    <section id="reviews" class="pt-20 pb-24 bg-wash border-y border-line">
      <div class="wrap-wide">
        <div class="text-center">
          <div class="eyebrow">All Reviews</div>
          <h2 class="fs-h2 mt-2.5">What our homeowners say.</h2>
        </div>
        <div class="mt-11 columns-3 gap-x-4 max-[1000px]:columns-2 max-[700px]:columns-1">
          {reviews.map((r) => (
            <figure class="break-inside-avoid m-0 mb-4 border border-line rounded-[14px] p-[22px] bg-white flex flex-col gap-3.5">
              <div class="flex items-center gap-3">
                <span class="shrink-0 w-10 h-10 rounded-full border border-line-strong flex items-center justify-center text-[14px] font-semibold" aria-hidden="true">{r.initial}</span>
                <figcaption class="flex-1 min-w-0"><span class="block text-[15px] font-semibold">{r.name}</span><span class="block text-[13px] text-muted">{r.location}</span></figcaption>
                <span class="inline-flex items-center gap-[5px] text-[12px] px-[7px] py-[3px] border border-line rounded-md"><Fragment set:html={check(11)} />Verified</span>
              </div>
              <span aria-label="5 out of 5 stars" role="img" class="text-[13px] tracking-[2px]">★★★★★</span>
              <blockquote class="m-0 text-[15px] leading-[1.6] text-ink-soft">“{r.quote}”</blockquote>
            </figure>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href={REVIEWS_URL} target="_blank" rel="noopener" class="no-underline text-ink hover:text-muted inline-flex items-center gap-2 h-12 px-5 border border-line-strong rounded-[10px] bg-white text-[14px] font-medium">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14L21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>Read all reviews on REVIEWS.IO
          </a>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="py-[72px]">
      <div class="wrap-wide">
        <div class="grid grid-cols-3 gap-4 max-[700px]:grid-cols-1">
          {trust.map((t) => (
            <div class="border border-line rounded-[14px] p-6 flex flex-col gap-2.5">
              <span class="w-11 h-11 border border-line-strong rounded-[10px] flex items-center justify-center" set:html={t.icon}></span>
              <span class="text-[17px] font-semibold">{t.label}</span>
              <span class="text-[14px] leading-[1.6] text-muted">{t.body}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="get-offer" class="py-24 bg-ink text-white">
      <div class="wrap max-w-[640px]! text-center">
        <div class="text-[12px] font-semibold uppercase tracking-[0.1em] text-[#BDBDB6]">Free. No obligation.</div>
        <h2 class="fs-h2 mt-3.5 text-white">Join our homeowners.<br />Get your free offer.</h2>
        <p class="mt-3.5 text-[17px] text-[#BDBDB6]">Results in 24–48 hours. No repairs. No agent fees.</p>
        <div class="mt-8">
          <AddressForm id="cta-form" theme="dark" align="center" showTrust={true} />
        </div>
      </div>
    </section>
  </main>

  <Footer current="/reviews/" />

</body>
</html>
