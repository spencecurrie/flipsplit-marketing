---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SocialMeta from '../components/SocialMeta.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';

// Account creation, moved here from the dashboard app so the whole funnel —
// steps 1-7, finish, signup, phone — runs on one origin. The app is now only
// the signed-in dashboard.
//
// Accepts ?claim=<token> from /offer/finish/. Two paths converge:
//   1. Email/password — handled inline in the submit handler
//   2. Google OAuth — Supabase redirects out to Google, then back to this same
//      URL with the session in the fragment. resumeIfSignedIn() picks up the
//      new authenticated state on load and runs the claim automatically.

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'Create your account | FlipSplit';
const pageDescription = 'Create your FlipSplit account to track your cash offer and manage your home sale.';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <SiteAnalytics />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <ClientRouter />
</head>
<body class="bg-cream text-ink font-sans antialiased">

  <header class="max-w-[1152px] mx-auto px-6 py-5">
    <a href="/" class="inline-flex items-center gap-2.5 h-11 no-underline text-ink">
      <img src="/logo-mark.png" alt="" width="34" height="34" class="block w-[34px] h-[34px] object-contain" />
      <span class="text-[19px] font-semibold tracking-[-0.02em]">FlipSplit</span>
    </a>
  </header>

  <main class="flex justify-center px-4 pt-2 pb-12">
    <div class="w-full max-w-[440px]">

      <div class="bg-white border border-line rounded-[16px] px-8 py-[34px] max-[420px]:px-5 max-[420px]:py-7">
        <h1 class="m-0 text-center text-[26px] leading-[1.2] tracking-[-0.03em] font-semibold text-ink">Create your account</h1>
        <p class="mt-1.5 mb-7 text-center text-[15px] text-muted">
          We'll text you the moment your offer is ready.
        </p>

        <!-- Google -->
        <button
          id="google-btn"
          type="button"
          class="w-full h-12 flex items-center justify-center gap-3 border border-line rounded-[12px] bg-white text-[15px] font-medium text-ink hover:bg-wash transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
            <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
          </svg>
          Continue with Google
        </button>

        <div class="flex items-center gap-3 my-6">
          <div class="flex-1 h-px bg-line"></div>
          <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#6B6B65]">or</span>
          <div class="flex-1 h-px bg-line"></div>
        </div>

        <!-- Email/password -->
        <form id="signup-form" class="flex flex-col gap-4" novalidate>
          <div class="grid grid-cols-2 gap-3 max-[420px]:grid-cols-1">
            <div>
              <label for="su-first" class="block text-[13px] font-medium text-ink mb-1.5">First name</label>
              <input
                id="su-first"
                type="text"
                required
                autocomplete="given-name"
                placeholder="Jane"
                class="w-full h-12 px-3.5 border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
              />
            </div>
            <div>
              <label for="su-last" class="block text-[13px] font-medium text-ink mb-1.5">Last name</label>
              <input
                id="su-last"
                type="text"
                required
                autocomplete="family-name"
                placeholder="Smith"
                class="w-full h-12 px-3.5 border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
              />
            </div>
          </div>
          <div>
            <label for="su-email" class="block text-[13px] font-medium text-ink mb-1.5">Email address</label>
            <input
              id="su-email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full h-12 px-3.5 border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
            />
          </div>
          <div>
            <label for="su-password" class="block text-[13px] font-medium text-ink mb-1.5">Password</label>
            <div class="relative">
              <input
                id="su-password"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="At least 8 characters"
                class="w-full h-12 pl-3.5 pr-[72px] border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
              />
              <button
                id="su-toggle-password"
                type="button"
                tabindex="-1"
                class="absolute right-1.5 top-1.5 h-9 px-2.5 rounded-[8px] bg-transparent text-[13px] font-medium text-muted hover:text-ink"
              >Show</button>
            </div>
          </div>

          <p id="su-error" class="hidden text-[14px] text-danger"></p>

          <button
            id="su-submit"
            type="submit"
            class="w-full h-12 mt-1 rounded-[12px] bg-ink hover:bg-ink-soft text-white text-[15px] font-medium transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >Create account</button>
        </form>

        <p class="mt-5 text-center text-[13px] leading-[1.6] text-[#6B6B65]">
          By creating an account you agree to FlipSplit's
          <a href="/terms-and-conditions/" class="text-muted underline hover:text-ink">Terms of Service</a> and
          <a href="/privacy-policy/" class="text-muted underline hover:text-ink">Privacy Policy</a>.
        </p>
      </div>

      <p class="mt-6 text-center text-[14px] text-muted">
        Already have an account?
        <a id="su-signin-link" href="/sign-in/" class="font-medium text-ink underline underline-offset-[3px] hover:text-muted">Sign in</a>
      </p>

    </div>
  </main>

  <script>
    import { getSupabase } from '../lib/supabase';
    import { handoffToApp } from '../lib/handoff';

    const supabase = getSupabase();

    // Wrapped and re-run on astro:page-load so the handlers survive a
    // ClientRouter swap; the dataset guard stops a re-run binding twice.
    function initSignup() {
      const form = document.getElementById('signup-form') as HTMLFormElement | null;
      if (!form || form.dataset.signupInit === '1') return;
      form.dataset.signupInit = '1';

      const firstEl    = document.getElementById('su-first')           as HTMLInputElement;
      const lastEl     = document.getElementById('su-last')            as HTMLInputElement;
      const emailEl    = document.getElementById('su-email')           as HTMLInputElement;
      const passwordEl = document.getElementById('su-password')        as HTMLInputElement;
      const pwToggle   = document.getElementById('su-toggle-password') as HTMLButtonElement;
      const errorEl    = document.getElementById('su-error')           as HTMLElement;
      const submitBtn  = document.getElementById('su-submit')          as HTMLButtonElement;
      const googleBtn  = document.getElementById('google-btn')         as HTMLButtonElement;

      const claim = new URL(window.location.href).searchParams.get('claim');
      let submitting = false;

      // Someone mid-funnel who turns out to already have an account: send them
      // back HERE afterwards, claim token intact, so resumeIfSignedIn() below
      // attaches their funnel answers and moves them on. Without the next
      // param the token is stranded and the funnel run is lost.
      const signinLink = document.getElementById('su-signin-link') as HTMLAnchorElement | null;
      if (signinLink) {
        const back = window.location.pathname + window.location.search;
        signinLink.href = `/sign-in/?next=${encodeURIComponent(back)}`;
      }

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      }
      function clearError() {
        errorEl.classList.add('hidden');
      }
      function setBusy(busy: boolean) {
        submitting = busy;
        submitBtn.disabled = busy;
        googleBtn.disabled = busy;
        [firstEl, lastEl, emailEl, passwordEl].forEach((el) => { el.disabled = busy; });
        submitBtn.textContent = busy ? 'Creating your account…' : 'Create account';
      }

      // ── Password show/hide ──
      pwToggle.addEventListener('click', () => {
        const showing = passwordEl.type === 'text';
        passwordEl.type = showing ? 'password' : 'text';
        pwToggle.textContent = showing ? 'Show' : 'Hide';
      });

      // For OAuth signups, the user arrives with name fields under OIDC-standard
      // keys: given_name / family_name / full_name. Copy those into
      // first_name / last_name / full_name so the rest of the product reads one
      // consistent shape regardless of signup method. No-op if already done.
      async function normalizeNameFromOAuth(u: any) {
        if (!u) return;
        const m = u.user_metadata || {};
        if (m.first_name && m.last_name) return;

        const first = m.given_name  || (m.full_name ? m.full_name.split(' ').slice(0, -1).join(' ') : '') || '';
        const last  = m.family_name || (m.full_name ? m.full_name.split(' ').slice(-1)[0] : '') || '';
        if (!first && !last) return;

        try {
          await supabase.auth.updateUser({
            data: { first_name: first, last_name: last, full_name: m.full_name || `${first} ${last}`.trim() },
          });
        } catch (e) {
          // Non-fatal — the OAuth fields are still readable as a fallback.
          console.warn('Could not normalize OAuth name into user_metadata:', e);
        }
      }

      async function runClaim(token: string, authMethod: string) {
        const { data: claimed, error: rpcError } = await supabase.rpc('claim_qualification_session', {
          p_token: token,
        });
        if (rpcError) throw rpcError;

        // claim_qualification_session returns the session row (composite type);
        // be defensive in case PostgREST hands it back as a single-element array.
        const session = Array.isArray(claimed) ? claimed[0] : claimed;

        // The offer range is NOT computed here. The app's "preparing your
        // offer" step list (PreparingOffer.jsx) runs compute-offer-range when
        // the homeowner lands, and only shows while the range is still missing.
        // Firing it from here raced the phone step: when this call landed
        // first, the homeowner went phone → dashboard with no loading screen
        // (Spencer, 2026-10-27).

        try {
          const { data: { user: authedUser } } = await supabase.auth.getUser();
          await supabase.from('events').insert({
            user_id: authedUser?.id,
            event_name: 'account_created',
            payload: { auth_method: authMethod },
          });
        } catch (e) {
          console.warn('Could not record account_created event:', e);
        }
        return session?.id as string | undefined;
      }

      // After a claim: a returning homeowner has given us their number before,
      // so the new property takes it (and whatever SMS consent they gave with
      // it) from their latest completed one and they go straight to the app.
      // A brand-new account has no number on file and must give one.
      //
      // Copying the number completes the session exactly as the phone page
      // would, so the new-lead rep alert and the welcome texts fire for this
      // property just as they did for the first.
      async function routeAfterClaim(userId: string, sessionId?: string) {
        // The phone page is told which lead this is, rather than guessing "the
        // newest unfinished one" (a newer draft would steal the number).
        const toPhone = () => window.location.assign(sessionId ? `/signup/phone/?session=${sessionId}` : '/signup/phone/');
        if (!sessionId) { toPhone(); return; }
        const { data: prior } = await supabase
          .from('qualification_sessions')
          .select('phone, tcpa_consent_accepted_at, tcpa_consent_text, tcpa_consent_ip')
          .eq('user_id', userId)
          .neq('id', sessionId)
          .not('phone', 'is', null)
          .order('created_at', { ascending: false })
          .limit(1)
          .maybeSingle();
        if (!prior?.phone) { toPhone(); return; }

        const now = new Date().toISOString();
        const { error: updErr } = await supabase
          .from('qualification_sessions')
          .update({
            phone: prior.phone,
            // The consent record stays what it was: when and how they agreed.
            tcpa_consent_accepted_at: prior.tcpa_consent_accepted_at,
            tcpa_consent_text: prior.tcpa_consent_text,
            tcpa_consent_ip: prior.tcpa_consent_ip,
            status: 'completed',
            completed_at: now,
            current_step: 7,
          })
          .eq('id', sessionId);
        // Couldn't copy it: fall back to asking, rather than land them in the
        // app with a lead we can't call.
        if (updErr) { console.warn('Could not reuse phone:', updErr); toPhone(); return; }

        await supabase.from('events').insert([
          { session_id: sessionId, user_id: userId, event_name: 'phone_captured',
            payload: { reused_from_account: true, consent_given: !!prior.tcpa_consent_accepted_at } },
          { session_id: sessionId, user_id: userId, event_name: 'funnel_completed', payload: {} },
        ]);
        await handoffToApp(supabase, `/?session_id=${sessionId}`);
      }

      // Where an authenticated user *should* be, based on whether they have
      // already completed phone capture.
      async function routeOnboardedUser(userId: string) {
        const { data: sessions } = await supabase
          .from('qualification_sessions')
          .select('id, phone')
          .eq('user_id', userId)
          .order('created_at', { ascending: false })
          .limit(1);

        if (sessions?.[0]?.phone) {
          await handoffToApp(supabase, '/');
        } else {
          window.location.assign('/signup/phone/');
        }
      }

      // ── Google OAuth return, and the "already signed in" case ──
      async function resumeIfSignedIn() {
        const { data: { session } } = await supabase.auth.getSession();
        const user = session?.user;
        if (!user || user.is_anonymous || submitting) return;

        setBusy(true);
        try {
          // Verify the JWT still maps to a real user on the server. If the
          // account was deleted, the cached session is stale — sign out so they
          // can start fresh instead of hitting an opaque FK error on claim.
          const { data, error } = await supabase.auth.getUser();
          if (error || !data?.user) throw new Error('STALE_SESSION');

          await normalizeNameFromOAuth(data.user);

          // No claim token → already signed up; just route them onward.
          if (!claim) {
            await routeOnboardedUser(data.user.id);
            return;
          }

          try {
            const sessionId = await runClaim(claim, 'google');
            await routeAfterClaim(data.user.id, sessionId);
          } catch (claimErr: any) {
            // Token already consumed (e.g. they came back here after a
            // successful first signup). Treat as "already done" and route
            // forward rather than showing a scary error.
            if (String(claimErr?.message || '').includes('Invalid or expired claim token')) {
              await routeOnboardedUser(data.user.id);
              return;
            }
            throw claimErr;
          }
        } catch (err: any) {
          console.error('Auto-claim failed:', err);
          if (err?.message === 'STALE_SESSION') {
            try { await supabase.auth.signOut(); } catch { /* ignore */ }
            setBusy(false);
            return;
          }
          showError('Something went wrong on our end. Please try again, or email us at info@flipsplit.com.');
          setBusy(false);
        }
      }

      // ── Google ──
      googleBtn.addEventListener('click', async () => {
        clearError();
        try {
          // Carry the claim token through Google by encoding it in the return URL.
          const redirectTo = `${window.location.origin}/signup/${claim ? `?claim=${encodeURIComponent(claim)}` : ''}`;
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo,
              // Without this Google silently reuses the one account already
              // signed in on the device and bounces straight back, which reads
              // as the button doing nothing. Always show the account chooser:
              // people sign up for this under a different address than the one
              // their browser happens to be logged into.
              queryParams: { prompt: 'select_account' },
            },
          });
          if (error) throw error;
          // Browser is redirecting to Google now…
        } catch (err: any) {
          console.error(err);
          showError("We couldn't start Google sign-in. Please try again, or email us at info@flipsplit.com.");
        }
      });

      // ── Email + password ──
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitting) return;
        clearError();

        const first = firstEl.value.trim();
        const last  = lastEl.value.trim();
        const email = emailEl.value.trim();
        const password = passwordEl.value;

        if (!first || !last)      return showError('Please enter your first and last name.');
        if (!email)               return showError('Please enter your email address.');
        if (password.length < 8)  return showError('Password must be at least 8 characters.');

        setBusy(true);
        try {
          const { data, error } = await supabase.auth.signUp({
            email,
            password,
            options: { data: { first_name: first, last_name: last, full_name: `${first} ${last}`.trim() } },
          });
          if (error) throw error;

          // If the project ever requires email confirmation, signUp returns a
          // user but no session — and we cannot claim without one.
          if (!data.session) {
            showError('Check your email to confirm your account. Once confirmed you can sign in to continue.');
            setBusy(false);
            return;
          }

          // A brand-new account never has a number on file, so this always
          // lands on the phone step; routeAfterClaim keeps one rule for both.
          const sessionId = claim ? await runClaim(claim, 'email_password') : undefined;
          if (sessionId) await routeAfterClaim(data.user!.id, sessionId);
          else window.location.assign('/signup/phone/');
        } catch (err: any) {
          console.error(err);
          // Supabase's own wording is fine for the ones a homeowner can fix;
          // anything else gets the generic line.
          showError(err?.code === 'user_already_exists' || err?.code === 'email_exists'
            ? 'An account with this email already exists. Please sign in instead.'
            : err?.code === 'weak_password' || err?.code === 'email_address_invalid'
              ? err.message
              : 'Something went wrong on our end. Please try again, or email us at info@flipsplit.com.');
          setBusy(false);
        }
      });

      resumeIfSignedIn();
    }

    initSignup();
    document.addEventListener('astro:page-load', initSignup);
  </script>

</body>
</html>
