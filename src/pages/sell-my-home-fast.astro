---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const stats = [
  { n: '01', value: '24–48 hrs', label: 'Offer turnaround', dark: false },
  { n: '02', value: '7 days', label: 'Fastest close', dark: false },
  { n: '03', value: '$0', label: 'Fees or commissions', dark: true },
  { n: '04', value: '5.0★', label: 'Customer rating', dark: false },
];

const situations = [
  'As-is homes needing major repairs', 'Inherited or estate properties', 'Tenant-occupied rental properties',
  'Code violations or unpermitted work', 'Pre-foreclosure or behind on payments', 'Fire, water, or storm damage',
  'Probate or trust sales', 'Out-of-state owner situations', 'Divorce or estate settlements',
  'Hoarding or severe neglect', 'Foundation or structural issues', 'Behind on property taxes',
];

const steps = [
  { num: '01', title: 'Submit your address', body: 'Enter your property address and we begin our evaluation immediately — pulling comparable sales and building your offer within 24–48 hours.' },
  { num: '02', title: 'Review your offer', body: 'We walk you through every number: comparable sales, renovation scope, projected resale value, and your profit-split terms. No pressure, no deadlines.' },
  { num: '03', title: 'Close on your schedule', body: 'Accept the offer and choose your closing date — as fast as 7 days or up to 90 days. Your cash hits at closing.' },
  { num: '04', title: 'Collect a potential bonus', body: 'FlipSplit renovates and relists. If the home sells above the projected value, a potential profit-split check arrives within 10 days of resale.' },
];

// [feature, FlipSplit, Traditional Agent, Cash Buyer]; yes = true shows a check.
const compare: [string, ...[boolean, string][]][] = [
  ['Fees & commissions', [true, 'Zero'], [false, '5–6%'], [true, 'Zero']],
  ['Repairs required', [true, 'None'], [false, 'Often yes'], [true, 'None']],
  ['Profit sharing', [true, 'Yes'], [false, 'No'], [false, 'No']],
  ['Distressed properties', [true, 'Yes'], [false, 'Limited'], [true, 'Yes']],
  ['Cash at closing', [true, 'Yes'], [false, 'Depends'], [true, 'Yes']],
  ['Close in 7 days', [true, 'Yes'], [false, '30–60 days'], [true, 'Yes']],
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sell My Home Fast | Cash Offer in 24–48 Hours | FlipSplit</title>
  <meta name="description" content="Sell your home fast with FlipSplit. Get a guaranteed cash offer in 24–48 hours, close in as few as 7 days, and share in the profit when your home resells." />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="bg-white text-ink antialiased">

  <Nav />

  <!-- Hero -->
  <section id="top" class="py-24 border-b border-line">
    <div class="wrap-wide">
      <div class="grid grid-cols-2 gap-14 items-center max-[1000px]:grid-cols-1">
        <div>
          <span class="pill"><span class="pill-dot bg-ink"></span>Fast. Simple. Fair.</span>
          <h1 class="fs-h1 mt-5 mb-0 max-[700px]:text-[42px]">Sell your home<br />fast. Keep the upside.</h1>
          <p class="fs-lede mt-5 mb-0 max-w-[520px]">Get a guaranteed cash offer in 24–48 hours. Close in as few as 7 days. And if the renovated home sells for more than projected — you get a cut.</p>
          <div class="mt-8">
            <AddressForm id="sf-hero-form" />
          </div>
        </div>
        <div class="tnum grid grid-cols-2 gap-3">
          {stats.map((s) => (
            <div class:list={['rounded-[14px] p-[26px] flex flex-col gap-2', s.dark ? 'bg-ink text-white' : 'border border-line']}>
              <span class:list={['self-start font-mono text-[11px] px-[7px] py-[3px] border rounded-md', s.dark ? 'border-[#3A3A36]' : 'border-line-strong']}>{s.n}</span>
              <span class="mt-3.5 text-[34px] leading-none font-semibold tracking-[-0.035em]">{s.value}</span>
              <span class:list={['text-[13px]', s.dark ? 'text-[#BDBDB6]' : 'text-muted']}>{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why FlipSplit -->
  <section id="sell" class="py-24">
    <div class="wrap-wide">
      <div class="text-center">
        <div class="eyebrow">Why FlipSplit</div>
        <h2 class="fs-h2 mt-2.5 mb-0">Not just fast. The best outcome.</h2>
      </div>
      <div class="grid grid-cols-3 gap-4 mt-11 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1">
        <div class="border border-line rounded-2xl p-7">
          <span class="w-11 h-11 border border-line-strong rounded-[10px] flex items-center justify-center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M14.5 9c-.5-1-1.4-1.5-2.5-1.5-1.7 0-3 .9-3 2s1.3 2 3 2 3 .9 3 2-1.3 2-3 2c-1.1 0-2-.5-2.5-1.5"></path><path d="M12 6v1.5"></path><path d="M12 16.5V18"></path></svg></span>
          <h3 class="mt-5 mb-0 text-[19px] font-semibold tracking-[-0.01em]">Maximum cash offer</h3>
          <p class="mt-2.5 mb-0 text-[15px] leading-[1.6] text-muted">We price our offers to maximize your upfront payout — not to leave room for us to profit on the buy. We only make money on the renovation.</p>
        </div>
        <div class="border border-line rounded-2xl p-7">
          <span class="w-11 h-11 border border-line-strong rounded-[10px] flex items-center justify-center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><path d="M9 22V12h6v10"></path></svg></span>
          <h3 class="mt-5 mb-0 text-[19px] font-semibold tracking-[-0.01em]">Sell completely as-is</h3>
          <p class="mt-2.5 mb-0 text-[15px] leading-[1.6] text-muted">No repairs, no cleaning, no staging. Leave whatever you don't want behind. We handle all of it — at zero cost to you.</p>
        </div>
        <div class="border border-line rounded-2xl p-7">
          <span class="w-11 h-11 border border-line-strong rounded-[10px] flex items-center justify-center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"></path><path d="M9 14l6-6"></path><circle cx="9.5" cy="8.5" r="0.6"></circle><circle cx="14.5" cy="13.5" r="0.6"></circle></svg></span>
          <h3 class="mt-5 mb-0 text-[19px] font-semibold tracking-[-0.01em]">You get paid twice</h3>
          <p class="mt-2.5 mb-0 text-[15px] leading-[1.6] text-muted">Cash at closing is just the start. If the renovated home sells above projection, you may receive a potential bonus check — often within 90–120 days.</p>
          <div class="mt-4 flex gap-[3px] h-1.5" aria-hidden="true">
            <div class="flex-[85] bg-ink rounded-l-[3px]"></div>
            <div class="hatch flex-[15] rounded-r-[3px]"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- We buy any condition -->
  <section class="py-24 bg-cream">
    <div class="wrap-wide">
      <div class="text-center max-w-[640px] mx-auto">
        <div class="eyebrow">We Buy It All</div>
        <h2 class="fs-h2 mt-2.5 mb-0">No situation is too complicated.</h2>
        <p class="mt-3.5 mb-0 text-[17px] leading-[1.55] text-muted">FlipSplit buys homes in situations that traditional agents and iBuyers won't touch.</p>
      </div>
      <ul class="list-none m-0 p-0 grid grid-cols-3 gap-2.5 mt-11 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1">
        {situations.map((s) => (
          <li class="flex items-center gap-3 bg-white border border-line rounded-xl px-[18px] py-4">
            <span class="shrink-0 w-[22px] h-[22px] rounded-full bg-ink text-white flex items-center justify-center"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg></span>
            <span class="text-[15px]">{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24">
    <div class="wrap max-w-[880px]">
      <div class="text-center">
        <div class="eyebrow">The Process</div>
        <h2 class="fs-h2 mt-2.5 mb-0">Four steps to sold.</h2>
      </div>
      <ol class="list-none m-0 p-0 mt-11 flex flex-col gap-3">
        {steps.map((st, i) => {
          const dark = i === steps.length - 1;
          return (
            <li class:list={['flex gap-5 items-start p-6 rounded-[14px] border', dark ? 'bg-ink text-white border-ink' : 'bg-white text-ink border-line']}>
              <span class:list={['shrink-0 w-10 h-10 rounded-[10px] border flex items-center justify-center font-mono text-[13px]', dark ? 'border-[#3A3A36]' : 'border-line-strong']}>{st.num}</span>
              <div>
                <h3 class:list={['m-0 text-[17px] font-semibold', dark ? '!text-white' : 'text-ink']}>{st.title}</h3>
                <p class:list={['mt-1.5 mb-0 text-[15px] leading-[1.6]', dark ? 'text-[#BDBDB6]' : 'text-muted']}>{st.body}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- Comparison -->
  <section class="py-24 bg-wash border-t border-line">
    <div class="wrap">
      <h2 class="fs-h2 m-0 text-center">How we compare.</h2>
      <div class="mt-11 overflow-x-auto border border-line rounded-2xl bg-white">
        <table class="w-full min-w-[640px] border-collapse">
          <thead>
            <tr>
              <th scope="col" class="text-left px-6 py-[18px] text-[13px] font-medium text-muted border-b border-line"><span class="sr-only">Feature</span></th>
              <th scope="col" class="px-6 py-[18px] text-[15px] font-semibold bg-ink text-white">FlipSplit</th>
              <th scope="col" class="px-6 py-[18px] text-[15px] font-medium border-b border-line">Traditional Agent</th>
              <th scope="col" class="px-6 py-[18px] text-[15px] font-medium border-b border-line">Cash Buyer</th>
            </tr>
          </thead>
          <tbody>
            {compare.map(([feature, ...cells]) => (
              <tr>
                <th scope="row" class="text-left px-6 py-4 text-[15px] font-medium border-t border-hairline">{feature}</th>
                {cells.map(([yes, text], i) => (
                  <td class:list={['px-6 py-4 text-center text-[14px] border-t border-hairline', i === 0 ? 'bg-wash' : 'bg-white']}>
                    <span class:list={['inline-flex items-center gap-2', i === 0 ? 'font-semibold' : 'font-normal', yes ? 'text-ink' : 'text-[#6B6B65]']}>
                      {yes ? (
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-label="Yes" role="img"><path d="M5 12l5 5L20 7"></path></svg>
                      ) : (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-label="No" role="img"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>
                      )}
                      {text}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="get-offer" class="py-24 bg-ink text-white">
    <div class="wrap max-w-[640px] text-center">
      <h2 class="fs-h2 m-0 !text-white">Get your free offer today.</h2>
      <p class="mt-3.5 mb-0 text-[17px] text-[#BDBDB6]">No fees. No repairs. No obligation. Results in 24–48 hours.</p>
      <div class="mt-8">
        <AddressForm id="sf-cta-form" theme="dark" align="center" />
      </div>
    </div>
  </section>

  <Footer current="/sell-my-home-fast/" />

</body>
</html>
