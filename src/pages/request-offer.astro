---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';
import Analytics from '@vercel/analytics/astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'Request a Free Cash Offer | FlipSplit';
const pageDescription = 'Request your free cash offer from FlipSplit. Enter your address and get a no-obligation offer within 24–48 hours. No repairs, no fees, no pressure.';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <Analytics />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <main>
    <!-- Headline + input -->
    <section id="top" class="pt-14 pb-8 text-center">
      <div class="wrap"><div class="max-w-[680px] mx-auto">
        <h1 class="fs-h1 max-[700px]:text-[38px]!">Let's start your offer</h1>
        <p class="mt-4 mx-auto max-w-[560px] text-[18px] leading-[1.55] text-muted">Enter your address to get started. This helps us find sales data for your home and other homes nearby.</p>
        <div class="mt-8">
          <AddressForm id="request-form" theme="light" align="center" showTrust={false} />
        </div>
      </div></div>
    </section>

    <!-- Arch-framed hero image -->
    <div class="px-6 pb-[72px] flex justify-center">
      <div class="h-[520px] max-[1000px]:h-[420px] max-[700px]:h-[300px] aspect-[5/4] max-w-full overflow-hidden rounded-t-full border border-line bg-mute">
        <img src="/reskin/request-offer-home.jpg" alt="A FlipSplit renovated home" class="block w-full h-full object-cover select-none" draggable="false" />
      </div>
    </div>
  </main>

  <Footer current="/request-offer/" />

</body>
</html>
