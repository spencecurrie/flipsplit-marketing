---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import SocialMeta from '../components/SocialMeta.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'Sign in | FlipSplit';
const pageDescription = 'Sign in to your FlipSplit account or create one to track your offer, manage your sale, and access your dashboard.';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <SiteAnalytics />
  {/* auth page, no search value */}
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <ClientRouter />
</head>
<body class="bg-cream text-ink font-sans antialiased">

  <Nav />

  <main class="flex items-center justify-center px-4 py-[72px]">
    <div class="w-full max-w-[440px]">
      <div class="bg-white border border-line rounded-[16px] px-8 py-9 max-[700px]:px-5 max-[700px]:py-7">

        <div class="w-12 h-12 mx-auto mb-5 border border-line rounded-[12px] flex items-center justify-center">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
        </div>

        <h1 id="auth-title" class="m-0 text-center text-[28px] leading-[1.15] tracking-[-0.03em] font-semibold text-ink">Sign in</h1>
        <p id="auth-sub" class="mt-1.5 mb-6 text-center text-[15px] text-muted">Welcome back to FlipSplit.</p>

        <!-- Google OAuth -->
        <button
          id="google-btn"
          type="button"
          class="w-full h-12 flex items-center justify-center gap-3 border border-line rounded-[12px] bg-white text-[15px] font-medium text-ink hover:bg-wash transition-colors disabled:opacity-50 disabled:cursor-wait"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285f4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
            <path fill="#34a853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
            <path fill="#fbbc05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
            <path fill="#ea4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
          </svg>
          <span id="google-label">Continue with Google</span>
        </button>

        <div class="flex items-center gap-3 my-6">
          <div class="flex-1 h-px bg-line"></div>
          <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#6B6B65]">or</span>
          <div class="flex-1 h-px bg-line"></div>
        </div>

        <!-- Email/password form -->
        <form id="auth-form" class="flex flex-col gap-4" novalidate>
          <div>
            <label for="auth-email" class="block text-[13px] font-medium text-ink mb-1.5">Email address</label>
            <input
              id="auth-email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full h-12 px-3.5 border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
            />
          </div>
          <div>
            <label for="auth-password" class="block text-[13px] font-medium text-ink mb-1.5">Password</label>
            <div class="relative">
              <input
                id="auth-password"
                type="password"
                required
                minlength="6"
                autocomplete="current-password"
                placeholder="At least 6 characters"
                class="w-full h-12 pl-3.5 pr-[72px] border border-line-strong rounded-[12px] bg-white text-[15px] text-ink placeholder:text-faint outline-none focus:border-ink transition-colors disabled:bg-mute"
              />
              <button
                id="toggle-password"
                type="button"
                tabindex="-1"
                class="absolute right-1.5 top-1.5 h-9 px-2.5 rounded-[8px] bg-transparent text-[13px] font-medium text-muted hover:text-ink"
              >Show</button>
            </div>
          </div>

          <p id="auth-error" class="hidden text-[14px] text-danger font-medium"></p>
          <p id="auth-success" class="hidden text-[14px] font-medium text-ink"></p>

          <button
            id="submit-btn"
            type="submit"
            class="w-full h-12 mt-1 rounded-[12px] bg-ink hover:bg-ink-soft text-white text-[15px] font-medium transition-colors disabled:opacity-60 disabled:cursor-wait"
          >
            <span id="submit-label">Sign in</span>
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-[14px] text-muted">
        New to FlipSplit?
        <a href="/signup/" class="ml-1 font-medium text-ink underline underline-offset-[3px] hover:text-muted">Create an account</a>
      </p>
    </div>
  </main>

  <script>
    import { getSupabase } from '../lib/supabase';

    const supabase = getSupabase();

    // Where to land after a successful sign-in. Signing in is not a request to
    // go to the dashboard — it is something you do so you can carry on reading
    // the page you were already on, so we come back here. The nav's Sign in
    // links pass ?next=<path>; document.referrer covers links that don't.
    // Only same-origin paths are honoured, so ?next= can never bounce someone
    // to another site ("//evil.com" is a valid URL, hence the second check).
    function resolveNext(): string {
      const raw = new URL(window.location.href).searchParams.get('next');
      if (raw && raw.startsWith('/') && !raw.startsWith('//')) return raw;
      try {
        const ref = new URL(document.referrer);
        if (ref.origin === window.location.origin && !ref.pathname.startsWith('/sign-in')) {
          return ref.pathname + ref.search;
        }
      } catch { /* no or unparseable referrer */ }
      return '/';
    }

    // Wrapped in initAuthPage() and re-run on astro:page-load so the form is
    // wired up after a ClientRouter swap — e.g. revisiting /sign-in via the
    // nav link rather than a full reload, which would otherwise leave the
    // form and buttons without their handlers. A dataset guard on the form
    // keeps a re-run from binding the same instance twice.
    //
    // This page signs people IN only. Account creation lives at /signup, which
    // also carries the funnel's claim token and collects a name — a second
    // signup path here would quietly create accounts missing both.

    function initAuthPage() {
    const form          = document.getElementById('auth-form')       as HTMLFormElement | null;
    if (!form || form.dataset.authInit === '1') return;
    form.dataset.authInit = '1';

    const submitLabelEl = document.getElementById('submit-label')    as HTMLElement;
    const passwordEl    = document.getElementById('auth-password')   as HTMLInputElement;
    const passwordToggle= document.getElementById('toggle-password') as HTMLButtonElement;
    const emailEl       = document.getElementById('auth-email')      as HTMLInputElement;
    const googleBtn     = document.getElementById('google-btn')      as HTMLButtonElement;
    const submitBtn     = document.getElementById('submit-btn')      as HTMLButtonElement;
    const errorEl       = document.getElementById('auth-error')      as HTMLElement;
    const successEl     = document.getElementById('auth-success')    as HTMLElement;

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
      successEl.classList.add('hidden');
    }
    function clearMessages() {
      errorEl.classList.add('hidden');
      successEl.classList.add('hidden');
    }
    function setBusy(busy: boolean) {
      submitBtn.disabled = busy;
      googleBtn.disabled = busy;
      submitLabelEl.textContent = busy ? 'Signing in…' : 'Sign in';
    }

    // ─ Already signed in? Nothing to do here — go back where they came from ─
    // This is also the Google OAuth landing: Google returns to this page with
    // the session in the URL fragment, and getUser() resolves behind the
    // client's URL-detection step, so the new session is in place by now.
    supabase.auth.getUser().then(({ data }) => {
      if (data?.user && !data.user.is_anonymous) {
        window.location.replace(resolveNext());
      }
    });

    // ─ Password show/hide ─
    passwordToggle.addEventListener('click', () => {
      const showing = passwordEl.type === 'text';
      passwordEl.type = showing ? 'password' : 'text';
      passwordToggle.textContent = showing ? 'Show' : 'Hide';
    });

    // ─ Google OAuth ─
    googleBtn.addEventListener('click', async () => {
      clearMessages();
      setBusy(true);
      try {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          // Back to this page, carrying the destination through Google so the
          // handler above can return them to whatever they were reading.
          options: {
            redirectTo: `${window.location.origin}/sign-in/?next=${encodeURIComponent(resolveNext())}`,
            // Always show the account chooser. Without it Google reuses
            // whichever account the device is already signed into, so someone
            // with two Gmail accounts cannot reach the other one.
            queryParams: { prompt: 'select_account' },
          },
        });
        if (error) throw error;
        // Browser is redirecting to Google now…
      } catch (err: any) {
        console.error('Google OAuth failed:', err);
        showError("We couldn't start Google sign-in. Please try again, or email us at info@flipsplit.com.");
        setBusy(false);
      }
    });

    // ─ Email + password ─
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearMessages();

      const email = emailEl.value.trim();
      const password = passwordEl.value;

      if (!email)    return showError('Please enter your email address.');
      if (!password) return showError('Please enter your password.');

      setBusy(true);
      try {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) throw error;
        window.location.assign(resolveNext());
      } catch (err: any) {
        console.error('Auth failed:', err);
        // Wrong password is worth saying plainly; anything else gets the generic line.
        showError(err?.code === 'invalid_credentials'
          ? "That email and password don't match. Please try again."
          : err?.code === 'email_not_confirmed'
            ? 'Please confirm your email first, then sign in.'
            : 'Something went wrong on our end. Please try again, or email us at info@flipsplit.com.');
        setBusy(false);
      }
    });
    }

    initAuthPage();
    document.addEventListener('astro:page-load', initAuthPage);
  </script>

</body>
</html>
