---
import { ClientRouter } from 'astro:transitions';
import Nav from '../../components/Nav.astro'
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import SocialMeta from '../../components/SocialMeta.astro';
import Analytics from '@vercel/analytics/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, description, pubDate, updatedDate, category, reviewer, heroImage, readingTime } = post.data;

// `post.id` — NOT `post.slug`, which does not exist on Astro 6 content-collection
// entries and silently stringifies to "undefined". getStaticPaths above already
// builds the route from post.id, so this is the URL by definition. The trailing
// slash matches `trailingSlash: 'always'`; the host comes from `site` in
// astro.config.mjs so it can never drift from the canonical hostname again.
const canonicalURL = new URL(`/blog/${post.id}/`, Astro.site).href;

// Table of contents. The design lists one flat level: use the post's H2s when
// it has enough of them, otherwise fall back to H2+H3 (some older posts are
// built mostly from H3s).
const h2s = headings.filter(h => h.depth === 2);
const tocHeadings = h2s.length >= 2 ? h2s : headings.filter(h => h.depth <= 3);

// Related posts (same category, excluding current)
const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === category)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 3);

function formatDate(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
const reviewerName = reviewer ?? 'Brandon Brown';
const initials = reviewerName.split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
const chevR = '<path d="M9 6l6 6-6 6"></path>';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — FlipSplit</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <SocialMeta title={title} description={description} url={canonicalURL} image={heroImage} type="article" />
  <Analytics />

  <style>
    .ph { background: repeating-linear-gradient(135deg, #E9E9E4 0 1px, #F4F4F1 1px 7px); }
  </style>
  <ClientRouter />
</head>
<body class="bg-white text-ink antialiased">

  <!-- Reading progress -->
  <div class="fixed top-0 inset-x-0 h-[3px] bg-hairline z-[100] pointer-events-none" aria-hidden="true">
    <div id="progress-bar" class="h-[3px] w-0 bg-ink"></div>
  </div>

  <Nav />

  <!-- Article header -->
  <header id="top" class="border-b border-line py-10">
    <div class="wrap-wide">
      <div class="grid grid-cols-[minmax(0,1fr)_300px] max-[1000px]:grid-cols-1 gap-16 max-[1000px]:gap-0 items-start">
        <div>
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-[13px] text-muted">
            <a href="/" class="no-underline text-muted hover:text-ink">Home</a>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={chevR} />
            <a href="/blog/" class="no-underline text-muted hover:text-ink">Blog</a>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={chevR} />
            <span class="text-ink font-medium">{category}</span>
          </nav>
          <h1 class="mt-[18px] text-[44px] max-[700px]:text-[30px] leading-[1.1] tracking-[-0.035em] font-semibold">{title}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-2 text-[13px] text-muted">
            <span class="font-medium text-ink px-[9px] py-1 rounded-md border border-line">{category}</span>
            <span class="font-mono inline-flex items-center gap-1.5 px-2 py-1 rounded-md border border-line"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M8 3v4"></path><path d="M16 3v4"></path></svg><time datetime={new Date(pubDate).toISOString().slice(0, 10)}>{formatDate(pubDate)}</time></span>
            {readingTime && <span class="font-mono px-2 py-1 rounded-md border border-line">{readingTime} min read</span>}
            {reviewer && <span>Reviewed by <strong class="text-ink font-semibold">{reviewer}</strong></span>}
            {updatedDate && <><span aria-hidden="true">·</span><span>Updated {formatDate(updatedDate)}</span></>}
          </div>
        </div>
        <div aria-hidden="true"></div>
      </div>
    </div>
  </header>

  <!-- Content + sidebar -->
  <div class="wrap-wide pt-14 pb-[72px]">
    <div class="grid grid-cols-[minmax(0,1fr)_300px] max-[1000px]:grid-cols-1 gap-16 max-[1000px]:gap-0 items-start">
      <article id="article-body">

        <!-- Mobile TOC -->
        {tocHeadings.length >= 2 && (
          <details class="hidden max-[1000px]:block mb-9 border border-line rounded-xl overflow-hidden">
            <summary class="flex justify-between items-center h-[52px] px-[18px] text-[14px] font-semibold">
              <span class="flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>In this article</span>
              <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5E5E58" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <nav aria-label="In this article" class="px-[18px] pt-1 pb-4 border-t border-hairline">
              {tocHeadings.map(h => (
                <a href={`#${h.slug}`} class="block py-2 text-[14px] no-underline text-ink hover:text-muted">{h.text}</a>
              ))}
            </nav>
          </details>
        )}

        <div class="blog-prose">
          <Content />
        </div>

        <!-- Reviewer bio -->
        <div class="mt-14 pt-10 border-t border-line max-w-[760px]">
          <div class="text-[12px] font-semibold uppercase tracking-[0.1em] text-muted">About the reviewer</div>
          <div class="mt-[18px] flex items-start gap-4 border border-line rounded-[14px] p-5">
            <span class="shrink-0 w-12 h-12 rounded-full bg-ink text-white text-[14px] font-semibold flex items-center justify-center" aria-hidden="true">{initials}</span>
            <div>
              <div class="text-[16px] font-semibold">{reviewerName}</div>
              <div class="text-[13px] text-muted mt-0.5">Licensed Real Estate Agent · Southern California</div>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-muted">Brandon is a licensed real estate professional with years of experience in the Southern California market. He reviews all FlipSplit content for accuracy, market relevance, and compliance.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="flex max-[1000px]:hidden flex-col gap-4 sticky top-24">
        <div class="bg-ink text-white rounded-2xl p-6">
          <div class="text-[12px] font-semibold uppercase tracking-[0.1em] text-[#BDBDB6]">Free. No obligation.</div>
          <h3 class="mt-2.5 text-[22px] leading-[1.2] tracking-[-0.02em] font-semibold !text-white">Choose your home offer price.</h3>
          <p class="mt-2.5 text-[14px] leading-[1.55] text-[#BDBDB6]">Share your address. We'll respond in 24–48 hours with a cash offer and renovation projection.</p>
          <a href="/request-offer/" class="mt-[18px] no-underline text-ink bg-white hover:bg-mute hover:text-ink text-[15px] font-medium h-12 rounded-[10px] flex items-center justify-center gap-2 transition-colors">Get My Free Offer<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
          <p class="mt-3 text-center text-[12px] text-ghost">Serving Southern California</p>
        </div>
        {tocHeadings.length >= 2 && (
          <div class="border border-line rounded-2xl p-[22px]">
            <div class="text-[12px] font-semibold uppercase tracking-[0.1em] text-muted">In this article</div>
            <nav id="toc-nav" aria-label="In this article" class="mt-3.5 flex flex-col gap-0.5 max-h-[calc(100vh-420px)] min-h-[160px] overflow-y-auto">
              {tocHeadings.map(h => (
                <a
                  href={`#${h.slug}`}
                  data-heading={h.slug}
                  class="toc-link block py-[7px] pl-3 text-[14px] leading-[1.4] no-underline border-l-2 border-transparent text-muted hover:text-ink aria-[current=location]:border-ink aria-[current=location]:text-ink aria-[current=location]:font-semibold"
                >{h.text}</a>
              ))}
            </nav>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Related -->
  {related.length > 0 && (
    <section class="border-t border-line pt-[72px] pb-[88px]">
      <div class="wrap-wide">
        <h2 class="m-0 text-[28px] tracking-[-0.025em] font-semibold">Keep reading</h2>
        <div class="mt-7 grid grid-cols-3 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1 gap-4">
          {related.map(p => (
            <a href={`/blog/${p.id}/`} class="flex flex-col rounded-2xl overflow-hidden text-ink no-underline border border-line hover:border-ink hover:text-ink transition-colors duration-[180ms]">
              <div class="ph aspect-[16/9] overflow-hidden">
                {p.data.heroImage && <img src={p.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
              </div>
              <div class="px-[22px] py-5">
                <span class="text-[13px] text-muted">{formatDate(p.data.pubDate)}</span>
                <h3 class="line-clamp-3 mt-1.5 text-[17px] leading-[1.4] font-semibold">{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer current="/blog/" />

  <style is:global>
    /* Article typography (2026-10 reskin BlogPost design). Scoped to
       .blog-prose so it never collides with the typography plugin's .prose. */
    .blog-prose { font-size: 18px; line-height: 1.75; color: var(--color-ink-soft); max-width: 760px; overflow-wrap: break-word; }
    .blog-prose > :first-child { margin-top: 0; }
    .blog-prose p { margin: 0 0 22px; }
    .blog-prose h2 { margin: 48px 0 16px; font-size: 28px; line-height: 1.2; letter-spacing: -0.025em; font-weight: 600; color: var(--color-ink); scroll-margin-top: 96px; }
    .blog-prose h3 { margin: 40px 0 12px; font-size: 22px; line-height: 1.3; letter-spacing: -0.02em; font-weight: 600; color: var(--color-ink); scroll-margin-top: 96px; }
    .blog-prose h4, .blog-prose h5, .blog-prose h6 { margin: 32px 0 10px; font-size: 19px; line-height: 1.35; font-weight: 600; color: var(--color-ink); scroll-margin-top: 96px; }
    .blog-prose :is(h2, h3, h4) strong { font-weight: inherit; }
    .blog-prose strong { font-weight: 600; color: var(--color-ink); }
    .blog-prose a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
    .blog-prose a:hover { color: var(--color-muted); }
    .blog-prose ul, .blog-prose ol { margin: 0 0 24px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .blog-prose li { position: relative; padding-left: 24px; }
    .blog-prose li > p { margin: 0; }
    .blog-prose li > :is(ul, ol) { margin: 10px 0 0; }
    .blog-prose ul > li::before { content: ''; position: absolute; left: 4px; top: 12px; width: 7px; height: 7px; border-radius: 2px; background: var(--color-ink); }
    .blog-prose ol { counter-reset: fs-ol; }
    .blog-prose ol > li { counter-increment: fs-ol; padding-left: 30px; }
    .blog-prose ol > li::before { content: counter(fs-ol); position: absolute; left: 0; top: 0.2em; font-family: var(--font-mono); font-size: 12px; line-height: 1; font-weight: 500; color: var(--color-ink); border: 1px solid var(--color-line-strong); border-radius: 6px; padding: 4px 5px; min-width: 20px; text-align: center; box-sizing: border-box; }
    .blog-prose sup { font-size: 11px; font-family: var(--font-mono); color: var(--color-muted); margin-left: 1px; }
    .blog-prose img { display: block; max-width: 100%; height: auto; border-radius: 14px; margin: 8px 0 28px; }
    .blog-prose p > img:only-child { margin: 0; }
    .blog-prose blockquote { margin: 0 0 24px; padding-left: 20px; border-left: 2px solid var(--color-ink); color: var(--color-ink); }
    .blog-prose hr { border: 0; border-top: 1px solid var(--color-line); margin: 40px 0; }
    .blog-prose table { width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 15px; }
    .blog-prose th, .blog-prose td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--color-hairline); }
    .blog-prose th { font-weight: 600; color: var(--color-ink); border-bottom-color: var(--color-line); }
    @media (max-width: 700px) {
      .blog-prose { font-size: 17px; }
      .blog-prose h2 { font-size: 23px; }
      .blog-prose h3 { font-size: 20px; }
    }

    /* Hide the WordPress-era CTA banners embedded in imported post content —
       the sidebar card is the CTA now. */
    .blog-prose img[src*="Flip-Split-CTA"],
    .blog-prose img[src*="flip-split-cta"],
    .blog-prose img[src*="icon-build"],
    .blog-prose img[src*="icon-Home"],
    .blog-prose a[href*="request-offer"] img,
    .blog-prose a[href*="request-offer"] {
      display: none !important;
    }
    .blog-prose p:has(> a[href*="request-offer"]:only-child),
    .blog-prose h2:has(> a[href*="request-offer"]),
    .blog-prose h3:has(> a[href*="request-offer"]),
    .blog-prose h4:has(> a[href*="request-offer"]) {
      display: none !important;
    }
  </style>

  <script>
    // Reading progress + active-TOC highlight. Re-initialized on
    // astro:page-load so navigating post→post (or index→post) via ClientRouter
    // re-wires the new article. The scroll listener is bound once and
    // re-queries the current article each call; the IntersectionObserver is
    // rebuilt per article and the previous one disconnected to avoid leaks.
    let blogTocObserver: IntersectionObserver | null = null;

    function updateBlogProgress() {
      const bar = document.getElementById('progress-bar');
      const article = document.getElementById('article-body');
      if (!bar || !article) return;
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
      bar.style.width = pct + '%';
    }

    function setActiveToc(slug: string) {
      document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-heading]').forEach(l => {
        if (l.dataset.heading === slug) {
          l.setAttribute('aria-current', 'location');
          // keep the active entry visible in a long, scrollable TOC
          const nav = l.parentElement!;
          if (l.offsetTop < nav.scrollTop || l.offsetTop > nav.scrollTop + nav.clientHeight - l.offsetHeight) {
            nav.scrollTop = l.offsetTop - nav.clientHeight / 3;
          }
        } else {
          l.removeAttribute('aria-current');
        }
      });
    }

    function initBlogToc() {
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-heading]');
      blogTocObserver?.disconnect();
      if (!tocLinks.length) return;

      const headingEls = Array.from(tocLinks)
        .map(a => document.getElementById(a.dataset.heading!))
        .filter(Boolean) as HTMLElement[];

      tocLinks.forEach(a => a.addEventListener('click', () => setActiveToc(a.dataset.heading!)));
      setActiveToc(tocLinks[0].dataset.heading!);

      blogTocObserver = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) setActiveToc(entry.target.id);
          });
        },
        { rootMargin: '-80px 0px -60% 0px' }
      );

      headingEls.forEach(el => blogTocObserver!.observe(el));
    }

    function initBlogPost() {
      updateBlogProgress();
      initBlogToc();
    }

    if (!(window as any).__blogPostWired) {
      (window as any).__blogPostWired = true;
      window.addEventListener('scroll', updateBlogProgress, { passive: true });
      document.addEventListener('astro:page-load', initBlogPost);
    }
    initBlogPost();
  </script>

</body>
</html>
