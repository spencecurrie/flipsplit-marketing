---
import { ClientRouter } from 'astro:transitions';
import Nav from '../../components/Nav.astro'
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import Footer from '../../components/Footer.astro';
import SocialMeta from '../../components/SocialMeta.astro';
import Analytics from '@vercel/analytics/astro';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const homeSelling = allPosts.filter(p => p.data.category === 'Home Selling');
const localTrends = allPosts.filter(p => p.data.category === 'Local Trends');

const hsHero = homeSelling[0];
const hsSecondary = homeSelling.slice(1, 3);
const hsGrid = homeSelling.slice(3, 9);
const ltHero = localTrends[0];
const ltList = localTrends.slice(1, 6);

const BATCH = 12;

function formatDate(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
const href = (id: string) => `/blog/${id}/`;
const catSlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'Blog — FlipSplit';
const pageDescription = 'Home selling guides, market trends, and expert advice from the FlipSplit team.';

// Card shell shared by every post link: hairline border that goes ink on hover.
const card = 'text-ink no-underline border border-line hover:border-ink hover:text-ink transition-colors duration-[180ms] ease-[cubic-bezier(.2,0,0,1)]';
const arrow = '<path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <Analytics />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    /* Hatched placeholder behind every cover image (shows while it loads, or
       if a post has no heroImage). */
    .ph { background: repeating-linear-gradient(135deg, #E9E9E4 0 1px, #F4F4F1 1px 7px); }
  </style>
  <ClientRouter />
</head>
<body class="bg-white text-ink antialiased">

  <Nav />

  <!-- Page header -->
  <div id="top" class="border-b border-line pt-12 pb-10">
    <div class="wrap-wide">
      <div class="eyebrow">FlipSplit Resources</div>
      <h1 class="mt-2.5 text-[44px] max-[700px]:text-[32px] leading-[1.08] tracking-[-0.035em] font-semibold">Real Estate Articles &amp; Resources</h1>
    </div>
  </div>

  <div class="wrap-wide pt-14 pb-8 flex flex-col gap-20">

    <!-- Home Selling -->
    {hsHero && (
      <section aria-labelledby="hs">
        <div class="flex justify-between items-center mb-6">
          <div class="flex items-center gap-2.5">
            <h2 id="hs" class="m-0 text-[22px] tracking-[-0.02em] font-semibold">Home Selling</h2>
            <span class="chip tnum">{homeSelling.length}</span>
          </div>
          <a href="/blog/?category=home-selling#recent" data-blog-filter="home-selling" class="text-[14px] font-medium no-underline inline-flex items-center gap-1.5 h-11 hover:text-muted">View all<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={arrow} /></a>
        </div>

        <div class="grid grid-cols-[minmax(0,3fr)_minmax(0,2fr)] max-[1000px]:grid-cols-1 gap-4">
          <a href={href(hsHero.id)} class={`block rounded-2xl overflow-hidden ${card}`}>
            <div class="ph aspect-[16/9] overflow-hidden">
              {hsHero.data.heroImage && <img src={hsHero.data.heroImage} alt="" class="w-full h-full object-cover block" />}
            </div>
            <div class="p-6">
              <span class="inline-flex text-[12px] font-medium px-[9px] py-1 rounded-md border border-line">{hsHero.data.category}</span>
              <h3 class="mt-3.5 text-[24px] leading-[1.25] tracking-[-0.02em] font-semibold">{hsHero.data.title}</h3>
              {hsHero.data.description && <p class="line-clamp-2 mt-2.5 text-[15px] leading-[1.6] text-muted">{hsHero.data.description}</p>}
              <div class="mt-3.5 flex gap-3 text-[13px] text-muted">
                <span>{formatDate(hsHero.data.pubDate)}</span>
                {hsHero.data.readingTime && <><span aria-hidden="true">·</span><span>{hsHero.data.readingTime} min read</span></>}
              </div>
            </div>
          </a>
          <div class="flex flex-col gap-4">
            {hsSecondary.map(p => (
              <a href={href(p.id)} class={`flex-1 flex gap-4 rounded-2xl p-4 ${card}`}>
                <div class="ph w-[120px] shrink-0 rounded-[10px] min-h-[120px] overflow-hidden">
                  {p.data.heroImage && <img src={p.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
                </div>
                <div class="flex flex-col justify-center min-w-0">
                  <span class="text-[12px] font-medium text-muted">{p.data.category}</span>
                  <h3 class="line-clamp-3 mt-1.5 text-[17px] leading-[1.35] font-semibold">{p.data.title}</h3>
                  <span class="mt-2.5 text-[13px] text-muted">{formatDate(p.data.pubDate)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-3 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1 gap-4 mt-4">
          {hsGrid.map(p => (
            <a href={href(p.id)} class={`block rounded-2xl overflow-hidden ${card}`}>
              <div class="ph aspect-[16/9] overflow-hidden">
                {p.data.heroImage && <img src={p.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
              </div>
              <div class="px-5 py-[18px]">
                <h3 class="line-clamp-2 m-0 text-[16px] leading-[1.4] font-semibold">{p.data.title}</h3>
                <span class="block mt-2 text-[13px] text-muted">{formatDate(p.data.pubDate)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Inline CTA -->
    <div class="bg-ink text-white rounded-2xl px-10 py-9 max-[700px]:px-6 flex max-[700px]:flex-col justify-between items-center max-[700px]:items-start gap-6">
      <div>
        <div class="text-[12px] font-semibold uppercase tracking-[0.1em] text-[#BDBDB6]">Free. No obligation.</div>
        <div class="mt-2 text-[28px] leading-[1.15] tracking-[-0.03em] font-semibold">Wondering what your home is worth?</div>
        <div class="mt-1.5 text-[15px] text-[#BDBDB6]">Get a free cash offer and renovation projection in 24–48 hours.</div>
      </div>
      <a href="/request-offer/" class="shrink-0 no-underline text-ink bg-white hover:bg-mute hover:text-ink text-[15px] font-medium px-[22px] h-[52px] rounded-xl inline-flex items-center gap-2 transition-colors">Get My Free Offer<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={arrow} /></a>
    </div>

    <!-- Local Trends -->
    {ltHero && (
      <section aria-labelledby="lt">
        <div class="flex justify-between items-center mb-6">
          <div class="flex items-center gap-2.5">
            <h2 id="lt" class="m-0 text-[22px] tracking-[-0.02em] font-semibold">Local Trends</h2>
            <span class="chip tnum">{localTrends.length}</span>
          </div>
          <a href="/blog/?category=local-trends#recent" data-blog-filter="local-trends" class="text-[14px] font-medium no-underline inline-flex items-center gap-1.5 h-11 hover:text-muted">View all<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={arrow} /></a>
        </div>
        <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] max-[1000px]:grid-cols-1 gap-4">
          <a href={href(ltHero.id)} class={`block rounded-2xl overflow-hidden ${card}`}>
            <div class="ph h-56 overflow-hidden">
              {ltHero.data.heroImage && <img src={ltHero.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
            </div>
            <div class="p-6">
              <span class="text-[12px] font-medium text-muted">{ltHero.data.category}</span>
              <h3 class="mt-2 text-[20px] leading-[1.3] tracking-[-0.015em] font-semibold">{ltHero.data.title}</h3>
              {ltHero.data.description && <p class="line-clamp-2 mt-2 text-[15px] leading-[1.6] text-muted">{ltHero.data.description}</p>}
            </div>
          </a>
          <div class="border border-line rounded-2xl px-5 py-2">
            {ltList.map((p, i) => (
              <a href={href(p.id)} class={`flex items-center gap-4 py-3.5 text-ink no-underline hover:text-muted transition-colors ${i === ltList.length - 1 ? '' : 'border-b border-hairline'}`}>
                <div class="ph w-[84px] h-[58px] shrink-0 rounded-[9px] overflow-hidden">
                  {p.data.heroImage && <img src={p.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="line-clamp-2 m-0 text-[15px] leading-[1.4] font-semibold">{p.data.title}</h3>
                  <span class="block mt-1 text-[13px] text-muted">{formatDate(p.data.pubDate)}</span>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5E5E58" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0"><path d="M9 6l6 6-6 6"></path></svg>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Recent (all posts; "View all" above filters this list by category) -->
    <section id="recent" aria-labelledby="ra" class="scroll-mt-6" data-blog-recent data-batch={BATCH}>
      <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
        <h2 id="ra" class="m-0 text-[22px] tracking-[-0.02em] font-semibold" data-blog-heading>Recent Articles</h2>
        <div class="flex items-center gap-3">
          <button type="button" data-blog-clear hidden class="text-[14px] font-medium inline-flex items-center gap-1.5 h-11 px-1 bg-transparent border-0 cursor-pointer text-ink hover:text-muted">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>Show all
          </button>
          <span class="chip tnum" data-blog-total>{allPosts.length} articles</span>
        </div>
      </div>
      <div class="grid grid-cols-4 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1 gap-4">
        {allPosts.map((p, i) => (
          <a
            href={href(p.id)}
            data-cat={catSlug(p.data.category)}
            class={`block rounded-[14px] overflow-hidden ${card}`}
            hidden={i >= BATCH}
          >
            <div class="ph aspect-[16/9] overflow-hidden">
              {p.data.heroImage && <img src={p.data.heroImage} alt="" class="w-full h-full object-cover block" loading="lazy" />}
            </div>
            <div class="p-4">
              <h3 class="line-clamp-2 m-0 text-[15px] leading-[1.4] font-semibold">{p.data.title}</h3>
              <span class="block mt-1.5 text-[13px] text-muted">{formatDate(p.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <button type="button" data-blog-more class="h-[52px] px-7 border border-ink rounded-xl bg-white text-ink text-[15px] font-medium cursor-pointer hover:bg-ink hover:text-white transition-colors">Load more articles</button>
        <p class="tnum mt-3 text-[13px] text-muted" data-blog-count>Showing {Math.min(BATCH, allPosts.length)} of {allPosts.length}</p>
      </div>
    </section>
  </div>

  <!-- Footer CTA -->
  <section id="get-offer" class="mt-[72px] py-[88px] bg-cream text-center">
    <div class="wrap max-w-[640px]">
      <span class="inline-flex items-center h-[30px] px-3 border border-[#D2D2CB] rounded-full text-[13px] bg-white">Ready to sell?</span>
      <h2 class="mt-4 fs-h2">Get your free offer today.</h2>
      <p class="mt-3.5 fs-lede">No repairs needed. No obligation. Results in 24–48 hours.</p>
      <a href="/request-offer/" class="mt-7 no-underline text-white bg-ink hover:bg-black hover:text-white text-[16px] font-medium px-[26px] h-[54px] rounded-xl inline-flex items-center gap-2.5 transition-colors">Get My Free Offer<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={arrow} /></a>
    </div>
  </section>

  <Footer current="/blog/" />

  <script>
    // Recent Articles: "Load more" (12 at a time) + category filter driven by
    // the sections' "View all" links (?category=home-selling|local-trends).
    // Bound on astro:page-load so it re-wires after ClientRouter swaps; the
    // dataset guard stops a re-run from double-binding the same section.
    const LABELS: Record<string, string> = { 'home-selling': 'Home Selling', 'local-trends': 'Local Trends' };

    function initBlogIndex() {
      const root = document.querySelector<HTMLElement>('[data-blog-recent]');
      if (!root || root.dataset.init === '1') return;
      root.dataset.init = '1';

      const batch = Number(root.dataset.batch) || 12;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cat]'));
      const more = root.querySelector<HTMLButtonElement>('[data-blog-more]')!;
      const count = root.querySelector<HTMLElement>('[data-blog-count]')!;
      const total = root.querySelector<HTMLElement>('[data-blog-total]')!;
      const heading = root.querySelector<HTMLElement>('[data-blog-heading]')!;
      const clear = root.querySelector<HTMLButtonElement>('[data-blog-clear]')!;
      let cat = '';
      let shown = batch;

      function render() {
        const pool = cat ? cards.filter(c => c.dataset.cat === cat) : cards;
        cards.forEach(c => { c.hidden = true; });
        pool.slice(0, shown).forEach(c => { c.hidden = false; });
        const n = Math.min(shown, pool.length);
        count.textContent = `Showing ${n} of ${pool.length}`;
        total.textContent = `${pool.length} articles`;
        heading.textContent = cat ? `${LABELS[cat] ?? 'Recent'} Articles` : 'Recent Articles';
        clear.hidden = !cat;
        more.hidden = n >= pool.length;
      }

      function setCat(next: string, scroll: boolean) {
        cat = LABELS[next] ? next : '';
        shown = batch;
        const url = new URL(location.href);
        if (cat) url.searchParams.set('category', cat); else url.searchParams.delete('category');
        history.replaceState(history.state, '', url.pathname + url.search + (scroll ? '#recent' : url.hash));
        render();
        if (scroll) root!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      more.addEventListener('click', () => { shown += batch; render(); });
      clear.addEventListener('click', () => setCat('', false));
      document.querySelectorAll<HTMLAnchorElement>('[data-blog-filter]').forEach(a => {
        a.addEventListener('click', e => { e.preventDefault(); setCat(a.dataset.blogFilter!, true); });
      });

      const initial = new URLSearchParams(location.search).get('category') ?? '';
      cat = LABELS[initial] ? initial : '';
      render();
    }

    initBlogIndex();
    document.addEventListener('astro:page-load', initBlogIndex);
  </script>

</body>
</html>
