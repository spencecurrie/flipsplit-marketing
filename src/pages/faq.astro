---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';

const faqs = [
  {
    q: "What fees, closing costs, or commissions are involved in selling my home to FlipSplit?",
    a: "Absolutely zero. You receive 100% of the amount we offer you. There are no hidden fees, no agent commissions, and no closing costs charged to you. What we quote is what you get.",
  },
  {
    q: "What areas does FlipSplit buy homes in?",
    a: "We purchase homes throughout Southern California, including Los Angeles, Ventura, Orange, Riverside, San Bernardino, and San Diego counties. We're continuing to expand — contact us to confirm your specific location.",
  },
  {
    q: "Is there a cost for a home evaluation or offer?",
    a: "Not at all. We provide a free, no-obligation home evaluation and cash offer. You're never required to accept.",
  },
  {
    q: "Is FlipSplit a house flipper?",
    a: "Yes — but with a key difference. Traditional flippers buy low, renovate, and keep 100% of the upside. FlipSplit shares the resale profit with you if the home sells for more than projected. You funded the asset. You should benefit from it.",
  },
  {
    q: "My home is in great condition. Can I still sell to FlipSplit?",
    a: "Absolutely. If convenience and speed matter more than squeezing every dollar out of a traditional listing, FlipSplit is a strong option. You get a competitive cash offer, close on your schedule, and skip the showings entirely. Plus, if the renovated home beats our resale projection, you'll receive a profit split regardless.",
  },
  {
    q: "Will FlipSplit buy a home that isn't in terrible condition?",
    a: "Yes. We buy homes of all shapes, conditions, and sizes — from move-in-ready to major fixer-uppers. Condition doesn't disqualify you.",
  },
  {
    q: "Do I need to handle any repairs or renovations before selling?",
    a: "No. You sell as-is. FlipSplit covers 100% of the renovation costs using our own contractors. You don't spend a dollar or lift a finger.",
  },
  {
    q: "Can I sell to FlipSplit without any profit-sharing involvement?",
    a: "Yes. The profit-sharing component only activates if the renovated home sells above the projected resale value we agreed on. If the home sells at or below that threshold, there is no backend payment — and that simply means we paid you the maximum upfront value we could justify.",
  },
  {
    q: "Will FlipSplit share the renovation plan and budget with me?",
    a: "Yes. We walk you through the estimated repair scope and budget before you accept the offer. Nothing happens behind closed doors. After the renovation, you receive an accounting of the actual costs and the final resale price.",
  },
  {
    q: "Will I know what FlipSplit intends to resell the property for?",
    a: "Yes. We share our projected resale price upfront as part of your offer. This number also sets the Profit Participation Threshold — the price above which a potential backend bonus could kick in.",
  },
  {
    q: "Can I visit the property during renovations?",
    a: "Due to active construction insurance requirements, we can't allow visits during the renovation. However, you can schedule a post-renovation walkthrough before the home lists, or we'll send you a full photo set of the completed work.",
  },
  {
    q: "Will FlipSplit purchase a home with a tenant in place?",
    a: "Yes. We buy tenant-occupied properties. The length of the remaining lease will factor into our offer — vacant homes typically receive a slightly higher offer since we can begin renovation immediately.",
  },
  {
    q: "How should I compare a FlipSplit offer to other offers?",
    a: "Compare net proceeds at closing, not the quoted number. Subtract agent commissions (typically 5–6%), closing costs, and any required repairs from traditional offers. Then compare that net figure to our zero-fee cash offer — plus factor in the profit-sharing upside FlipSplit provides.",
  },
  {
    q: "How quickly can FlipSplit buy my house?",
    a: "We can close in as few as 7 days. If you need more time, we can extend closing up to 90 days — you set the schedule.",
  },
  {
    q: "Can I receive money before closing?",
    a: "Yes. After inspections are complete, we can advance up to $20,000 prior to the official closing date if you need it.",
  },
  {
    q: "When would I receive a potential profit-split payment?",
    a: "If the renovated home sells above the projected resale value, a potential bonus payment is issued within 10 days after the sale. This would be a separate check from your initial offer payment — you don't need to do anything to receive it.",
  },
  {
    q: "Can I leave furniture or belongings behind?",
    a: "Yes. Leave anything you don't want to take. FlipSplit handles all junk removal and cleanout at no cost to you.",
  },
  {
    q: "Do I have any liability after selling?",
    a: "None. Once the sale closes, FlipSplit assumes 100% of the risk — construction cost overruns, market downturns, permit issues, everything. Your obligation ends at closing.",
  },
  {
    q: "Am I guaranteed a profit-split payment?",
    a: "No — the backend payment only occurs if the home sells above the projected resale value. If there's no backend payment, it means the home sold at or below projection, which means you received the maximum upfront offer we could justify.",
  },
  {
    q: "How is FlipSplit different from other iBuyers or cash buyers?",
    a: "Three key differences: (1) We accept distressed properties that iBuyers like Opendoor won't touch. (2) We charge zero fees. (3) We share the resale profit with you. Traditional cash buyers keep 100% of renovation upside — FlipSplit splits it.",
  },
];

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'FAQ | FlipSplit — Frequently Asked Questions';
const pageDescription = 'Get answers to the most common questions about selling your home to FlipSplit — fees, timelines, the profit-split model, and more.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
  <!-- FAQPage structured data, built from the same list the page renders so
       the two can't drift. -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <main>
    <!-- Hero -->
    <section id="top" class="pt-[88px] pb-[72px] border-b border-line">
      <div class="wrap max-w-[820px]! text-center">
        <span class="pill"><span class="pill-dot bg-ink"></span>Got Questions?</span>
        <h1 class="mt-5 text-[60px] max-[700px]:text-[40px] leading-[1.04] tracking-[-0.045em] font-semibold">Frequently asked<br />questions.</h1>
        <p class="mt-[18px] text-[18px] leading-[1.55] text-muted">Everything you need to know about selling your home to FlipSplit.</p>
      </div>
    </section>

    <!-- FAQ list -->
    <section class="pt-[72px] pb-24">
      <div class="wrap max-w-[820px]!">
        <div class="flex justify-between items-center pb-3.5">
          <span class="eyebrow">All questions</span>
          <span class="chip">{faqs.length}</span>
        </div>
        <div class="border-t border-line">
          {faqs.map(({ q, a }, i) => (
            <details class="border-b border-line">
              <summary class="flex items-start gap-4 py-5">
                <span class="font-mono shrink-0 mt-0.5 text-[12px] text-muted w-6">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 text-[17px] font-medium leading-[1.45]">{q}</span>
                <span class="faq-plus shrink-0 w-8 h-8 border border-line-strong rounded-lg flex items-center justify-center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></span>
              </summary>
              <p class="m-0 pr-14 pb-[22px] pl-10 text-[15px] leading-[1.65] text-muted">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Still have questions -->
    <section class="pb-24">
      <div class="wrap max-w-[820px]!">
        <div class="border border-line rounded-2xl px-8 py-7 flex justify-between items-center gap-8 max-[700px]:flex-col max-[700px]:items-start">
          <div>
            <h3 class="text-[20px] font-semibold tracking-[-0.02em]">Still have questions?</h3>
            <p class="mt-1.5 text-[14px] text-muted">Call us or send an email — a real person will respond.</p>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <a href="tel:18006617489" class="no-underline text-ink hover:text-muted inline-flex items-center gap-2 h-[46px] px-4 border border-line-strong rounded-[10px] text-[14px] font-medium">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>1-800-661-7489
            </a>
            <a href="mailto:info@flipsplit.com" class="no-underline text-ink hover:text-muted inline-flex items-center gap-2 h-[46px] px-4 border border-line-strong rounded-[10px] text-[14px] font-medium">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M22 6l-10 7L2 6"></path></svg>info@flipsplit.com
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="get-offer" class="py-24 bg-ink text-white">
      <div class="wrap max-w-[640px]! text-center">
        <h2 class="fs-h2 text-white">Ready to get your free offer?</h2>
        <p class="mt-3.5 text-[17px] text-[#BDBDB6]">No fees. No repairs. No obligation. Results in 24–48 hours.</p>
        <div class="mt-8">
          <AddressForm id="faq-form" theme="dark" align="center" showTrust={true} />
        </div>
      </div>
    </section>
  </main>

  <Footer current="/faq/" />

</body>
</html>
