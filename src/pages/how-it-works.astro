---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'How FlipSplit Works | Sell As-Is, Share the Profit';
const pageDescription = 'See exactly how FlipSplit works — guaranteed cash offer, zero-cost renovation, and a profit split when your home sells for more.';

const steps = [
  { n: '01', fill: '100%', title: 'Tell us about your home', body: 'Share your address, a few photos, and a quick walkthrough. Most sellers finish in under three minutes.' },
  { n: '02', fill: '55%', title: 'Customize your offer', body: 'Pick the mix that fits you — maximum cash today, or trade some upfront cash for a larger share of the resale profit.' },
  { n: '03', fill: '0%', title: 'We renovate. We resell. You may get paid again.', body: 'We cover 100% of the renovation cost. If your home resells above projection, a potential bonus check is wired within ten days.' },
];

const factors = [
  { n: '01', title: 'Market forecast', body: 'We pull 12-month appreciation projections for your zip code from current market data, so the offer reflects where prices are heading — not just where they are today.' },
  { n: '02', title: 'Comparable sales', body: 'Recently sold properties on your block and in your neighborhood — same size, age, and condition tier — set the floor for your home’s current market value.' },
  { n: '03', title: 'Home condition', body: 'Your photos and walkthrough tell us what’s working as-is and what’s holding the home back. No surprise inspection deductions — we price condition into the offer up front.' },
  { n: '04', title: 'After-renovation value', body: 'Once renovated, what would your home sell for? We model the resale price using top-tier comps in your area, then share that upside with you above the renovation cost.' },
];

const fees = [
  { n: '01', title: 'Closing Costs', body: 'Title insurance, escrow fees, county transfer taxes, and prorated property taxes typically run 1–2% of your sale price. You’ll see every line item itemized before close — no surprise deductions.' },
  { n: '02', title: 'Program Fee', body: 'If you decide to take a FlipSplit profit split, we charge a 2.5% program fee for managing the renovation project. Pure cash-offer sellers don’t pay this fee.' },
  { n: '03', title: 'Net Proceeds', body: 'Your final take-home amount is your offer minus closing costs and any program fee attributed to your sale. We show this number clearly on every offer summary.' },
];

const faqs = [
  { q: 'What fees do I pay to FlipSplit?', a: 'Pure cash-offer sellers pay $0 in FlipSplit fees — you receive 100% of the amount we offer you. If you choose the profit-split path, we charge a 2.5% program fee for managing the renovation. Either way, standard seller closing costs (title, escrow, transfer taxes) apply and are itemized line-by-line before close — no hidden fees.' },
  { q: 'What if the renovated home doesn’t sell for what you projected?', a: 'Your upfront cash offer is yours regardless. FlipSplit carries 100% of the construction and downside market risk. The profit-split bonus only pays out if the renovated home sells above your offer — if the market underperforms, your upfront amount doesn’t change. You’re guaranteed the cash, not guaranteed the bonus.' },
  { q: 'Who decides what gets renovated, and will I see the budget?', a: 'We do — but you receive our estimated renovation budget AND a projected resale price upfront, before you sign. No surprises. Once construction starts, our team manages every contractor, permit, and material.' },
  { q: 'Can I visit the property during construction?', a: 'Unfortunately no — it’s an insurance restriction during active work. Once renovations are complete, we’ll happily schedule a walk-through preview before the home goes back on the market.' },
  { q: 'How fast can you buy my home?', a: 'If you move quickly, we can close in as few as 7 days. We can also accommodate timelines out to 90 days if you need more flexibility — the choice is yours.' },
  { q: 'Can I get cash before closing?', a: 'Yes. We can advance you up to $20,000 prior to the close of escrow for cash-flow needs while you wait for the full payment at close.' },
  { q: 'When would I receive a potential profit-split bonus check?', a: 'If the renovated home sells above projection, a potential bonus check is issued within 10 days after the resale. From your signing day to bonus-check delivery, expect roughly 90–120 days total depending on renovation scope and market conditions.' },
  { q: 'What kinds of homes do you buy?', a: 'Any condition, any type — single-family homes, condos, distressed properties, inherited homes, tenant-occupied rentals, even homes already in great shape. We specialize in the situations other buyers won’t touch, but we also work with sellers who just want a fast, hassle-free sale.' },
  { q: 'What areas does FlipSplit serve?', a: 'We currently buy homes throughout Southern California — Los Angeles, Ventura, Orange, Riverside, San Bernardino, and San Diego counties. New markets are coming.' },
  { q: 'Can I leave trash or furniture behind when I sell?', a: 'Yes. Take what you want, leave the rest. Trash, old furniture, even years of accumulated stuff — we’ve seen it all and handle the cleanout ourselves.' },
];

// "Choose how you get paid" — illustrative example for a home we'd buy for
// $600,000. The same math runs client-side in the <script> below; this copy
// only renders the initial state (Expected resale, Cash Plus 50% selected).
const STOPS = [760000, 800000, 840000];
const PLANS = [
  { pct: 0, label: 'All cash', tag: 'Simple & fast', price: 600000 },
  { pct: 50, label: 'Cash Plus 50%', tag: 'Best of both', price: 560000 },
  { pct: 100, label: 'Cash Plus 100%', tag: 'Biggest return', price: 520000 },
];
const INIT_STOP = 0;
const INIT_SEL = 1;
const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const fmtK = (n: number) => '$' + Math.round(n / 1000) + 'K';
const at = (p: typeof PLANS[number], r: number) => {
  const cash = p.price * 0.93;
  const bonus = Math.max(0, r - p.price - 100000) * p.pct / 100;
  return { cash, bonus, net: cash + bonus };
};
const maxNet = Math.max(...PLANS.map((p) => at(p, STOPS[2]).net));
const plans = PLANS.map((p, i) => {
  const m = at(p, STOPS[INIT_STOP]);
  const on = i === INIT_SEL;
  return {
    ...p, on,
    netLabel: p.pct ? 'Projected net proceeds' : 'Guaranteed net proceeds',
    headline: fmt(p.pct ? m.net : m.cash),
    cashW: (m.cash / maxNet * 100).toFixed(2) + '%',
    bonusW: (m.bonus / maxNet * 100).toFixed(2) + '%',
    cash: fmt(m.cash),
    bonusText: p.pct ? '+' + fmt(m.bonus) : 'None',
  };
});
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="bg-white text-ink antialiased">

  <Nav />

  <!-- 1. Hero -->
  <section id="top" class="pt-[72px]">
    <div class="wrap-wide">
      <div class="text-center max-w-[760px] mx-auto">
        <h1 class="fs-h1 m-0">Sell Today.<br />Get Paid Twice.</h1>
        <p class="fs-lede mt-5 mx-auto max-w-[600px]">Take our maximum cash offer at closing, or trade some upfront cash for a larger share of the resale profit.</p>
        <div class="mt-[30px]">
          <AddressForm id="hiw-hero-form" showTrust={false} align="center" />
        </div>
      </div>

      <div class="relative max-w-[1200px] mx-auto mt-12 h-[560px] max-[1000px]:h-[440px] max-[700px]:h-[300px]">
        <div class="relative w-full h-full rounded-[50%_50%_0_0/100%_100%_0_0] overflow-hidden bg-mute border border-line border-b-0 box-border">
          <img src="/reskin/split-before.jpg" alt="Home before FlipSplit renovation" class="absolute inset-0 w-full h-full object-cover [clip-path:inset(0_50%_0_0)]" />
          <img src="/reskin/split-after.jpg" alt="Home after FlipSplit renovation" class="absolute inset-0 w-full h-full object-cover [clip-path:inset(0_0_0_50%)]" />
          <div class="absolute top-0 bottom-0 left-1/2 w-[2px] -ml-px bg-white" aria-hidden="true"></div>
          <span class="absolute bottom-4 left-[calc(50%-76px)] text-[11px] font-semibold uppercase tracking-[0.08em] px-[9px] py-1 rounded-md bg-[rgba(18,18,18,0.72)] text-white">Before</span>
          <span class="absolute bottom-4 left-[calc(50%+12px)] text-[11px] font-semibold uppercase tracking-[0.08em] px-[9px] py-1 rounded-md bg-white text-ink">After</span>
        </div>
        <div class="tnum absolute bottom-[22%] left-[-16px] max-[1000px]:left-3 bg-white border border-line rounded-xl px-4 py-3 shadow-[0_18px_36px_-18px_rgba(0,0,0,0.3)]">
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-muted">Cash now</div>
          <div class="mt-1 text-[26px] leading-none font-semibold tracking-[-0.03em]">$900k</div>
          <div class="mt-2.5 w-[120px] h-1.5 rounded-[3px] bg-ink" aria-hidden="true"></div>
        </div>
        <div class="tnum absolute bottom-[22%] right-[-16px] max-[1000px]:right-3 bg-ink text-white rounded-xl px-4 py-3 shadow-[0_18px_36px_-18px_rgba(0,0,0,0.4)]">
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#BDBDB6]">Upside later</div>
          <div class="mt-1 text-[26px] leading-none font-semibold tracking-[-0.03em]">+$125k</div>
          <div class="hatch-w mt-2.5 w-[60px] h-1.5 rounded-[3px]" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Three-step process (fill bars track scroll position) -->
  <section id="sell" class="py-[104px] border-t border-line">
    <div class="wrap-wide">
      <div class="grid grid-cols-2 gap-24 items-start max-[1000px]:grid-cols-1 max-[1000px]:gap-10">
        <div>
          <h2 class="fs-h2 m-0">How FlipSplit works</h2>
        </div>
        <ol id="hiw-steps" class="list-none m-0 p-0 flex flex-col gap-3.5">
          {steps.map((s) => (
            <li class="hiw-row flex gap-5 border border-line rounded-[14px] px-6 py-[22px] bg-white">
              <div class="shrink-0 w-1 rounded-sm bg-line relative overflow-hidden" aria-hidden="true">
                <div class="hiw-fill absolute top-0 left-0 right-0 bg-ink rounded-sm" style={`height:${s.fill}`}></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-start gap-4">
                  <h3 class="m-0 text-[20px] font-semibold tracking-[-0.015em]">{s.title}</h3>
                  <span class="chip shrink-0">{s.n}</span>
                </div>
                <p class="mt-2 mb-0 text-[16px] leading-[1.6] text-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 3. Our offers explained -->
  <section class="py-[104px] border-t border-line">
    <div class="wrap-wide">
      <div class="max-w-[680px]">
        <div class="eyebrow">Valuing your home</div>
        <h2 class="fs-h2 mt-2.5 mb-0">Our offers, explained.</h2>
        <p class="fs-lede mt-3.5 mb-0">Every FlipSplit offer is grounded in real data — not guesswork. Here's exactly what goes into yours.</p>
      </div>
      <div class="grid grid-cols-2 gap-4 mt-11 max-[700px]:grid-cols-1">
        {factors.map((f) => (
          <div class="border border-line rounded-[14px] p-7 bg-[#F8F8F3]">
            <div class="flex justify-between items-center gap-3">
              <h3 class="m-0 text-[20px] font-semibold tracking-[-0.015em]">{f.title}</h3>
              <span class="chip">{f.n}</span>
            </div>
            <p class="mt-3 mb-0 text-[16px] leading-[1.6] text-muted">{f.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 mb-0 max-w-[680px] text-[14px] leading-[1.6] text-muted">Every input above is shown to you alongside your offer. If a number doesn't make sense, we'll walk you through it line by line.</p>
    </div>
  </section>

  <!-- 4. Choose how you get paid (interactive) -->
  <section id="hiw-choose" class="py-[104px] border-t border-line">
    <div class="wrap-wide">
      <div class="flex justify-between items-end gap-8 max-[1000px]:flex-col max-[1000px]:items-stretch">
        <div>
          <div class="eyebrow">The FlipSplit Difference</div>
          <h2 class="fs-h2 mt-2.5 mb-0">Choose how you get paid</h2>
          <p class="fs-lede mt-3.5 mb-0">Take it all at closing, or add a potential bonus after we renovate and resell.</p>
        </div>
        <div class="w-[440px] shrink-0 max-[1000px]:w-auto">
          <div class="flex justify-between items-baseline">
            <label for="hiw-resale" class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#6B6B65]">Assuming it resells for</label>
            <span id="hiw-resale-fmt" class="tnum text-[18px] font-semibold">{fmt(STOPS[INIT_STOP])}</span>
          </div>
          <div class="relative mt-1">
            <div class="absolute left-0 right-0 top-3 h-1 rounded-sm bg-line" aria-hidden="true"></div>
            <div id="hiw-resale-fill" class="absolute left-0 top-3 h-1 rounded-sm bg-ink" style={`width:${INIT_STOP * 50}%`} aria-hidden="true"></div>
            <input id="hiw-resale" class="hiw-range" type="range" min="0" max="2" step="1" value={INIT_STOP} aria-valuetext={fmt(STOPS[INIT_STOP])} />
          </div>
          <div class="flex justify-between">
            {STOPS.map((v, i) => (
              <button
                type="button"
                class="hiw-stop min-h-[44px] pt-0.5 px-0 pb-0 border-0 bg-transparent flex flex-col cursor-pointer"
                data-stop={i}
                aria-pressed={i === INIT_STOP ? 'true' : 'false'}
                style={`align-items:${i === 0 ? 'flex-start' : i === 2 ? 'flex-end' : 'center'};color:${i === INIT_STOP ? '#121212' : '#5E5E58'};font-weight:${i === INIT_STOP ? 600 : 400}`}
              >
                <span class="tnum text-[13px]">{fmtK(v)}</span>
                <span class="text-[11px] font-semibold">{i === 0 ? 'Expected' : ' '}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4 mt-7 max-[700px]:grid-cols-1">
        {plans.map((p, i) => (
          <button
            type="button"
            class="hiw-plan flex flex-col items-stretch text-left p-[22px] rounded-[14px] bg-white text-ink cursor-pointer"
            data-plan={i}
            aria-pressed={p.on ? 'true' : 'false'}
            style={`border:${p.on ? '2px solid #121212' : '1px solid #E6E6E1'};box-shadow:${p.on ? '0 10px 24px -12px rgba(18,18,18,0.25)' : 'none'}`}
          >
            <span class="flex justify-between items-center">
              <span class="text-[11px] font-semibold uppercase tracking-[0.09em]">{p.label}</span>
              <span class="hiw-radio w-[18px] h-[18px] rounded-full box-border" style={`border:${p.on ? '6px solid #121212' : '2px solid #D2D2CB'}`}></span>
            </span>
            <span class="mt-2 flex">
              <span class="hiw-tag font-mono text-[11px] px-2 py-1 rounded-md border border-line-strong" style={`background:${p.on ? '#F1F2E8' : '#FFFFFF'}`}>{p.tag}</span>
            </span>
            <span class="mt-[18px] text-[12px] text-[#6B6B65]">{p.netLabel}</span>
            <span class="hiw-headline tnum text-[28px] font-semibold tracking-[-0.025em]">{p.headline}</span>
            <span class="mt-3 h-2.5 rounded-[5px] bg-hairline flex overflow-hidden" aria-hidden="true">
              <span class="hiw-cashbar block h-full bg-ink" style={`width:${p.cashW}`}></span>
              <span class="hiw-bonusbar hatch block h-full" style={`width:${p.bonusW}`}></span>
            </span>
            <span class="tnum mt-3.5 flex flex-col gap-1.5 text-[14px]">
              <span class="flex justify-between"><span class="text-muted">Guaranteed at closing</span><span class="hiw-cash font-semibold">{p.cash}</span></span>
              <span class="flex justify-between"><span class="text-muted">Potential bonus</span><span class="hiw-bonus font-semibold" style={`color:${p.pct ? '#121212' : '#A8A8A2'}`}>{p.bonusText}</span></span>
            </span>
          </button>
        ))}
      </div>
      <p class="mt-4 mb-0 text-[13px] text-muted">Example for a home we'd buy for $600,000 · actual numbers vary by property. Bonus amounts aren't guaranteed. If the home sells for less, the bonus gets smaller, down to $0. You never pay anything back.</p>
    </div>
  </section>

  <!-- 5. Costs and fees -->
  <section class="py-[104px] border-t border-line">
    <div class="wrap-wide">
      <div class="max-w-[680px]">
        <div class="eyebrow">Understanding your offer</div>
        <h2 class="fs-h2 mt-2.5 mb-0">Understand total costs and fees</h2>
        <p class="fs-lede mt-3.5 mb-0">Once we've finalized the offer, we'll provide a full breakdown of all charges, costs, and the total amount you can expect to walk away with.</p>
      </div>
      <div class="grid grid-cols-3 gap-4 mt-11 max-[700px]:grid-cols-1">
        {fees.map((f) => (
          <div class="border border-line rounded-[14px] p-7 bg-[#F8F8F3]">
            <div class="flex justify-between items-center gap-3">
              <h3 class="m-0 text-[20px] font-semibold tracking-[-0.015em]">{f.title}</h3>
              <span class="chip">{f.n}</span>
            </div>
            <p class="mt-3 mb-0 text-[16px] leading-[1.6] text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Reviews strip -->
  <section id="reviews" class="py-16 border-t border-line">
    <div class="wrap-wide">
      <div class="tnum grid grid-cols-4 border border-line rounded-2xl py-7 max-[700px]:grid-cols-2 max-[700px]:gap-y-7">
        <div class="text-center px-4">
          <div class="text-[48px] leading-none font-semibold tracking-[-0.04em]">5.0</div>
          <div role="img" aria-label="5 out of 5 stars" class="mt-2.5 flex justify-center gap-[3px]">
            {[0, 1, 2, 3, 4].map(() => (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="#121212" aria-hidden="true"><path d="M12 2l3 6.6 7.2.7-5.4 4.8 1.6 7.1L12 17.5 5.6 21.2l1.6-7.1L1.8 9.3 9 8.6z"></path></svg>
            ))}
          </div>
          <div class="mt-2 text-[14px] text-muted">Average rating</div>
        </div>
        <div class="text-center px-4 border-l border-line">
          <div class="text-[48px] leading-none font-semibold tracking-[-0.04em]">100%</div>
          <div class="mt-4 text-[14px] text-muted">5-star reviews</div>
        </div>
        <div class="text-center px-4 border-l border-line max-[700px]:border-l-0">
          <div class="text-[48px] leading-none font-semibold tracking-[-0.04em]">10+</div>
          <div class="mt-4 text-[14px] text-muted">Verified homeowners</div>
        </div>
        <div class="text-center px-4 border-l border-line flex flex-col items-center justify-center">
          <span class="font-mono text-[14px] border border-line-strong rounded-md px-[9px] py-1">REVIEWS.IO</span>
          <div class="mt-2 text-[14px] text-muted">Verified source</div>
          <a href="https://www.reviews.io" target="_blank" rel="noopener" class="mt-1.5 text-[14px] font-semibold no-underline text-ink hover:text-muted">View all →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section id="faq" class="py-[104px] bg-cream">
    <div class="wrap max-w-[820px]">
      <div class="text-center">
        <div class="eyebrow">FAQ</div>
        <h2 class="fs-h2 mt-2.5 mb-0">Still have questions?</h2>
      </div>
      <div class="mt-11 bg-white border border-line rounded-2xl px-6">
        {faqs.map((f, i) => (
          <details class:list={['border-b', i === faqs.length - 1 ? 'border-transparent' : 'border-line']}>
            <summary class="flex justify-between items-center gap-6 py-5 text-[17px] font-medium">
              {f.q}
              <span class="faq-plus shrink-0 w-8 h-8 border border-line-strong rounded-lg flex items-center justify-center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
              </span>
            </summary>
            <p class="m-0 pr-14 pb-[22px] text-[16px] leading-[1.65] text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section id="get-offer" class="py-[104px] border-t border-line">
    <div class="wrap max-w-[640px] text-center">
      <span class="pill">Free · No obligation</span>
      <h2 class="fs-h2 mt-4 mb-0">See what your home could pay you — twice.</h2>
      <p class="fs-lede mt-3.5 mb-0">Takes 60 seconds. No credit check. We'll follow up with your guaranteed cash offer and your potential bonus-check projection.</p>
      <div class="mt-8">
        <AddressForm id="how-it-works-footer-form" align="center" />
      </div>
    </div>
  </section>

  <Footer current="/how-it-works/" />

  <style>
    .hiw-range { -webkit-appearance: none; appearance: none; width: 100%; height: 28px; background: transparent; margin: 0; cursor: pointer; position: relative; display: block; }
    .hiw-range::-webkit-slider-runnable-track { height: 4px; background: transparent; }
    .hiw-range::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #121212; border: 4px solid #fff; box-shadow: 0 0 0 1px #121212; margin-top: -10px; }
    .hiw-range::-moz-range-track { height: 4px; background: transparent; }
    .hiw-range::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #121212; border: 4px solid #fff; box-shadow: 0 0 0 1px #121212; }
    .hiw-range:focus-visible { outline: 2px solid #121212; outline-offset: 4px; border-radius: 4px; }
  </style>

  <script>
    // ── Step fill bars: each bar fills as its card crosses mid-viewport. ──
    // The scroll/resize listeners are bound once (this module runs once);
    // they re-query the DOM every frame, so they keep working across
    // ClientRouter page swaps and do nothing on other pages.
    let rafPending = false;
    function updateFills() {
      rafPending = false;
      const list = document.getElementById('hiw-steps');
      if (!list) return;
      const anchor = window.innerHeight * 0.5;
      list.querySelectorAll<HTMLElement>('.hiw-row').forEach((row) => {
        const rect = row.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (anchor - rect.top) / rect.height));
        const fill = row.querySelector<HTMLElement>('.hiw-fill');
        if (fill) fill.style.height = progress * 100 + '%';
      });
    }
    function scheduleFills() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(updateFills);
    }
    window.addEventListener('scroll', scheduleFills, { passive: true });
    window.addEventListener('resize', scheduleFills);

    // ── "Choose how you get paid": resale slider + plan cards. ──
    // Illustrative example for a home we'd buy for $600,000 (same numbers as
    // the server-rendered initial state in the frontmatter).
    const STOPS = [760000, 800000, 840000];
    const PLANS = [
      { pct: 0, price: 600000 },
      { pct: 50, price: 560000 },
      { pct: 100, price: 520000 },
    ];
    const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const at = (p: { pct: number; price: number }, r: number) => {
      const cash = p.price * 0.93;
      const bonus = Math.max(0, r - p.price - 100000) * p.pct / 100;
      return { cash, bonus, net: cash + bonus };
    };
    const maxNet = Math.max(...PLANS.map((p) => at(p, STOPS[2]).net));

    function initChoose() {
      const root = document.getElementById('hiw-choose');
      if (!root || root.dataset.wired === '1') return;
      root.dataset.wired = '1';
      const range = root.querySelector<HTMLInputElement>('#hiw-resale')!;
      const resaleFmt = root.querySelector<HTMLElement>('#hiw-resale-fmt')!;
      const resaleFill = root.querySelector<HTMLElement>('#hiw-resale-fill')!;
      const stopBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.hiw-stop'));
      const planBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.hiw-plan'));
      let stop = Number(range.value) || 0;
      let sel = Math.max(0, planBtns.findIndex((b) => b.getAttribute('aria-pressed') === 'true'));

      function render() {
        const resale = STOPS[stop];
        range.value = String(stop);
        range.setAttribute('aria-valuetext', fmt(resale));
        resaleFmt.textContent = fmt(resale);
        resaleFill.style.width = stop * 50 + '%';
        stopBtns.forEach((b, i) => {
          const on = i === stop;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.style.color = on ? '#121212' : '#5E5E58';
          b.style.fontWeight = on ? '600' : '400';
        });
        planBtns.forEach((b, i) => {
          const p = PLANS[i];
          const m = at(p, resale);
          const on = i === sel;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.style.border = on ? '2px solid #121212' : '1px solid #E6E6E1';
          b.style.boxShadow = on ? '0 10px 24px -12px rgba(18,18,18,0.25)' : 'none';
          b.querySelector<HTMLElement>('.hiw-radio')!.style.border = on ? '6px solid #121212' : '2px solid #D2D2CB';
          b.querySelector<HTMLElement>('.hiw-tag')!.style.background = on ? '#F1F2E8' : '#FFFFFF';
          b.querySelector<HTMLElement>('.hiw-headline')!.textContent = fmt(p.pct ? m.net : m.cash);
          b.querySelector<HTMLElement>('.hiw-cashbar')!.style.width = (m.cash / maxNet * 100).toFixed(2) + '%';
          b.querySelector<HTMLElement>('.hiw-bonusbar')!.style.width = (m.bonus / maxNet * 100).toFixed(2) + '%';
          b.querySelector<HTMLElement>('.hiw-cash')!.textContent = fmt(m.cash);
          b.querySelector<HTMLElement>('.hiw-bonus')!.textContent = p.pct ? '+' + fmt(m.bonus) : 'None';
        });
      }

      range.addEventListener('input', () => { stop = Math.round(Number(range.value)); render(); });
      stopBtns.forEach((b, i) => b.addEventListener('click', () => { stop = i; render(); }));
      planBtns.forEach((b, i) => b.addEventListener('click', () => { sel = i; render(); }));
      render();
    }

    document.addEventListener('astro:page-load', () => {
      updateFills();
      initChoose();
    });
  </script>

</body>
</html>
