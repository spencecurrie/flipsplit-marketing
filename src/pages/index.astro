---
import '../styles/global.css'
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const reviews = [
  {
    quote: "Amazing from start to finish. The team handled everything and made a stressful experience extremely smooth — without leaving money on the table thanks to their resale bonus. Highly recommended!",
    name: "Val Briot",
    location: "Los Angeles, CA",
    photo: "/val-briot.png",
  },
  {
    quote: "Best decision when we needed to sell our investment property fast. They were fair, transparent throughout the entire process, and delivered on everything they said they would.",
    name: "Nick Boyd",
    location: "San Diego, CA",
    photo: "/nick-boyd.png",
  },
  {
    quote: "Working with FlipSplit was the best decision I’ve made so far. Easy, no hassle, and an extra bonus check at the end — more than I expected!",
    name: "Grace G.",
    location: "San Juan, CA",
    photo: "/grace-g.png",
  },
];

type Tone = { bg: string; fg: string; sub: string; line: string; line2: string };
const light: Tone = { bg: 'bg-white', fg: 'text-ink', sub: 'text-muted', line: 'border-line', line2: 'border-line' };
const dark: Tone  = { bg: 'bg-ink', fg: 'text-white', sub: 'text-[#BDBDB6]', line: 'border-ink', line2: 'border-[#3A3A36]' };
const card = (title: string, body: string, meta: string, tone: Tone = light) => ({ title, body, meta, ...tone });

// "Close on your timeline" meta: the design had a "[X] days" placeholder; the
// live site's stated close window (faq.astro) is 7 to 30 days.
const stages = [
  { title: 'Get your offer', n: '01', cards: [
    card('Tell us about your home', 'Your address, a few photos and a quick walkthrough.', 'Day 1'),
    card('Review your offer', 'One clear number, valid for 30 days.', 'Within 48 hrs') ] },
  { title: 'Close & get paid', n: '02', cards: [
    card('Pick your plan', 'All cash, or cash plus a potential share of the resale profit.', 'Your choice'),
    card('Close on your timeline', 'Cash wired at closing. No repairs, no showings.', 'Your timeline') ] },
  { title: 'We renovate', n: '03', cards: [
    card('We fund the fix-up', 'Our crew, our budget, our risk. Never yours.', 'After closing'),
    card('Follow along', 'Photos and updates in your dashboard as work happens.', 'Weekly') ] },
  { title: 'Potential bonus', n: '04', cards: [
    card('Potential bonus paid', 'If the home resells above projection, your share of the profit is paid within 10 days after our resale.', 'After resale', dark),
    card('Never owe anything back', 'If it sells for less, a potential bonus shrinks, down to $0.', 'Guaranteed') ] },
];

const cases = [
  { title: 'Kimball Ave · 4 bed · single-family', before: '/reskin/kimball-kitchen-before.jpg', after: '/reskin/kimball-kitchen-after.jpg',
    beforeAlt: 'Kimball Ave kitchen before renovation', afterAlt: 'Kimball Ave kitchen after renovation',
    label: 'Kimball Ave kitchen, drag to compare before and after',
    cash: '$850k', bonus: '+$128k', total: '$978k', cashFlex: 850, bonusFlex: 128 },
  { title: 'Via Viente · 5 bed · luxury', before: '/reskin/viaviente-kitchen-before.jpg', after: '/reskin/viaviente-kitchen-after.jpg',
    beforeAlt: 'Via Viente kitchen before renovation', afterAlt: 'Via Viente kitchen after renovation',
    label: 'Via Viente kitchen, drag to compare before and after',
    cash: '$1.14M', bonus: '+$162k', total: '$1.30M', cashFlex: 1140, bonusFlex: 162 },
];

const faqs = [
  { q: "Do I have to pay anything upfront?", a: "No. FlipSplit covers 100% of renovation costs. You don’t pay anything until the home sells, and even then it comes out of proceeds — never out of your pocket." },
  { q: "What if the home doesn’t sell for more than expected?", a: "Your guaranteed cash offer is locked in regardless of how the market performs. If the home sells below our projection, you still get your guaranteed amount. FlipSplit absorbs the renovation risk." },
  { q: "How long does the renovation take?", a: "Most renovations take 4–8 weeks depending on scope. We target a 30–45 day total close timeline — significantly faster than the 60–90 day traditional sale." },
  { q: "Can I stay in the home during renovation?", a: "In most cases we ask that the home be vacated during active renovation work. We can work around your schedule as part of your offer review." },
  { q: "Is FlipSplit the same as iBuying?", a: "No. iBuyers give you a discounted cash offer and keep all the upside. FlipSplit renovates your home to maximize its value — and gives you a share of that upside through profit participation." },
  { q: "What types of homes does FlipSplit work with?", a: "Single-family homes in Southern California. Condition doesn’t matter — that’s the point. Whether it needs cosmetic updates or significant repairs, we’ll make it work." },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>FlipSplit — Sell Your Home For More, Without the Hassle</title>
  <meta name="description" content="FlipSplit renovates your home before it hits the market. Get a guaranteed cash offer today plus a share of the upside when it sells for more. No repairs, no stress." />
  <link rel="canonical" href={canonicalURL} />
  <ClientRouter />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    /* Offer-calculator range: transparent native track over the painted
       track/fill divs; the thumb is the design's ringed black dot. */
    .range { -webkit-appearance: none; appearance: none; width: 100%; height: 28px; background: transparent; margin: 0; cursor: pointer; }
    .range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: transparent; }
    .range::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: #121212; border: 4px solid #fff; box-shadow: 0 0 0 1px #121212; margin-top: -9px; }
    .range::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #121212; border: 4px solid #fff; box-shadow: 0 0 0 1px #121212; }
    @media (max-width: 700px) {
      .range { height: 32px; }
      .range::-webkit-slider-thumb { width: 24px; height: 24px; margin-top: -10px; }
      .range::-moz-range-thumb { width: 18px; height: 18px; }
    }
  </style>
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <!-- ─── HERO ─── -->
  <section id="top" class="px-6 pt-6 pb-8 max-[700px]:px-3 max-[700px]:pt-2 max-[700px]:pb-6">
    <div class="relative max-w-[1640px] mx-auto rounded-[20px] max-[700px]:rounded-[18px] overflow-hidden min-h-[640px] max-[700px]:min-h-0 bg-ink-soft">
      <img src="/reskin/hero-family.jpg" alt="Family in front of their new home" class="absolute inset-0 w-full h-full object-cover object-center max-[700px]:object-right" />
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(18,18,18,0.82)_0%,rgba(18,18,18,0.55)_50%,rgba(18,18,18,0.12)_100%)] max-[700px]:bg-none max-[700px]:bg-[rgba(18,18,18,0.62)]"></div>
      <div class="relative min-h-[640px] max-[700px]:min-h-0 box-border px-16 py-[72px] max-[700px]:px-[18px] max-[700px]:pt-8 max-[700px]:pb-7 flex flex-col justify-center text-left max-[700px]:text-center">
        <div class="max-w-[760px]">
          <span class="inline-flex items-center gap-2 h-[30px] px-3 border border-white/[.28] rounded-full text-[13px] max-[700px]:text-[12px] text-white">
            <span class="w-1.5 h-1.5 rounded-full bg-white"></span>Cash now · Potential bonus after resale
          </span>
          <h1 class="mt-5 max-[700px]:mt-3.5 text-[64px] max-[1000px]:text-[52px] max-[700px]:text-[34px] leading-[1.04] max-[700px]:leading-[1.08] tracking-[-0.045em] font-semibold text-white">Cash now, plus more<br class="max-[700px]:hidden" /> when your home resells.</h1>
          <p class="mt-5 max-[700px]:mt-3 text-[18px] max-[700px]:text-[15px] leading-[1.55] max-[700px]:leading-[1.5] text-white/[.86] max-[700px]:text-white max-w-[560px]">FlipSplit unlocks your equity instantly while still allowing you to benefit from a newly renovated home.</p>
          <div class="mt-7 max-[700px]:mt-5 max-w-[460px] max-[700px]:max-w-none max-[700px]:[&_.address-form]:mx-auto max-[700px]:[&_.flex-wrap]:justify-center [&_.address-modal]:text-left">
            <AddressForm id="hero-form" theme="dark" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SOCIAL PROOF ─── -->
  <section id="reviews" class="py-20 max-[700px]:py-10">
    <div class="wrap-wide">
      <div class="eyebrow max-[700px]:text-[12px]">Why sellers choose FlipSplit</div>
      <h2 class="fs-h2 mt-2.5 max-[700px]:mt-2">Real stories from real homeowners.</h2>
      <p class="fs-lede mt-3.5 max-[700px]:mt-3 max-[700px]:text-[16px]">No pressure, no gimmicks. Just homeowners who found a better way to sell.</p>
      <div class="mt-10 max-[700px]:mt-6 grid grid-cols-3 gap-4 max-[700px]:grid-cols-1 max-[700px]:gap-3">
        {reviews.map((r) => (
          <figure class="m-0 border border-line rounded-[14px] p-[22px] max-[700px]:p-[18px] flex flex-col gap-4 max-[700px]:gap-3.5 bg-white">
            <div class="flex items-center gap-3">
              <img src={r.photo} alt={r.name} class="w-11 h-11 max-[700px]:w-[42px] max-[700px]:h-[42px] rounded-full object-cover" />
              <figcaption class="flex-1 min-w-0">
                <span class="block text-[15px] font-semibold">{r.name}</span>
                <span class="block text-[13px] text-muted">{r.location}</span>
              </figcaption>
              <span class="chip">5.0</span>
            </div>
            <blockquote class="m-0 text-[16px] max-[700px]:text-[15px] leading-[1.6] text-ink-soft flex-1">“{r.quote}”</blockquote>
            <span class="self-start inline-flex items-center gap-1.5 text-[12px] px-2 py-1 rounded-md bg-cream">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>Verified seller
            </span>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CREATE YOUR OFFER (calculator) ─── -->
  <section class="py-20 max-[700px]:py-10 bg-wash border-y border-line">
    <div class="wrap flex flex-col items-center gap-10 max-[700px]:gap-6 max-[700px]:px-3">
      <div class="text-center max-w-[640px] max-[700px]:px-1">
        <h2 class="fs-h2">Your home offer redefined</h2>
        <p class="fs-lede mt-3.5 max-[700px]:mt-3 max-[700px]:text-[16px]">Sell for cash upfront, then potentially get paid again once your home resells.</p>
      </div>
      <div class="w-full max-w-[560px] bg-white border border-line rounded-2xl p-6 max-[700px]:p-[18px] box-border">
        <h3 class="m-0 text-[18px] font-semibold tracking-[-0.01em]">Choose your offer</h3>
        <p class="mt-1 text-[14px] text-muted">Adjust upfront cash vs. backend upside.</p>

        <div class="mt-5 max-[700px]:mt-[18px] flex justify-between text-[12px] font-medium text-muted"><span>Max Upfront Cash</span><span>Max Backend Upside</span></div>
        <div class="relative mt-1.5 max-[700px]:mt-1">
          <div class="absolute left-0 right-0 top-3 max-[700px]:top-3.5 h-1 rounded-sm bg-line"></div>
          <div id="deal-fill" class="absolute left-0 top-3 max-[700px]:top-3.5 h-1 rounded-sm bg-ink" style="width: 0%"></div>
          <label for="deal-slider" class="sr-only">Backend split</label>
          <input id="deal-slider" class="range relative" type="range" min="0" max="100" step="1" value="0" />
        </div>

        <div class="mt-[18px] max-[700px]:mt-3.5 grid grid-cols-2 gap-2.5 max-[700px]:gap-2">
          <div class="border border-line rounded-xl p-4 max-[700px]:p-3.5">
            <label for="offer-amount" class="block text-[11px] font-semibold uppercase tracking-[0.08em]">Upfront Offer</label>
            <div class="tnum mt-2.5 max-[700px]:mt-2 flex items-center h-12 max-[700px]:h-10 text-[26px] max-[700px]:text-[22px] font-semibold tracking-[-0.02em] border-b border-transparent hover:border-line-strong focus-within:border-ink transition-colors">
              <span>$</span>
              <input id="offer-amount" type="text" inputmode="numeric" value="465,000" class="tnum w-full min-w-0 bg-transparent border-0 p-0 font-semibold tracking-[-0.02em] text-ink focus:outline-none" style="font-size: inherit" />
            </div>
            <div class="mt-2 max-[700px]:mt-1.5 text-[12px] text-muted">Cash at closing</div>
          </div>
          <div class="border border-line rounded-xl p-4 max-[700px]:p-3.5 flex flex-col">
            <div class="text-[11px] font-semibold uppercase tracking-[0.08em]">Backend Split</div>
            <div class="flex items-end gap-2.5 max-[700px]:gap-2 mt-1.5">
              <svg viewBox="0 0 160 90" class="w-[86px] h-12 max-[700px]:w-[66px] max-[700px]:h-[37px] shrink-0" aria-hidden="true">
                <path id="gauge-off" d="" stroke="#D2D2CB" stroke-width="3" stroke-linecap="round" fill="none"></path>
                <path id="gauge-on" d="" stroke="#121212" stroke-width="3" stroke-linecap="round" fill="none"></path>
              </svg>
              <span id="split-pct" class="tnum text-[26px] max-[700px]:text-[20px] font-semibold tracking-[-0.02em]">0%</span>
            </div>
            <div class="mt-auto pt-2 max-[700px]:pt-1.5 text-[12px] text-muted">Of profit above offer</div>
          </div>
        </div>

        <div class="mt-4 max-[700px]:mt-3.5 pt-4 max-[700px]:pt-3.5 border-t border-hairline">
          <!-- Collapsed by default: the resale breakdown is detail, the Est. Net
               Proceeds callout below carries the headline number on its own. -->
          <details>
            <summary class="flex items-center gap-3 max-[700px]:gap-2.5 h-[52px] px-4 max-[700px]:px-3.5 border border-line rounded-xl hover:border-line-strong transition-colors">
              <span class="text-[14px] font-medium">Your Potential Earnings</span>
              <span id="split-badge" class="ml-auto text-[14px] font-semibold">0% split</span>
              <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5E5E58" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <div class="mt-2.5 border border-line rounded-xl px-4 py-3.5 max-[700px]:p-3">
              <div class="grid grid-cols-3 text-[11px] font-semibold uppercase tracking-[0.08em] px-1.5 pb-2"><span>Resale</span><span class="text-center">Backend</span><span class="text-right">Total</span></div>
              <div id="earnings-table"></div>
              <p class="mt-2.5 text-[12px] text-muted">* Resale price not guaranteed.</p>
            </div>
          </details>

          <!-- Est. Net Proceeds callout — base-case total (cash + bonus at projected resale) -->
          <div class="mt-4 max-[700px]:mt-3.5 bg-ink text-white rounded-xl px-[18px] py-4 max-[700px]:px-4">
            <div class="flex justify-between items-center gap-3 max-[700px]:gap-2.5">
              <div>
                <div class="text-[11px] font-semibold uppercase tracking-[0.08em]">Est. Net Proceeds</div>
                <div class="text-[12px] max-[700px]:text-[11px] text-[#BDBDB6] mt-0.5">Cash at closing + potential bonus check later</div>
              </div>
              <div id="net-proceeds" class="tnum text-[30px] max-[700px]:text-[26px] font-semibold tracking-[-0.03em]">$465,000</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TWO PAYMENTS, ONE SALE ─── -->
  <section id="sell" class="py-[88px] max-[700px]:py-12">
    <div class="wrap-wide">
      <div class="text-center max-w-[680px] mx-auto">
        <h2 class="fs-h2 max-[700px]:text-[30px] max-[700px]:leading-[1.1]">Two payments. One simple sale.</h2>
        <p class="fs-lede mt-3.5 max-[700px]:mt-3 max-[700px]:text-[15px]">Every other home buyer pays you once. With FlipSplit, you get cash now <em>and</em> share the upside when your home resells.</p>
      </div>
      <div class="mt-11 max-[700px]:mt-6 grid grid-cols-2 gap-5 max-[700px]:grid-cols-1 max-[700px]:gap-3">
        <div class="bg-white border border-line rounded-2xl max-[700px]:rounded-[14px] p-9 max-[700px]:p-6">
          <div class="flex justify-between items-center"><span class="text-[12px] max-[700px]:text-[11px] font-semibold uppercase tracking-[0.1em]">Payment 1 · At closing</span><span class="chip">01</span></div>
          <div class="tnum mt-[18px] max-[700px]:mt-3.5 text-[60px] max-[700px]:text-[48px] leading-none font-semibold tracking-[-0.045em]">$900k</div>
          <div class="mt-[18px] max-[700px]:mt-3.5 h-2 rounded bg-ink"></div>
          <p class="mt-[18px] max-[700px]:mt-3.5 text-[16px] max-[700px]:text-[15px] leading-[1.6] text-muted">A guaranteed cash payment, wired the day we close. Use it however you want — buy your next home, pay down debt, retire early.</p>
        </div>
        <div class="bg-ink text-white rounded-2xl max-[700px]:rounded-[14px] p-9 max-[700px]:p-6">
          <div class="flex justify-between items-center"><span class="text-[12px] max-[700px]:text-[11px] font-semibold uppercase tracking-[0.1em]">Payment 2 · After resale</span><span class="chip border-[#3A3A36]">02</span></div>
          <div class="tnum mt-[18px] max-[700px]:mt-3.5 text-[60px] max-[700px]:text-[48px] leading-none font-semibold tracking-[-0.045em]">+$125k</div>
          <div class="hatch-w mt-[18px] max-[700px]:mt-3.5 h-2 rounded w-[40%]"></div>
          <p class="mt-[18px] max-[700px]:mt-3.5 text-[16px] max-[700px]:text-[15px] leading-[1.6] text-[#D4D4CE]">A potential bonus check after we renovate and resell, if the home sells above our projection.</p>
        </div>
      </div>
      <p class="mt-6 max-[700px]:mt-[18px] text-center text-[12px] text-muted italic">Example scenario · actual numbers vary by property</p>
    </div>
  </section>

  <!-- ─── HOW IT WORKS: four-stage board ─── -->
  <section id="how" class="border-y border-line py-[88px] max-[700px]:py-12 bg-wash">
    <div class="wrap-wide">
      <div class="flex justify-between items-end gap-6 flex-wrap max-[700px]:block">
        <div>
          <div class="eyebrow max-[700px]:text-[12px]">How it works</div>
          <h2 class="fs-h2 mt-2 max-[700px]:leading-[1.1]">From offer to potential bonus,<br class="max-[700px]:hidden" /> in four stages.</h2>
        </div>
        <p class="m-0 max-[700px]:mt-3 text-[16px] max-[700px]:text-[15px] text-muted max-w-[360px] max-[700px]:max-w-none leading-[1.55]">You see every stage in your dashboard, from the first offer to the day a potential bonus lands.</p>
      </div>

      <div class="mt-10 max-[700px]:mt-7 grid grid-cols-4 gap-4 max-[1000px]:grid-cols-2 max-[700px]:grid-cols-1 max-[700px]:gap-7">
        {stages.map((s) => (
          <div class="flex flex-col gap-2.5">
            <div class="flex justify-between items-center h-9 max-[700px]:h-8">
              <h3 class="m-0 text-[18px] font-medium tracking-[-0.01em]">{s.title}</h3>
              <span class="chip">{s.n}</span>
            </div>
            {s.cards.map((c) => (
              <div class:list={["rounded-xl p-4 flex flex-col gap-2 min-h-[132px] max-[700px]:min-h-0 box-border border", c.bg, c.fg, c.line]}>
                <span class="text-[15px] font-semibold">{c.title}</span>
                <span class:list={["text-[14px] leading-[1.45]", c.sub]}>{c.body}</span>
                <span class:list={["mt-auto max-[700px]:mt-1 self-start inline-flex items-center gap-1.5 text-[12px] px-2 py-1 rounded-md border", c.line2]}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18"></path><path d="M8 3v4"></path><path d="M16 3v4"></path></svg>
                  {c.meta}
                </span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDIES — Real homes. Real numbers. ─── -->
  <section class="pt-10 pb-[104px] max-[700px]:pt-6 max-[700px]:pb-12">
    <div class="wrap-wide">
      <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-[72px] items-start max-[1000px]:grid-cols-1 max-[1000px]:gap-10 max-[700px]:gap-5">
        <div>
          <h2 class="fs-h2 max-[700px]:leading-[1.1]">Real homes.<br />Real numbers.</h2>
          <p class="fs-lede mt-[18px] max-[700px]:mt-3 max-[700px]:text-[16px] max-w-[440px] max-[700px]:max-w-none">Here's what a typical FlipSplit sale looks like end-to-end. Drag any photo to see the transformation.</p>
          <div class="mt-9 max-[700px]:mt-5 grid grid-cols-2 gap-3 max-[700px]:gap-2.5 max-w-[440px] max-[700px]:max-w-none">
            <div class="border border-line rounded-[14px] p-[18px] max-[700px]:p-4">
              <div class="tnum text-[40px] max-[700px]:text-[32px] leading-none font-semibold tracking-[-0.04em]">2,500+</div>
              <div class="mt-2 max-[700px]:mt-1.5 text-[13px] max-[700px]:text-[12px] text-muted">Homes renovated and resold</div>
            </div>
            <div class="border border-line rounded-[14px] p-[18px] max-[700px]:p-4">
              <div class="tnum text-[40px] max-[700px]:text-[32px] leading-none font-semibold tracking-[-0.04em]">20 yrs</div>
              <div class="mt-2 max-[700px]:mt-1.5 text-[13px] max-[700px]:text-[12px] text-muted">Of home-flipping experience</div>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-6 max-[700px]:gap-4">
          {cases.map((c) => (
            <article class="border border-line rounded-2xl overflow-hidden bg-white">
              <div class="ba-slider relative aspect-[3/2] bg-mute overflow-hidden cursor-ew-resize select-none touch-none [--pos:50%]" role="img" aria-label={c.label}>
                <img src={c.after} alt={c.afterAlt} draggable="false" class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
                <img src={c.before} alt={c.beforeAlt} draggable="false" class="absolute inset-0 w-full h-full object-cover pointer-events-none [clip-path:inset(0_calc(100%-var(--pos))_0_0)]" />
                <div class="absolute top-0 bottom-0 w-0.5 bg-white left-(--pos) -translate-x-px pointer-events-none" aria-hidden="true"></div>
                <div class="absolute top-1/2 left-(--pos) w-10 h-10 -mt-5 -ml-5 max-[700px]:w-9 max-[700px]:h-9 max-[700px]:-mt-[18px] max-[700px]:-ml-[18px] rounded-full bg-white flex items-center justify-center shadow-[0_4px_14px_rgba(0,0,0,0.22)] pointer-events-none" aria-hidden="true">
