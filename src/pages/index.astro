  <script is:inline>
    // Bind drag/touch/keyboard handlers to every .ba-slider on the page.
    // Wrapped in a run-once guard + re-run on astro:page-load so the sliders
    // are (re)wired after every ClientRouter view-transition swap — otherwise
    // landing on this page via an in-app link (e.g. the header logo) leaves
    // the freshly-swapped sliders with no handlers. Per-element dataset guard
    // keeps re-runs from binding the same slider twice. The window-level
    // pointer listeners are bound once and act on the slider tracked in
    // window.__baActive (set on press) to avoid stale-closure issues.
    if (!window.__baWired) {
      window.__baWired = true;

      function baInitSliders() {
        document.querySelectorAll('.ba-slider').forEach(function (el) {
          if (el.dataset.baInit === '1') return;
          el.dataset.baInit = '1';

          function setPos(pct) {
            el.style.setProperty('--pos', Math.max(0, Math.min(100, pct)) + '%');
          }
          function updateFromEvent(e) {
            var rect = el.getBoundingClientRect();
            var x = (e.touches && e.touches[0]) ? e.touches[0].clientX : e.clientX;
            setPos(((x - rect.left) / rect.width) * 100);
          }

          el.addEventListener('mousedown',  function (e) { window.__baActive = updateFromEvent; updateFromEvent(e); e.preventDefault(); });
          el.addEventListener('touchstart', function (e) { window.__baActive = updateFromEvent; updateFromEvent(e); }, { passive: true });

          el.setAttribute('tabindex', '0');
          el.addEventListener('keydown', function (e) {
            var cur = parseFloat(getComputedStyle(el).getPropertyValue('--pos')) || 50;
            if (e.key === 'ArrowLeft')  { setPos(cur - 5); e.preventDefault(); }
            if (e.key === 'ArrowRight') { setPos(cur + 5); e.preventDefault(); }
          });
        });
      }

      // Bound once: drag the slider currently held down (window.__baActive).
      window.addEventListener('mousemove', function (e) { if (window.__baActive) window.__baActive(e); });
      window.addEventListener('touchmove', function (e) { if (window.__baActive) window.__baActive(e); }, { passive: true });
      window.addEventListener('mouseup',     function () { window.__baActive = null; });
      window.addEventListener('touchend',    function () { window.__baActive = null; });
      window.addEventListener('touchcancel', function () { window.__baActive = null; });

      baInitSliders();
      document.addEventListener('astro:page-load', baInitSliders);
    }
  </script>

