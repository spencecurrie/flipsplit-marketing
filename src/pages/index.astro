  <script>
    // The offer calculator is (re)initialized on astro:page-load so it works
    // after every ClientRouter swap — landing here via an in-app link (e.g. the
    // header logo) re-runs it instead of leaving fresh DOM uninitialized. A
    // dataset guard keeps a re-run from double-binding the same instance.

    // Backend Split gauge: 30 radial ticks on a half circle, filled up to pct.
    function gauge(pct: number) {
      const n = 30, cx = 80, cy = 84, r1 = 58, r2 = 78;
      let on = '', off = '';
      for (let i = 0; i < n; i++) {
        const a = Math.PI - Math.PI * i / (n - 1);
        const s = 'M' + (cx + r1 * Math.cos(a)).toFixed(1) + ' ' + (cy - r1 * Math.sin(a)).toFixed(1) +
                  'L' + (cx + r2 * Math.cos(a)).toFixed(1) + ' ' + (cy - r2 * Math.sin(a)).toFixed(1);
        if (pct > 0 && i / (n - 1) <= pct) on += s; else off += s;
      }
      return { on, off };
    }

    function initDealCalculator() {
      const slider  = document.getElementById('deal-slider') as HTMLInputElement | null;
      const offerEl = document.getElementById('offer-amount') as HTMLInputElement | null;
      const splitEl = document.getElementById('split-pct');
      const badgeEl = document.getElementById('split-badge');
      const tableEl = document.getElementById('earnings-table');
      const netEl   = document.getElementById('net-proceeds');
      const fillEl  = document.getElementById('deal-fill');
      const gOn     = document.getElementById('gauge-on');
      const gOff    = document.getElementById('gauge-off');
      if (!slider || !offerEl || !splitEl || !badgeEl || !tableEl || !netEl || !fillEl || !gOn || !gOff) return;
      if (slider.dataset.dealInit === '1') return;
      slider.dataset.dealInit = '1';

      // maxOffer = the upfront cash at slider=0 (max upfront cash position).
      // Resale projections are anchored to this so they stay static as the
      // slider moves — only the upfront/backend mix changes.
      let maxOffer = 465000;

      const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

      function updateTable(currentOffer: number, pct: number) {
        const projected  = Math.round(maxOffer * 1.2);
        const steps      = [0, 20000, 40000, 60000];
        const resaleRows = steps.map(s => projected + s);

        splitEl!.textContent = pct + '%';
        badgeEl!.textContent = pct + '% split';
        fillEl!.style.width = pct + '%';
        const g = gauge(pct / 100);
        gOn!.setAttribute('d', g.on);
        gOff!.setAttribute('d', g.off);

        // Net proceeds = base-case total (first row: cash + bonus at projected resale)
        const baseBackend = Math.max(0, resaleRows[0] - currentOffer) * (pct / 100);
        netEl!.textContent = fmt(currentOffer + baseBackend);

        tableEl!.innerHTML = resaleRows.map((resale, i) => {
          const above   = Math.max(0, resale - currentOffer);
          const backend = above * (pct / 100);
          const total   = currentOffer + backend;
          const isBase  = i === 0;
          return `
            <div class="tnum grid grid-cols-3 text-[13px] max-[700px]:text-[12px] px-1.5 py-[7px] rounded-lg ${isBase ? 'bg-[#F6F6F3]' : ''}">
              <span class="font-semibold">${fmt(resale)}${isBase ? ' <span class="font-normal text-muted">proj.</span>' : ''}</span>
              <span class="text-center ${backend > 0 ? 'font-semibold' : 'font-normal'}">${backend > 0 ? '+' + fmt(backend) : '—'}</span>
              <span class="text-right font-semibold">${fmt(total)}</span>
            </div>`;
        }).join('');
      }

      // Typing in the upfront offer field sets the new max-upfront amount
      // and snaps the slider back to 0% backend.
      offerEl.addEventListener('input', () => {
        const raw = offerEl.value.replace(/[^0-9]/g, '');
        offerEl.value = parseInt(raw || '0').toLocaleString('en-US');
        maxOffer = parseInt(raw) || 465000;
        slider.value = '0';
        updateTable(maxOffer, 0);
      });

      // Each 1% of backend trades $1,000 of upfront cash.
      slider.addEventListener('input', () => {
        const pct          = parseInt(slider.value);
        const currentOffer = Math.max(0, maxOffer - pct * 1000);
        offerEl.value = currentOffer.toLocaleString('en-US');
        updateTable(currentOffer, pct);
      });

      // Reset to a known state and paint the initial fill/gauge/table.
      slider.value = '0';
      updateTable(maxOffer, 0);
    }

    initDealCalculator();
    document.addEventListener('astro:page-load', initDealCalculator);
  </script>

