---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro'
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';
import Analytics from '@vercel/analytics/astro';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = 'About FlipSplit | Our Story & Mission';
const pageDescription = 'FlipSplit was founded to give homeowners a more honest, profitable way to sell. Learn our story, our mission, and the team behind the model.';

const stats = [
  { n: '01', value: '2,000+', label: 'Homes flipped' },
  { n: '02', value: '15+', label: 'Years in real estate' },
  { n: '03', value: '$0', label: 'Fees to homeowners' },
  { n: '04', value: '5.0★', label: 'Average review rating' },
];

const values = [
  { num: '01', title: 'Honesty above profit', body: 'Our profit-sharing model exists to prove this point. If we underpay you, the resale will show it — and you’ll be compensated. We have every financial incentive to be accurate and transparent.' },
  { num: '02', title: 'Do what’s best for the homeowner', body: 'Every decision we make — from offer pricing to renovation scope — is run through one filter: is this the best outcome for the homeowner? If the answer is no, we don’t do it.' },
  { num: '03', title: 'Serve others', body: 'Real estate is a people business. We return calls, answer questions, and stay in contact through every stage. You will always have a real person to talk to.' },
];

const areas = ['Los Angeles County', 'Orange County', 'San Diego County', 'Inland Empire', 'Anaheim', 'Long Beach', 'Riverside', 'San Bernardino'];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={pageTitle} description={pageDescription} url={canonicalURL} />
  <Analytics />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <main>
    <!-- Hero -->
    <section id="top" class="py-24 border-b border-line">
      <div class="wrap max-w-[960px]!">
        <span class="pill font-mono text-[12px]! uppercase tracking-[0.08em]"><span class="pill-dot bg-ink"></span>Our Story</span>
        <h1 class="fs-h1 mt-[22px]">Built to fix a<br />broken industry.</h1>
        <p class="mt-[22px] text-[18px] leading-[1.6] text-muted max-w-[640px]">FlipSplit was founded on a simple belief: homeowners deserve to share in the profit when their home sells for more than expected — not watch a cash buyer pocket it all.</p>
      </div>
    </section>

    <!-- Founder story -->
    <section class="py-[104px]">
      <div class="wrap-wide">
        <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-[72px] items-center max-[1000px]:grid-cols-[minmax(0,1fr)] max-[1000px]:gap-10">
          <div>
            <div class="eyebrow">The Founder</div>
            <h2 class="mt-3 text-[32px] leading-[1.15] tracking-[-0.03em] font-semibold">Stephen saw homeowners getting shortchanged. So he changed the model.</h2>
            <div class="mt-[22px] flex flex-col gap-4 text-[16px] leading-[1.65] text-muted">
              <p>After 15+ years in real estate and flipping over 2,000 homes across Southern California, FlipSplit founder Stephen recognized a fundamental problem: cash buyers and iBuyers were profiting enormously from renovations while the original homeowner received nothing beyond their initial offer.</p>
              <p>The math was obvious. Buy a distressed home at a discount, spend $150K on renovations, sell for $400K more. The homeowner who enabled that entire transaction? They got a fixed cash offer and never heard from you again.</p>
              <p>FlipSplit flips that model. We still buy your home as-is with a guaranteed cash offer — but if the renovated home sells for more than we projected, you get a cut. Your home, your upside.</p>
            </div>
            <div class="mt-7 flex items-center gap-3.5 pt-[22px] border-t border-line">
              <span class="w-12 h-12 rounded-full bg-ink text-white text-[18px] font-semibold flex items-center justify-center" aria-hidden="true">S</span>
              <div>
                <div class="text-[16px] font-semibold">Stephen</div>
                <div class="text-[14px] text-muted">Founder, FlipSplit</div>
              </div>
            </div>
          </div>
          <div class="tnum grid grid-cols-2 gap-3">
            {stats.map((s) => (
              <div class="fs-card px-6 py-7 flex flex-col gap-2.5">
                <span class="chip self-start">{s.n}</span>
                <div class="text-[44px] leading-none font-semibold tracking-[-0.04em]">{s.value}</div>
                <div class="text-[14px] text-muted">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="py-[104px] bg-cream">
      <div class="wrap max-w-[960px]! text-center">
        <div class="eyebrow">Our Mission</div>
        <h2 class="mt-3.5 text-[44px] max-[700px]:text-[30px] leading-[1.12] tracking-[-0.035em] font-semibold">“To provide homeowners with outdated or distressed homes an easier and more profitable way to sell.”</h2>
        <p class="mt-5 mx-auto text-[18px] leading-[1.6] text-muted max-w-[640px]">That's it. Everything we build — our offer model, our renovation process, our profit-sharing structure — exists to serve that mission.</p>
      </div>
    </section>

    <!-- Values -->
    <section class="py-[104px]">
      <div class="wrap-wide">
        <div class="text-center">
          <div class="eyebrow">How We Operate</div>
          <h2 class="mt-2.5 text-[36px] leading-[1.1] tracking-[-0.035em] font-semibold">Three values. No exceptions.</h2>
        </div>
        <div class="mt-11 grid grid-cols-3 gap-4 max-[700px]:grid-cols-1">
          {values.map((v) => (
            <div class="fs-card p-7">
              <span class="chip inline-block">{v.num}</span>
              <h3 class="mt-[18px] text-[20px] font-semibold tracking-[-0.015em]">{v.title}</h3>
              <p class="mt-2.5 text-[15px] leading-[1.65] text-muted">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Service areas -->
    <section id="where" class="py-16 border-t border-line">
      <div class="wrap-wide">
        <div class="flex justify-between items-center gap-6 max-[1000px]:flex-col max-[1000px]:items-start">
          <div>
            <div class="eyebrow">Where We Work</div>
            <h3 class="mt-2 text-[22px] font-semibold tracking-[-0.02em]">Serving all of Southern California.</h3>
          </div>
          <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
            {areas.map((a) => (
              <li class="inline-flex items-center gap-1.5 text-[13px] font-medium px-2.5 py-1.5 border border-line rounded-lg">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>{a}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="get-offer" class="py-[104px] bg-ink text-white">
      <div class="wrap max-w-[680px]! text-center">
        <h2 class="text-[44px] leading-[1.08] tracking-[-0.035em] font-semibold text-white">Ready to see what your home is worth?</h2>
        <p class="mt-3.5 text-[17px] text-[#C8C8C2]">Free offer. No obligation. Results in 24–48 hours.</p>
        <div class="mt-8">
          <AddressForm id="about-form" theme="dark" align="center" showTrust={true} />
        </div>
      </div>
    </section>
  </main>

  <Footer current="/about/" />

</body>
</html>
