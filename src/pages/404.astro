---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AddressForm from '../components/AddressForm.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';

// Built to dist/404.html, which Vercel serves for any unknown URL. No
// canonical or social tags: this page has no URL of its own.
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found | FlipSplit</title>
  <meta name="robots" content="noindex, follow" />
  <SiteAnalytics />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <ClientRouter />
</head>
<body class="bg-white text-ink font-sans antialiased">

  <Nav />

  <main>
    <section id="top" class="pt-14 pb-[72px] text-center">
      <div class="wrap"><div class="max-w-[680px] mx-auto">
        <h1 class="fs-h1 max-[700px]:text-[38px]!">We couldn't find that page</h1>
        <p class="mt-4 mx-auto max-w-[560px] text-[18px] leading-[1.55] text-muted">The link may be old, or the page may have moved. You can head back to the <a href="/" class="text-ink underline underline-offset-[3px]">homepage</a>, or start your free cash offer below.</p>
        <div class="mt-8">
          <AddressForm id="notfound-form" theme="light" align="center" showTrust={false} />
        </div>
      </div></div>
    </section>
  </main>

  <Footer />

</body>
</html>
