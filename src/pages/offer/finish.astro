---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FlipSplit — Preparing your offer</title>
  <link rel="canonical" href={canonicalURL} />
  {/* transient post-submit screen */}
  <meta name="robots" content="noindex, follow" />
  <ClientRouter />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    .finish-spin { animation: fsspin 0.85s linear infinite; }
    @keyframes fsspin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .finish-spin { animation: none; } }
  </style>
</head>
<body class="bg-white text-ink min-h-screen flex flex-col">
  <div class="h-1 bg-ink"></div>
  <header class="w-full max-w-[1152px] mx-auto px-6 box-border h-[76px] flex items-center">
    <a href="/" class="flex items-center gap-2.5 no-underline text-ink">
      <img src="/logo-mark.png" alt="" width="34" height="34" class="block w-[34px] h-[34px] object-contain" />
      <span class="text-[19px] font-semibold tracking-[-0.02em]">FlipSplit</span>
    </a>
  </header>

  <main class="w-full max-w-[1152px] mx-auto px-6 box-border flex-1 flex flex-col items-center justify-center text-center pb-[76px]">
    <div class="w-[88px] h-[88px] rounded-[20px] border border-line flex items-center justify-center mb-8">
      <div class="finish-spin w-11 h-11 rounded-full border-[3px] border-line border-t-ink box-border" aria-hidden="true"></div>
    </div>
    <h1 class="m-0 mb-3 text-[40px] max-[640px]:text-[30px] leading-[1.1] tracking-[-0.035em] font-semibold">Preparing your offer…</h1>
    <p class="m-0 max-w-[448px] text-[18px] leading-[1.55] text-muted">We're saving your details and taking you to create an account so we can text you when your offer is ready.</p>
    <p id="finish-error" class="hidden text-[14px] text-danger font-medium mt-6"></p>
    <div id="preview-note" class="hidden mt-6 mx-auto max-w-[32rem] bg-cream border border-line rounded-xl px-5 py-4 text-[14px] text-ink"></div>
  </main>

  <script>
    import { getSupabase } from '../../lib/supabase';
    import { readFunnelSessionId } from '../../lib/funnelSession';

    // crypto.randomUUID() only exists in "secure contexts" — HTTPS or
    // localhost — so it's missing when the site is opened over a plain-HTTP LAN
    // IP (e.g. http://192.168.x.x:4321 for mobile testing). Fall back to a
    // v4 UUID built from getRandomValues (available everywhere), then Math.random.
    const genUUID = (): string => {
      const c = (globalThis as any).crypto;
      if (typeof c?.randomUUID === 'function') return c.randomUUID();
      const bytes = new Uint8Array(16);
      if (typeof c?.getRandomValues === 'function') {
        c.getRandomValues(bytes);
      } else {
        for (let i = 0; i < 16; i++) bytes[i] = Math.floor(Math.random() * 256);
      }
      bytes[6] = (bytes[6] & 0x0f) | 0x40; // version 4
      bytes[8] = (bytes[8] & 0x3f) | 0x80; // variant 10xx
      const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
      return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
    };

    (async () => {
      const errorEl = document.getElementById('finish-error');
      const previewEl = document.getElementById('preview-note');
      const showError = (msg: string) => {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      };

      // Preview mode: just display a banner instead of redirecting
      const isPreview = new URL(window.location.href).searchParams.get('preview') === '1';
      if (isPreview) {
        if (previewEl) {
          previewEl.classList.remove('hidden');
          previewEl.innerHTML = `Preview mode — would generate a claim token and redirect to <code style="background:#fff;padding:2px 6px;border-radius:4px;font-family:var(--font-mono);font-size:13px;">/signup/?claim=&lt;token&gt;</code>`;
        }
        return;
      }

      try {
        const supabase = getSupabase();

        // 1. Verify session
        const { data: userData } = await supabase.auth.getUser();
        if (!userData.user) {
          window.location.replace('/');
          return;
        }
        const userId = userData.user.id;
        // Recorded on the funnel_completed event only; both kinds of visitor
        // take the same claim-token route below.
        const isAnonymous = !!userData.user.is_anonymous;

        // 2. The row the funnel was working on (see OfferLayout), falling back
        //    to the user's most-recent unfinished one.
        const { data: sessions, error: selErr } = await supabase
          .from('qualification_sessions')
          .select('id')
          .eq('user_id', userId)
          .eq('status', 'in_progress')
          .order('created_at', { ascending: false });
        if (selErr) throw selErr;
        const chosenId = readFunnelSessionId();
        const session = sessions?.find((s: any) => s.id === chosenId) ?? sessions?.[0];
        if (!session) {
          window.location.replace('/');
          return;
        }

        // No Attio push here: it would go out before the account step, with no
        // name or email (or the wrong person's). The database pushes the lead
        // when it completes — see migration 0060.

        // Everyone goes through /signup with a claim token — signed in or not.
        // Each new address is a new lead, and the homeowner picks which account
        // it belongs to (the browser may be signed in as someone else). An
        // existing account skips the phone step there (its number is copied
        // over); a new one has to give one. See routeAfterClaim in signup.astro.
        const claimToken = genUUID();
        // A day, not an hour: someone who wanders off mid-signup keeps their lead.
        const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();

        const { error: updErr } = await supabase
          .from('qualification_sessions')
          .update({
            claim_token: claimToken,
            claim_token_expires_at: expiresAt,
            current_step: 7,
          })
          .eq('id', session.id);
        if (updErr) throw updErr;

        await supabase.from('events').insert({
          session_id: session.id,
          user_id: userId,
          event_name: 'funnel_completed',
          payload: { auth_state: isAnonymous ? 'anonymous' : 'existing_account' },
        });

        // Sign out so /signup asks who this is. For an anonymous visitor this
        // also means signup creates a genuinely new account rather than
        // converting the throwaway one — the claim token is what carries the
        // funnel answers over to whichever account they choose.
        // scope 'local': sign out of THIS site only. The default ('global')
        // revokes the account's sessions everywhere, logging them out of the
        // app on every device too.
        await supabase.auth.signOut({ scope: 'local' });
        window.location.assign(`/signup/?claim=${claimToken}`);
      } catch (err: any) {
        console.error('Finish step failed:', err);
        showError(err?.message || 'Something went wrong preparing your offer. Please try again.');
      }
    })();
  </script>

</body>
</html>
