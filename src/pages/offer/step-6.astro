---
import OfferLayout from '../../layouts/OfferLayout.astro';

const options = [
  {
    value: 'renovate_max_value',
    label: 'Renovate to achieve max value',
    description: 'Take a smaller cash payment now, then share in the resale upside after we renovate.',
    accent: 'blue',
    pill: 'Maximize Your Return',
    icon: 'trending',
  },
  {
    value: 'quick_sale',
    label: 'Quick sale to access funds now',
    description: 'Take the full cash offer at closing. Skip the wait, skip the upside.',
    accent: 'blue',
    pill: 'Simple & Fast',
    icon: 'bolt',
  },
  {
    value: 'convenient_sale',
    label: 'Convenient sale',
    description: 'Coordinate the sale of your current home with the purchase of your next one.',
    accent: 'blue',
    pill: 'Move on Your Schedule',
    icon: 'calendar',
  },
];
---

<OfferLayout
  step={6}
  title="What are your goals in your home sale?"
  subtitle="There are no wrong answers — your goal helps us recommend the right offer."
  backHref="/offer/step-5/"
  nextHref="/offer/step-7/"
  autoAdvance={true}
>
  <div class="grid grid-cols-3 gap-5 max-w-[1024px] mx-auto max-[860px]:grid-cols-1 max-[860px]:gap-3" role="group" aria-label="Your goal">
    {options.map((opt) => (
      <button
        type="button"
        class={`goal-card goal-card--${opt.accent}`}
        data-value={opt.value}
        aria-pressed="false"
      >
        <span class="goal-card-icon w-[52px] h-[52px] rounded-xl flex items-center justify-center mb-[18px]">
          {opt.icon === 'bolt' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
          )}
          {opt.icon === 'trending' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>
          )}
          {opt.icon === 'calendar' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="M9 16l2 2 4-4"/></svg>
          )}
        </span>

        <span class="goal-card-pill self-start font-mono text-[11px] uppercase tracking-[0.06em] px-2 py-1 rounded-[6px] mb-3.5">{opt.pill}</span>

        <span class="goal-card-label block text-[20px] font-semibold leading-[1.25] tracking-[-0.01em] mb-2">{opt.label}</span>
        <span class="goal-card-desc block text-[15px] leading-[1.55]">{opt.description}</span>

        <span class="goal-card-arrow absolute top-6 right-6 w-8 h-8 rounded-full flex items-center justify-center" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </span>
      </button>
    ))}
  </div>
</OfferLayout>

<script>
  declare global {
    interface Window {
      __funnel: {
        sessionId: string;
        session: any;
        getSelected: () => Record<string, unknown> | null;
        advance: () => Promise<void>;
        setError: (msg: string) => void;
        clearError: () => void;
      };
    }
  }

  const setup = (session: { selling_goal?: string | null }) => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.goal-card'));
    const nextBtn = document.getElementById('offer-next') as HTMLButtonElement;
    let selected: string | null = null;
    let advancing = false;

    const render = () => {
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.value === selected ? 'true' : 'false');
        b.disabled = advancing;
      });
      nextBtn.disabled = !selected || advancing;
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        if (advancing) return;
        selected = b.dataset.value!;
        advancing = true;
        render();
        setTimeout(() => window.__funnel.advance(), 280);
      });
    });

    window.__funnel.getSelected = () => (selected ? { selling_goal: selected } : null);
    render();
  };

  if ((window as any).__funnel?.session) {
    setup((window as any).__funnel.session);
  } else {
    window.addEventListener('funnel-ready', (e) => setup((e as CustomEvent).detail), { once: true });
  }
</script>
