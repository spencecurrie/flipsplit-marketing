---
import OfferLayout from '../../layouts/OfferLayout.astro';

const programs = [
  {
    value: 'instant_cash',
    name: 'Instant Cash Offer',
    tagline: 'All your cash upfront',
    bestFor: 'Sellers who prioritize speed and certainty above all else.',
    highlights: [
      'Quick close — pick your date',
      'Zero seller fees',
      'No repairs needed',
    ],
    recommended: false,
  },
  {
    value: 'cash_plus_upside',
    name: 'Cash + Upside',
    tagline: 'Cash now plus a share of the resale profit',
    bestFor: 'Sellers who want to maximize value while still getting cash today.',
    highlights: [
      'Strong cash payment at closing',
      'Share the upside when we resell',
      'We handle the renovation + sale',
    ],
    recommended: true,
  },
];
---

<OfferLayout
  step={7}
  title="Which program do you want to explore?"
  subtitle="You're not locked in — your final offer details get finalized after our walkthrough."
  backHref="/offer/step-6/"
  nextHref="/offer/finish/"
  autoAdvance={true}
>
  <div class="grid grid-cols-2 gap-5 max-w-[896px] mx-auto max-[760px]:grid-cols-1 max-[760px]:gap-3" role="group" aria-label="Program">
    {programs.map((p) => (
      <button
        type="button"
        class="program-card group"
        data-value={p.value}
        aria-pressed="false"
      >
        {p.recommended && (
          <span class="program-card-badge absolute top-[18px] right-[18px] inline-flex items-center gap-[5px] text-[12px] font-semibold px-[9px] py-1 rounded-[6px] bg-cream">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#121212" aria-hidden="true"><path d="M12 2l3 6.6 7.2.7-5.4 4.8 1.6 7.1L12 17.5 5.6 21.2l1.6-7.1L1.8 9.3 9 8.6z"/></svg>Recommended
          </span>
        )}
        <span class={`block text-[24px] font-semibold tracking-[-0.02em] mb-1.5 ${p.recommended ? 'pr-32' : ''}`}>{p.name}</span>
        <span class="block text-[14px] text-muted mb-[22px]">{p.tagline}</span>

        <span class="block text-[11px] font-semibold uppercase tracking-[0.1em] mb-2">Best for</span>
        <span class="block text-[14px] leading-[1.55] mb-[22px]">{p.bestFor}</span>

        <span class="block text-[11px] font-semibold uppercase tracking-[0.1em] mb-2.5 mt-auto pt-4 border-t border-hairline">Feature highlights</span>
        <span class="flex flex-col gap-2.5 mb-6">
          {p.highlights.map((h) => (
            <span class="flex items-start gap-2 text-[14px]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 mt-px"><path d="M5 13l4 4L19 7"/></svg>
              <span>{h}</span>
            </span>
          ))}
        </span>

        <span class="program-card-cta flex items-center justify-center h-[46px] rounded-[10px] text-[14px] font-medium">
          <span class="program-card-cta-default">Select option</span>
          <span class="program-card-cta-selected">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
            Selected
          </span>
        </span>
      </button>
    ))}
  </div>
</OfferLayout>

<script>
  declare global {
    interface Window {
      __funnel: {
        sessionId: string;
        session: any;
        getSelected: () => Record<string, unknown> | null;
        advance: () => Promise<void>;
        setError: (msg: string) => void;
        clearError: () => void;
      };
    }
  }

  const setup = (session: { program_preference?: string | null }) => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.program-card'));
    const nextBtn = document.getElementById('offer-next') as HTMLButtonElement;
    let selected: string | null = null;
    let advancing = false;

    const render = () => {
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.value === selected ? 'true' : 'false');
        b.disabled = advancing;
      });
      if (nextBtn) nextBtn.disabled = !selected || advancing;
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        if (advancing) return;
        selected = b.dataset.value!;
        advancing = true;
        render();
        setTimeout(() => window.__funnel.advance(), 280);
      });
    });

    window.__funnel.getSelected = () => (selected ? { program_preference: selected } : null);
    render();
  };

  if ((window as any).__funnel?.session) {
    setup((window as any).__funnel.session);
  } else {
    window.addEventListener('funnel-ready', (e) => setup((e as CustomEvent).detail), { once: true });
  }
</script>
