---
import OfferLayout from '../../layouts/OfferLayout.astro';

const options = [
  { value: 'yes', label: 'Yes' },
  { value: 'no', label: 'No' },
];
---

<OfferLayout
  step={3}
  title="Do you own the underlying land?"
  subtitle="Choose No if you pay lot rent or lease the space your home sits on."
  backHref="/offer/step-3/"
  nextHref="/offer/step-4/"
  autoAdvance={true}
>
  <div class="grid grid-cols-2 gap-5 max-w-[592px] mx-auto max-[640px]:grid-cols-1 max-[640px]:gap-3" role="group" aria-label="Do you own the underlying land?">
    {options.map((opt) => (
      <button type="button" class="offer-card-btn" data-value={opt.value} aria-pressed="false">
        {opt.label}
      </button>
    ))}
  </div>
</OfferLayout>

<script>
  import { routeForLand } from '../../lib/propertyEligibility';

  const setup = (session: { id?: string; home_category?: string | null }) => {
    // Only manufactured and mobile homes get this question.
    if (session.id !== 'preview' && session.home_category !== 'manufactured_mobile') {
      window.location.replace('/offer/step-3/');
      return;
    }

    const funnel = (window as any).__funnel;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.offer-card-btn'));
    const nextBtn = document.getElementById('offer-next') as HTMLButtonElement;
    let selected: string | null = null;
    let advancing = false;

    const render = () => {
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.value === selected ? 'true' : 'false');
        b.disabled = advancing;
      });
      nextBtn.disabled = !selected || advancing;
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        if (advancing) return;
        selected = b.dataset.value!;
        advancing = true;
        render();
        setTimeout(() => funnel.advance(), 280);
      });
    });

    funnel.getSelected = () => (selected ? { owns_land: selected === 'yes' } : null);
    funnel.getRoute = () => (selected ? routeForLand(selected === 'yes') : null);
    render();
  };

  if ((window as any).__funnel?.session) {
    setup((window as any).__funnel.session);
  } else {
    window.addEventListener('funnel-ready', (e) => setup((e as CustomEvent).detail), { once: true });
  }
</script>
