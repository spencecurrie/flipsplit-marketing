---
// Shared shell for the legal pages (Privacy Policy, Terms & Conditions) —
// the 2026-10 reskin's Legal design. Each page passes its own head fields and
// heading; the legal text itself lives in the page and is slotted in as-is.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SocialMeta from '../components/SocialMeta.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';

interface Props {
  /** <title> */
  title: string;
  /** meta description */
  description: string;
  /** visible H1 */
  heading: string;
  /** "Last updated" date, as displayed */
  updated: string;
  /** page path, for the footer's bolded link */
  path: string;
}
const { title, description, heading, updated, path } = Astro.props;

// Canonical URL. Derived from the route and `site` in astro.config.mjs so the
// host and the trailing slash (trailingSlash: 'always') can never drift.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <SocialMeta title={title} description={description} url={canonicalURL} />
  <SiteAnalytics />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <ClientRouter />
</head>
<body class="bg-white text-ink antialiased">

  <Nav />

  <!-- Header -->
  <section id="top" class="pt-16 pb-10 border-b border-line">
    <div class="wrap max-w-[820px]">
      <span class="inline-flex items-center gap-2 h-[30px] px-3 border border-line rounded-full text-[13px] text-muted">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7z"></path><path d="M14 3v4h4"></path></svg>Legal
      </span>
      <h1 class="mt-4 text-[44px] max-[700px]:text-[34px] leading-[1.08] tracking-[-0.04em] font-semibold">{heading}</h1>
      <p class="mt-3 text-[14px] text-muted">Last updated: <span class="font-mono text-[13px] text-ink">{updated}</span></p>
    </div>
  </section>

  <!-- Content -->
  <section class="pt-12 pb-[88px]">
    <div class="wrap max-w-[820px] legal-prose">
      <slot />
    </div>
  </section>

  <Footer current={path} />

  <style is:global>
    .legal-prose h2 { margin: 40px 0 12px; padding-top: 24px; border-top: 1px solid var(--color-hairline); font-size: 20px; line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; color: var(--color-ink); }
    .legal-prose p, .legal-prose li { font-size: 15px; line-height: 1.75; color: var(--color-muted); }
    .legal-prose p { margin: 0 0 12px; }
    .legal-prose strong { color: var(--color-ink); font-weight: 600; }
    .legal-prose ul { margin: 12px 0; padding-left: 22px; list-style: disc; }
    .legal-prose li { margin-bottom: 4px; }
    .legal-prose li::marker { color: var(--color-ink); }
    .legal-prose a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #C4C4BC; }
    .legal-prose a:hover { color: var(--color-muted); }
    /* Contact table at the end of each page */
    .legal-prose .legal-contact { margin-top: 16px; border: 1px solid var(--color-line); border-radius: 14px; overflow: hidden; }
    .legal-prose .legal-contact > div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 18px; font-size: 15px; }
    .legal-prose .legal-contact > div + div { border-top: 1px solid var(--color-hairline); }
    .legal-prose .legal-contact span:first-child { color: var(--color-muted); }
    .legal-prose .legal-contact a, .legal-prose .legal-contact span + span { font-weight: 500; text-align: right; color: var(--color-ink); }
    .legal-prose .legal-contact a { text-decoration: none; }
  </style>
</body>
</html>
