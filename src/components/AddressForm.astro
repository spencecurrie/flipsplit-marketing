---
interface Props {
  id?: string;
  class?: string;
  align?: 'left' | 'center';
  /** When false, hides the ★ 5.0 reviews row + "No obligation…" line below the input. */
  showTrust?: boolean;
  /** 'light' for dark text on light backgrounds (default); 'dark' for light text on dark backgrounds (e.g. hero overlays). */
  theme?: 'light' | 'dark';
  /** When true with align='center', center on mobile only; left-align on desktop (lg+). */
  responsive?: boolean;
}
const { id = 'address-form', class: className = '', align = 'left', showTrust = true, theme = 'light', responsive = false } = Astro.props;
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.flipsplit.com';

// No default for the Maps key, and a hard failure if it's missing: this form
// refuses to submit unless the user picks a Google suggestion (see the submit
// handler below), so without Places the entire lead funnel is dead. A failed
// build is a much better outcome than a deploy where the homepage form silently
// stops accepting addresses.
if (!import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY) {
  throw new Error(
    'PUBLIC_GOOGLE_MAPS_API_KEY is not set. The address form needs it to load ' +
    'Google Places. Set it in .env locally and in the Vercel project settings.',
  );
}
const trustStrong = theme === 'dark' ? 'text-white' : 'text-ink';
const trustSoft   = theme === 'dark' ? 'text-white/80' : 'text-muted';
const trustHint   = theme === 'dark' ? 'text-white/70' : 'text-muted';
const centerOnly  = align === 'center' && !responsive;
const centerResp  = align === 'center' && responsive;
const formCenter  = centerOnly ? 'mx-auto' : centerResp ? 'mx-auto lg:mx-0' : '';
const rowCenter   = centerOnly ? 'justify-center' : centerResp ? 'justify-center lg:justify-start' : '';
const textCenter  = centerOnly ? 'text-center' : centerResp ? 'text-center lg:text-left' : '';
---

<div class={className}>
  <form
    id={id}
    class:list={["address-form flex items-center gap-2 h-[60px] pl-[18px] pr-2 bg-white rounded-xl border w-full max-w-[480px] box-border", theme === 'dark' ? 'border-transparent' : 'border-line-strong', formCenter]}
    novalidate
  >
    <input
      type="text"
      name="address"
      required
      placeholder="Enter your home address..."
      autocomplete="off"
      aria-label="Your home address"
      class="flex-1 min-w-0 border-0 bg-transparent text-ink text-[16px] focus:outline-none placeholder:text-faint"
    />
    <button
      type="submit"
      aria-label="Get my offer"
      class="address-submit shrink-0 w-11 h-11 rounded-[9px] bg-ink text-white flex items-center justify-center transition-colors hover:bg-black disabled:opacity-60 disabled:cursor-wait"
    >
      <svg class="address-arrow w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
      </svg>
      <svg class="address-spinner hidden w-[18px] h-[18px] animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"/>
        <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </button>
  </form>

  <p class:list={["address-error hidden mt-2 text-xs font-medium", theme === 'dark' ? 'text-white' : 'text-danger', textCenter]}></p>

  <!-- Address-confirmation modal (one per AddressForm instance, hidden by default).
       Has two states: the default "confirm + unit number" form, and a
       "soft-block" state shown when the address is already on FlipSplit for a
       real account. The block state surfaces a sign-in CTA instead of letting
       the visitor start a duplicate funnel. -->
  <div class="address-modal hidden fixed inset-0 z-[100] flex items-center justify-center px-4 py-8" style="background: rgba(15, 23, 42, 0.55);">
    <div class="bg-white rounded-[20px] shadow-2xl w-full max-w-md p-8 relative" role="dialog" aria-modal="true" aria-labelledby={`${id}-modal-title`}>
      <button type="button" class="address-modal-close absolute top-5 right-5 p-1 text-[#121212] hover:text-[#121212] transition-colors" aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <!-- Default state: "is this your address?" -->
      <div class="address-modal-state-default">
        <h2 id={`${id}-modal-title`} class="text-2xl font-semibold mb-6 pr-8" style="color:#121212; font-family:var(--font-sans);letter-spacing:-0.02em;">
          Is this the correct home address?
        </h2>

        <div class="rounded-2xl p-4 flex items-start justify-between gap-3 mb-6" style="background:#f4f4f1;">
          <p class="address-modal-address text-sm font-medium leading-relaxed flex-1" style="color:#121212; white-space: pre-line;"></p>
          <button type="button" class="address-modal-edit text-sm font-semibold shrink-0 hover:opacity-80 transition-opacity" style="color:#121212;">Edit</button>
        </div>

        <label class="block">
          <span class="text-sm font-semibold text-[#121212]">Unit, Apt, or Suite # <span class="text-[#121212] font-normal">(optional)</span></span>
          <input
            type="text"
            class="address-modal-unit mt-2 w-full border border-[#e6e6e1] rounded-xl px-4 py-3 text-sm text-[#121212] focus:outline-none focus:border-[#121212] transition-colors"
            placeholder="e.g. 30, 4B, Suite C"
            autocomplete="off"
            maxlength="20"
          />
        </label>
        <p class="text-xs text-[#121212] mt-2">Leave blank if your home is single-family.</p>

        <button
          type="button"
          class="address-modal-confirm w-full mt-6 text-white font-bold py-3.5 rounded-xl text-sm transition-all hover:brightness-110 disabled:opacity-60 disabled:cursor-wait"
          style="background:#121212;"
        >
          <span class="address-modal-confirm-label">Confirm address</span>
        </button>
        <p class="address-modal-error hidden text-sm text-red-500 font-medium mt-3 text-center"></p>
      </div>

      <!-- Soft-block state: address already belongs to a real account -->
      <div class="address-modal-state-blocked hidden">
        <h2 class="address-modal-blocked-title text-2xl font-semibold mb-3 pr-8" style="color:#121212; font-family:var(--font-sans);letter-spacing:-0.02em;">
          Looks like this home is already on FlipSplit
        </h2>
        <p class="address-modal-blocked-body text-sm text-[#121212] leading-relaxed mb-5">
          You've already started selling this property. Sign in to pick up where you left off.
        </p>

        <div class="rounded-2xl p-4 mb-6" style="background:#f4f4f1;">
          <p class="address-modal-blocked-address text-sm font-medium leading-relaxed" style="color:#121212; white-space: pre-line;"></p>
        </div>

        <a
          href={`${APP_URL}/login`}
          class="address-modal-signin block w-full text-center text-white font-bold py-3.5 rounded-xl text-sm transition-all hover:brightness-110"
          style="background:#121212;"
        >
          Sign in
        </a>
        <button
          type="button"
          class="address-modal-different w-full mt-3 text-sm font-semibold text-[#121212] hover:text-[#121212] py-2 transition-colors"
        >
          Use a different address
        </button>
        <a
          href="mailto:info@flipsplit.com?subject=I'm the new owner of a FlipSplit-listed property"
          class="address-modal-contact block text-center text-xs text-[#121212] hover:text-[#121212] mt-2 transition-colors"
        >
          Not the current owner? Contact us
        </a>
      </div>
    </div>
  </div>

  <!-- Full-screen "looking up your property" overlay. Shown for ~1.5s after the
       address is confirmed so the jump from modal → step 1 has a perceived-
       loading beat. The eager RentCast lookup is already in flight by this
       point, so this is purely UX pacing. -->
  <div class="address-loading-overlay hidden fixed inset-0 z-[150] flex-col items-center justify-center bg-white">
    <div class="progress-bar w-full absolute top-0 left-0" style="height: 4px; background: #121212;"></div>
    <div class="address-loading-spinner mb-8" aria-hidden="true"></div>
    <h1 class="text-3xl md:text-4xl font-semibold mb-3 px-6 text-center" style="color:#121212; font-family:var(--font-sans);letter-spacing:-0.02em;">Looking up your property…</h1>
    <p class="text-base md:text-lg text-[#121212] max-w-md text-center px-6">Pulling public records so we can pre-fill what we know about your home.</p>
  </div>

  {showTrust && (
    <Fragment>
      <div class={`mt-3.5 flex flex-wrap items-center gap-2 text-[13px] ${rowCenter}`}>
        <span class={`inline-flex gap-0.5 ${trustStrong}`} role="img" aria-label="5 out of 5 stars">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 6.6 7.2.7-5.4 4.8 1.6 7.1L12 17.5 5.6 21.2l1.6-7.1L1.8 9.3 9 8.6z"/></svg>
          ))}
        </span>
        <span class={`font-semibold ${trustStrong}`}>5.0</span>
        <span class={trustSoft}>Verified reviews on <strong class={trustStrong}>REVIEWS.IO</strong></span>
      </div>
      <p class={`mt-1.5 text-[12px] ${trustHint} ${textCenter}`}>No obligation · No repairs needed · Results in 24–48 hours</p>
    </Fragment>
  )}
</div>

<style is:global>
  .pac-container {
    border-radius: 12px;
    border: 1px solid #e6e6e1;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    font-family: var(--font-sans);
    margin-top: 4px;
    overflow: hidden;
  }
  .pac-item {
    padding: 10px 14px;
    font-size: 13px;
    color: #121212;
    cursor: pointer;
    border-top: 1px solid #f4f4f1;
  }
  .pac-item:first-child { border-top: none; }
  .pac-item:hover, .pac-item-selected { background: #fafaf8; }
  .pac-icon { display: none; }
  .pac-item-query { font-weight: 600; color: #121212; }
  .pac-matched { color: #121212; }

  /* Loading overlay (full-screen, shown briefly after address confirmation) */
  .address-loading-overlay { font-family: var(--font-sans); }
  .address-loading-overlay:not(.hidden) { display: flex; }
  .address-loading-spinner {
    width: 56px; height: 56px; border-radius: 50%;
    border: 4px solid #e6e6e1; border-top-color: #121212;
    animation: address-loading-spin 0.85s linear infinite;
  }
  @keyframes address-loading-spin { to { transform: rotate(360deg); } }
</style>

<script>
  import { getSupabase } from '../lib/supabase';
  import { FUNNEL_SESSION_KEY, resumeHref, cacheFunnelRow } from '../lib/funnelSession';
  import { readAttribution } from '../lib/attribution';

  // Frontmatter runs at build time on the server — its consts do NOT exist in
  // this bundle. Two lines below referenced the frontmatter's APP_URL and threw
  // ReferenceError at runtime: the "already on FlipSplit" sign-in link and the
  // returning-owner deep link into the app. Read it from the environment here,
  // the same way Nav.astro does; finish.astro solves it with a <meta> tag.
  const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.flipsplit.com';

  declare global {
    interface Window {
      __placesReady?: boolean;
      __placesQueue?: (() => void)[];
      __onPlacesReady?: () => void;
    }
  }

  // ── Helper: parse address components from a Google Places result ────────
  function parseAddressParts(place: google.maps.places.PlaceResult) {
    const parts: { street?: string; city?: string; state?: string; zip?: string; county?: string } = {};
    const components = place.address_components || [];
    let streetNumber = '';
    let route = '';

    for (const c of components) {
      if (c.types.includes('street_number')) streetNumber = c.long_name;
      else if (c.types.includes('route')) route = c.long_name;
      else if (c.types.includes('locality')) parts.city = c.long_name;
      else if (c.types.includes('administrative_area_level_1')) parts.state = c.short_name;
      else if (c.types.includes('postal_code')) parts.zip = c.long_name;
      // County — what decides which rep owns the lead. Stored verbatim as
      // Google gives it ("Orange County"); the stripping rules live server-side
      // in _shared/territories.ts, because RentCast reports the same county as
      // "Orange" and the two have to be reconciled somewhere central.
      else if (c.types.includes('administrative_area_level_2')) parts.county = c.long_name;
    }
    if (streetNumber || route) parts.street = `${streetNumber} ${route}`.trim();
    return parts;
  }

  // ── Form lifecycle ──────────────────────────────────────────────────────
  function attachAutocomplete() {
    // Only this component's own inputs: each needs the sibling modal below. A
    // bare input[name="address"] elsewhere (the nav box) used to be bound too,
    // and a pick there created a lead row and a paid lookup with nothing shown.
    document.querySelectorAll<HTMLInputElement>('form.address-form input[name="address"]').forEach((input) => {
      if (input.dataset.placesInit) return;
      input.dataset.placesInit = '1';

      let pickedPlace: google.maps.places.PlaceResult | null = null;

      // Background work for the "new address" path only: auth + row insert +
      // RentCast lookup all start while the user is reading the confirmation
      // modal, so by the time they click Confirm the data is usually ready.
      // For existing/soft-block addresses we never set bgWork — those branches
      // either redirect or surface a sign-in prompt without a session row.
      let bgWork: { promise: Promise<FunnelRow>; address: string } | null = null;

      // Self-healing auth bootstrap. Reads existing session; falls back to a
      // fresh anonymous sign-in if the stored JWT points to a deleted user.
      async function ensureUser(): Promise<{ id: string; anonymous: boolean }> {
        const supabase = getSupabase();
        const { data: existing, error: getUserErr } = await supabase.auth.getUser();
        if (existing?.user?.id && !getUserErr) {
          return { id: existing.user.id, anonymous: !!existing.user.is_anonymous };
        }
        try { await supabase.auth.signOut(); } catch { /* ignore */ }
        const { data: signin, error: authErr } = await supabase.auth.signInAnonymously();
        // These messages only reach the console; the modal shows a friendly line.
        if (authErr) throw new Error(`Anonymous sign-in failed: ${authErr.message}`);
        const userId = signin?.user?.id;
        if (!userId) throw new Error('Anonymous sign-in returned no user.');
        return { id: userId, anonymous: true };
      }

      // Kicked off at place-picked. Auth → a signed-in account's unfinished run
      // for the same address if there is one (resumed where they left off),
      // else a new qualification_sessions row → lookup-property (non-awaited; cached
      // server-side if this home was already looked up). Resolves with the row.
      // `lookup` settles when lookup-property answers: done, cached, or
      // { pending } when another call already holds the lookup.
      type FunnelRow = { id: string; step: number; unit: string | null; lookup: Promise<any> };
      async function startEagerLookup(place: google.maps.places.PlaceResult): Promise<FunnelRow> {
        const supabase = getSupabase();
        const { id: userId, anonymous } = await ensureUser();
        // Only real accounts resume a draft. A signed-out visitor still carries
        // an anonymous login in this browser; re-entering an address they
        // abandoned starts over at step 1 rather than dropping them mid-funnel.
        const { data: draft } = anonymous ? { data: null } : await supabase
          .from('qualification_sessions')
          .select('id, current_step, unit_number')
          .eq('user_id', userId)
          .eq('status', 'in_progress')
          .eq('address', place.formatted_address!)
          .order('created_at', { ascending: false })
          .limit(1)
          .maybeSingle();
        let row: FunnelRow;
        if (draft) {
          row = { id: draft.id, step: draft.current_step ?? 0, unit: draft.unit_number ?? null, lookup: Promise.resolve() };
        } else {
          const parts = parseAddressParts(place);
          const { data: inserted, error: insertErr } = await supabase
            .from('qualification_sessions')
            .insert({
              user_id: userId,
              address: place.formatted_address!,
              street: parts.street,
              city: parts.city,
              state: parts.state,
              zip: parts.zip,
              county: parts.county,
              current_step: 0,
              // Where this visit came from (utm_*, gclid, landing page) —
              // stamped at creation so the CRM can say "Google Ads". See
              // lib/attribution.ts and migration 0073.
              ...readAttribution(),
            })
            .select('id')
            .single();
          if (insertErr) throw insertErr;
          row = { id: inserted.id, step: 0, unit: null, lookup: Promise.resolve() };
        }
        // The funnel pages work on THIS row, not "the newest unfinished one".
        try { localStorage.setItem(FUNNEL_SESSION_KEY, row.id); } catch { /* private mode */ }
        // Fire the property lookup immediately — not awaited here, runs
        // server-side while the user reads the modal. Confirm waits on it.
        row.lookup = supabase.functions
          .invoke('lookup-property', { body: { session_id: row.id } })
          .catch((e: any) => console.warn('lookup-property invoke failed:', e));
        return row;
      }

      const ac = new (window as any).google.maps.places.Autocomplete(input, {
        types: ['address'],
        componentRestrictions: { country: 'us' },
        fields: ['formatted_address', 'address_components'],
      });

      const form = input.closest('form');
      if (!form) return;
      const wrap = form.parentElement; // outer <div class={className}>
      if (!wrap) return;

      // Modal elements (each AddressForm instance has its own sibling modal)
      const modal       = wrap.querySelector<HTMLElement>('.address-modal');
      const modalAddr   = wrap.querySelector<HTMLElement>('.address-modal-address');
      const modalUnit   = wrap.querySelector<HTMLInputElement>('.address-modal-unit');
      const modalConfirm= wrap.querySelector<HTMLButtonElement>('.address-modal-confirm');
      const modalLabel  = wrap.querySelector<HTMLElement>('.address-modal-confirm-label');
      const modalClose  = wrap.querySelector<HTMLButtonElement>('.address-modal-close');
      const modalEdit   = wrap.querySelector<HTMLButtonElement>('.address-modal-edit');
      const modalError  = wrap.querySelector<HTMLElement>('.address-modal-error');

      const stateDefault = wrap.querySelector<HTMLElement>('.address-modal-state-default');
      const stateBlocked = wrap.querySelector<HTMLElement>('.address-modal-state-blocked');
      const blockedAddr  = wrap.querySelector<HTMLElement>('.address-modal-blocked-address');
      const useDifferent = wrap.querySelector<HTMLButtonElement>('.address-modal-different');

      function showModalDefault(place: google.maps.places.PlaceResult) {
        if (modalAddr) modalAddr.textContent = place.formatted_address || '';
        if (modalUnit) modalUnit.value = '';
        if (modalError) modalError.classList.add('hidden');
        stateDefault?.classList.remove('hidden');
        stateBlocked?.classList.add('hidden');
      }
      // Two variants of the same panel. Someone else's home: sign in (it may be
      // yours under another account) or contact us. Your own finished home:
      // say so and point at the account menu — entering an address never opens
      // the app; the account menu is the only way into a property.
      const blockedTitle = wrap.querySelector<HTMLElement>('.address-modal-blocked-title');
      const blockedBody  = wrap.querySelector<HTMLElement>('.address-modal-blocked-body');
      const blockedContact = wrap.querySelector<HTMLElement>('.address-modal-contact');
      const BLOCKED_COPY = {
        other: ['Looks like this home is already on FlipSplit',
                "You've already started selling this property. Sign in to pick up where you left off."],
        owner: ['This home is already on your account',
                'You already have an offer for this property. Open it any time from your account menu at the top right.'],
      };
      function showModalBlocked(place: google.maps.places.PlaceResult, owner = false, unit: string | null = null) {
        const [title, body] = BLOCKED_COPY[owner ? 'owner' : 'other'];
        if (blockedTitle) blockedTitle.textContent = title;
        if (blockedBody) blockedBody.textContent = body;
        wrap?.querySelector<HTMLElement>('.address-modal-signin')?.classList.toggle('hidden', owner);
        blockedContact?.classList.toggle('hidden', owner);
        if (blockedAddr) blockedAddr.textContent = (place.formatted_address || '') + (unit ? `\nUnit ${unit}` : '');
        // Carry the address through to the app's /login so that after sign-in
        // the dashboard can resolve it to *this user's* matching session
        // (instead of silently defaulting to their most-recent property).
        // The app validates ownership; non-owners will see an interstitial.
        const signInLink = wrap?.querySelector<HTMLAnchorElement>('.address-modal-signin');
        if (signInLink && place.formatted_address) {
          signInLink.href = `${APP_URL}/login?address=${encodeURIComponent(place.formatted_address)}`;
        }
        stateBlocked?.classList.remove('hidden');
        stateDefault?.classList.add('hidden');
      }

      function openModal(place: google.maps.places.PlaceResult) {
        if (!modal) return;
        showModalDefault(place);
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(() => modalUnit?.focus(), 50);
      }
      function closeModal() {
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
      }

      // "Use a different address" inside the soft-block state — close, clear,
      // and put the cursor back in the input so the user can pick another.
      useDifferent?.addEventListener('click', () => {
        closeModal();
        input.value = '';
        pickedPlace = null;
        bgWork = null;
        setTimeout(() => input.focus(), 50);
      });

      // When the user picks an address, run the "already on FlipSplit?" check
      // BEFORE opening any modal — and show a spinner on the form's submit
      // button while we wait. Opening the modal in its final state (rather
      // than opening it in the default state and flipping content ~100ms
      // later) avoids the jarring "modal swap" effect.
      const submitBtn = form.querySelector<HTMLButtonElement>('.address-submit');
      const submitArrow = submitBtn?.querySelector<HTMLElement>('.address-arrow');
      const submitSpin  = submitBtn?.querySelector<HTMLElement>('.address-spinner');
      const setChecking = (busy: boolean) => {
        if (submitBtn) submitBtn.disabled = busy;
        if (busy) { submitArrow?.classList.add('hidden'); submitSpin?.classList.remove('hidden'); }
        else      { submitArrow?.classList.remove('hidden'); submitSpin?.classList.add('hidden'); }
      };

      async function handlePlacePicked(place: google.maps.places.PlaceResult) {
        if (!place?.formatted_address) return;
        input.value = place.formatted_address;
        input.setCustomValidity('');

        // Only a house we could buy goes any further: every address that
        // passes starts a paid property lookup. Google's suggestions include
        // other states, whole streets and highways.
        const errorEl = wrap.querySelector<HTMLElement>('.address-error');
        const parts = parseAddressParts(place);
        const hasNumber = (place.address_components || []).some((c) => c.types.includes('street_number'));
        const problem = parts.state !== 'CA'
          ? 'FlipSplit only buys homes in Southern California right now.'
          : !hasNumber
            ? 'Please choose a home address with a house number.'
            : null;
        if (problem) {
          pickedPlace = null;
          if (errorEl) { errorEl.textContent = problem; errorEl.classList.remove('hidden'); }
          return;
        }
        errorEl?.classList.add('hidden');
        pickedPlace = place;

        setChecking(true);
        const supabase = getSupabase();
        let status: { exists?: boolean; is_owner?: boolean; session_id?: string } | null = null;
        try {
          const { data, error } = await supabase.rpc('check_address_status', {
            p_address: place.formatted_address,
          });
          if (error) console.warn('check_address_status failed:', error.message);
          else status = data as any;
        } catch (e) {
          console.warn('check_address_status threw:', e);
        }
        setChecking(false);

        // Guard: if the user picked a different place while we waited, the
        // result we have is stale — discard it.
        if (pickedPlace !== place) return;

        // A finished home (no unit — unit homes are checked on Confirm, once
        // the unit is known). Never jump into the app from here: tell them it's
        // theirs (or someone else's) and leave the rest to them.
        if (status?.exists) {
          if (!modal) return;
          showModalBlocked(place, !!status.is_owner);
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          return;
        }

        // New address → open modal in default state and start the eager
        // RentCast lookup in the background so step 1 has data ready.
        openModal(place);
        if (!bgWork || bgWork.address !== place.formatted_address) {
          bgWork = {
            address: place.formatted_address,
            promise: startEagerLookup(place),
          };
          bgWork.promise.catch(() => { bgWork = null; });
        }
      }

      ac.addListener('place_changed', () => {
        const place = ac.getPlace();
        if (place?.formatted_address) handlePlacePicked(place);
      });

      input.addEventListener('input', () => {
        pickedPlace = null;
        bgWork = null; // user is typing a new query — abandon prior work
        input.setCustomValidity(
          input.value.trim() ? 'Please select an address from the dropdown suggestions.' : ''
        );
      });

      // Close modal — keeps the address in the input field AND keeps bgWork
      // so a re-open from the same address doesn't redo the lookup.
      modalClose?.addEventListener('click', closeModal);
      // Edit — close + clear so user can search again.
      modalEdit?.addEventListener('click', () => {
        closeModal();
        input.value = '';
        pickedPlace = null;
        bgWork = null; // explicit address change — drop the in-flight work
        setTimeout(() => input.focus(), 50);
      });
      // Esc + backdrop close
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
      });

      // Submit button — if a place is picked, run it back through the same
      // decision path (which re-checks the address and opens the right modal
      // state, or redirects). If no place was picked, show the usual error.
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const errorEl = wrap.querySelector<HTMLElement>('.address-error');
        const showError = (msg: string) => {
          if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
        };
        errorEl?.classList.add('hidden');
        if (!input.value.trim()) return showError('Please enter your property address.');
        if (!pickedPlace) {
          // A pick the check above turned down keeps its own message showing.
          if (errorEl && !errorEl.classList.contains('hidden') && errorEl.textContent) return;
          return showError('Please select an address from the dropdown suggestions.');
        }
        handlePlacePicked(pickedPlace);
      });

      // Confirm — by now the background lookup has either finished or is well
      // along. Wait for the session id, add unit_number if provided, then nav.
      modalConfirm?.addEventListener('click', async () => {
        if (!pickedPlace) return;
        const unitNumber = (modalUnit?.value || '').trim() || null;

        modalConfirm.setAttribute('disabled', 'true');
        if (modalLabel) modalLabel.textContent = 'Confirming…';
        if (modalError) modalError.classList.add('hidden');

        try {
          // The Confirm button is only visible when handlePlacePicked decided
          // the address is *new* — soft-block and existing-owner cases never
          // show this button. So bgWork should be set. Defensive fallback:
          // if it isn't (rare paste-then-confirm edge case), kick it off now.
          if (!bgWork) {
            bgWork = {
              address: pickedPlace.formatted_address!,
              promise: startEagerLookup(pickedPlace),
            };
          }

          const { id: sessionId, step: resumeStep, unit: draftUnit, lookup: firstLookup } = await bgWork.promise;
          let lookup = firstLookup;
          const supabase = getSupabase();

          // A unit makes it a different home, so the "already on FlipSplit"
          // check runs again now that we know it (the pick-time check only
          // covered unit-less homes).
          if (unitNumber) {
            const { data: unitStatus } = await supabase.rpc('check_address_status', {
              p_address: pickedPlace.formatted_address, p_unit: unitNumber,
            });
            if ((unitStatus as any)?.exists) {
              showModalBlocked(pickedPlace, !!(unitStatus as any).is_owner, unitNumber);
              modalConfirm.removeAttribute('disabled');
              if (modalLabel) modalLabel.textContent = 'Confirm address';
              return;
            }
          }

          // If the user typed a (different) unit number, update the row and
          // re-invoke the lookup so it can fetch with the unit-aware address.
          if (unitNumber && unitNumber !== draftUnit) {
            await supabase
              .from('qualification_sessions')
              .update({ unit_number: unitNumber })
              .eq('id', sessionId);
            lookup = supabase.functions
              .invoke('lookup-property', { body: { session_id: sessionId } })
              .catch((e: any) => console.warn('re-lookup-property invoke failed:', e));
          }

          // funnel_started analytics event (fire and forget).
          const { data: { user: authedUser } } = await supabase.auth.getUser();
          supabase.from('events')
            .insert({
              session_id: sessionId,
              user_id: authedUser?.id,
              event_name: 'funnel_started',
              payload: { address: pickedPlace.formatted_address, unit_number: unitNumber },
            })
            .then((res: any) => { if (res?.error) console.warn('funnel_started event failed:', res.error); });

          // Hide the modal and hold a full-screen loading overlay until the
          // property lookup has landed, so the details step opens already
          // filled in instead of values popping into the dropdowns while the
          // homeowner is picking them. Timed by the data alone, capped at
          // ~15s: past that, step 2's own wait-and-retry takes over.
          closeModal();
          const overlay = wrap.querySelector<HTMLElement>('.address-loading-overlay');
          if (overlay) {
            overlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
          const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
          const lookupLanded = async () => {
            const res: any = await lookup;
            if (!res?.data?.pending) return;
            // Another call holds the lookup: watch for its finished stamp.
            for (let i = 0; i < 20; i++) {
              await sleep(700);
              const { data: row } = await supabase
                .from('qualification_sessions')
                .select('rentcast_property_fetched_at')
                .eq('id', sessionId)
                .maybeSingle();
              if (row?.rentcast_property_fetched_at) return;
            }
          };
          await Promise.race([lookupLanded().catch(() => {}), sleep(15000)]);

          // Hand the first step the finished row so it paints filled instead
          // of reading it again (step 2's dropdowns used to show up blank).
          const { data: fullRow } = await supabase
            .from('qualification_sessions').select('*').eq('id', sessionId).maybeSingle();
          cacheFunnelRow(fullRow);

          // Off to step 1 as a full page load, never a client-side swap: the
          // funnel layout's script must run fresh against this new session
          // (see the note in OfferLayout.astro).
          // A resumed draft picks up after its last answered step.
          window.location.assign(resumeHref(resumeStep));
        } catch (err: any) {
          console.error('Funnel start failed:', err);
          if (modalError) {
            modalError.textContent = 'Something went wrong on our end. Please try again, or email us at info@flipsplit.com.';
            modalError.classList.remove('hidden');
          }
          modalConfirm.removeAttribute('disabled');
          if (modalLabel) modalLabel.textContent = 'Confirm address';
          // Drop the failed bgWork so next click retries fresh.
          bgWork = null;
        }
      });
    });
  }

  // Lazy-load Google Places (once per session), then initialize all forms
  // currently on the page. Safe to call repeatedly: if Places is already
  // loaded it wires up forms immediately; otherwise it queues until the
  // script's callback fires. The per-input `dataset.placesInit` guard inside
  // attachAutocomplete() prevents any input from being wired up twice.
  function bootPlaces() {
    if ((window as any).google?.maps?.places) {
      attachAutocomplete();
      return;
    }
    window.__placesQueue = window.__placesQueue || [];
    window.__placesQueue.push(attachAutocomplete);
    if (!document.getElementById('gplaces-script')) {
      window.__onPlacesReady = () => {
        window.__placesReady = true;
        const queue = window.__placesQueue || [];
        window.__placesQueue = []; // clear so later page-loads don't re-run stale entries
        queue.forEach((fn) => fn());
      };
      const s = document.createElement('script');
      s.id = 'gplaces-script';
      // PUBLIC_ vars are inlined into client scripts by Vite at build time.
      // Shared with flipsplit-app, which reads the same key from
      // VITE_GOOGLE_MAPS_API_KEY. It's referrer-restricted to both Vercel
      // domains plus localhost, so it's public by design — the reason to keep
      // it in config is that rotating it shouldn't be a code change.
      const key = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
      s.src = `https://maps.googleapis.com/maps/api/js?key=${key}&libraries=places&callback=__onPlacesReady`;
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }
  }

  // /?address=<text> (the nav box on a page with no form of its own): put the
  // text in the first form and focus it, so the visitor picks a suggestion
  // there. Never submitted from the URL — a Places pick is still required.
  function prefillFromQuery() {
    const params = new URLSearchParams(window.location.search);
    const text = params.get('address');
    if (text === null) return;
    const input = document.querySelector<HTMLInputElement>('form.address-form input[name="address"]');
    if (!input) return;
    params.delete('address');
    const qs = params.toString();
    history.replaceState(history.state, '', window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash);
    input.value = text.trim();
    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
    input.focus({ preventScroll: true });
    // Lets Places offer suggestions for the carried-over text.
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }

  bootPlaces();
  prefillFromQuery();
  // Re-run after Astro view transitions (e.g. user navigates from /about back
  // to / where another AddressForm renders). With <ClientRouter /> the page's
  // <script> modules execute only ONCE per session — on a client-side
  // navigation the DOM is swapped in with brand-new address inputs but this
  // module is NOT re-run. astro:page-load fires after every navigation
  // (including the initial load), so re-wiring autocomplete here is what makes
  // the Google dropdown work without a hard refresh.
  document.addEventListener('astro:page-load', () => {
    bootPlaces();
    prefillFromQuery();
  });
</script>
