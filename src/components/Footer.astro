---
// Shared site-wide footer. Drop in via <Footer /> on any page.
// Funnel pages (under /offer/*) keep their own minimal footer.
// Pass `current` (the page's path) to bold its own link, as the design does.
interface Props { current?: string }
const { current = '' } = Astro.props;

const columns = [
  { title: 'Sell', links: [
    { href: '/how-it-works/', label: 'How FlipSplit Works' },
    { href: '/request-offer/', label: 'Request an Offer' },
    { href: '/sell-my-home-fast/', label: 'Sell My Home Fast' },
  ] },
  { title: 'Where we buy', links: [
    { href: '/location-la-county/', label: 'Los Angeles County' },
    { href: '/location-orange-county/', label: 'Orange County' },
    { href: '/location-san-diego-county/', label: 'San Diego County' },
    { href: '/location-riverside-county/', label: 'Riverside County' },
    { href: '/location-san-bernardino-county/', label: 'San Bernardino County' },
    { href: '/location-long-beach/', label: 'Long Beach' },
    { href: '/location-anaheim/', label: 'Anaheim' },
  ] },
  { title: 'Company', links: [
    { href: '/about/', label: 'About' },
    { href: '/reviews/', label: 'Reviews' },
    { href: '/faq/', label: 'FAQ' },
    { href: '/blog/', label: 'Blog' },
    { href: '/sign-in/', label: 'Sign in' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy-policy/', label: 'Privacy Policy' },
    { href: '/terms-and-conditions/', label: 'Terms & Conditions' },
    { href: 'mailto:hello@flipsplit.com', label: 'Contact' },
  ] },
];
---

<footer class="border-t border-line bg-white pt-14 pb-9 text-ink">
  <div class="wrap-wide">
    <div class="grid grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-8 max-[1000px]:grid-cols-3 max-[700px]:grid-cols-2">
      <div class="max-[1000px]:col-span-3 max-[700px]:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 text-ink no-underline">
          <img src="/logo-mark.png" alt="" width="30" height="30" class="block w-[30px] h-[30px] object-contain" />
          <span class="text-[17px] font-semibold tracking-[-0.02em]">FlipSplit</span>
        </a>
        <p class="mt-3.5 text-[14px] leading-[1.6] text-muted max-w-[300px]">
          The first cash offer that doesn't make you choose. Sell as-is for cash today and share the upside when your home sells for more.
        </p>
      </div>

      {columns.map((col) => (
        <div class="flex flex-col gap-2.5 text-[14px]">
          <span class="text-muted">{col.title}</span>
          {col.links.map((l) => (
            <a
              href={l.href}
              aria-current={current === l.href ? 'page' : undefined}
              class:list={['text-ink no-underline hover:text-muted transition-colors', current === l.href && 'font-semibold']}
            >{l.label}</a>
          ))}
        </div>
      ))}
    </div>

    <div class="mt-11 pt-5 border-t border-hairline text-[13px] text-muted">
      © 2026 FlipSplit LLC. All rights reserved.
    </div>
  </div>
</footer>
