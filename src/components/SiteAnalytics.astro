---
import Analytics from '@vercel/analytics/astro';
// Vercel Web Analytics, path only. Funnel URLs carry ?claim= and ?session=
// tokens, so the query string and hash are dropped before anything is sent.
//
// Google Ads tag: loaded only when PUBLIC_GOOGLE_ADS_ID (AW-…) is set, i.e.
// production. On an ad click it reads ?gclid= and sets Google's click cookie
// on .flipsplit.com, which the dashboard's lead conversion (flipsplit-app
// src/lib/googleAds.js) reads back on app.flipsplit.com.
const adsId = /^AW-\d+$/.test(import.meta.env.PUBLIC_GOOGLE_ADS_ID ?? '') ? import.meta.env.PUBLIC_GOOGLE_ADS_ID : null;
---
<script is:inline>window.webAnalyticsBeforeSend = (e) => ({ ...e, url: e.url.split(/[?#]/)[0] });</script>
<Analytics />
{adsId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${adsId}`}></script>
    <script is:inline define:vars={{ adsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', adsId);
    </script>
  </>
)}
<!-- Lead attribution: remember how this visit started so the address form can
     stamp it on the lead row. Contract (key, fields, 90-day window) lives in
     src/lib/attribution.ts; keep the two in step. Inline so it runs on every
     page, including the ones with no client bundle. -->
<script is:inline>
  (function () {
    try {
      var KEY = 'flipsplit:attribution';
      var MAX_AGE = 90 * 24 * 60 * 60 * 1000;
      var p = new URLSearchParams(location.search);
      var clip = function (v, n) { return v ? String(v).slice(0, n) : null; };
      var click = {};
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
        var v = clip(p.get(k), 200); if (v) click[k] = v;
      });
      // gbraid/wbraid are Google's consent-mode stand-ins for gclid.
      var gclid = clip(p.get('gclid') || p.get('gbraid') || p.get('wbraid'), 200);
      if (gclid) click.gclid = gclid;
      var hasClick = Object.keys(click).length > 0;

      var prev = null;
      try { prev = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
      if (prev && !(Date.now() - Date.parse(prev.attribution_captured_at || '') < MAX_AGE)) prev = null;
      if (!hasClick && prev) return;

      // Our own pages linking to each other are not a source.
      var ref = document.referrer || '';
      if (ref.indexOf(location.origin + '/') === 0 || ref === location.origin) ref = '';

      click.landing_page = clip(location.origin + location.pathname + location.search, 1000);
      click.referrer = clip(ref, 1000);
      click.attribution_captured_at = new Date().toISOString();
      localStorage.setItem(KEY, JSON.stringify(click));
    } catch (e) { /* storage blocked — the lead is simply unattributed */ }
  })();
</script>
