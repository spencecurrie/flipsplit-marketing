---
import TapFeedback from './TapFeedback.astro';
import ProfileMenu from './ProfileMenu.astro';
interface Props {
  variant?: 'solid' | 'transparent';
}
const { variant = 'solid' } = Astro.props;
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.flipsplit.com';
---

<style is:global>
  /* ── Top-of-page navigation progress bar (Astro View Transitions) ── */
  #nav-progress-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
    transform-origin: 0 50%;
    transform: scaleX(0);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.2s ease;
    background: linear-gradient(90deg, #1f1f1f 0%, #3a3a37 100%);
    box-shadow: 0 0 6px rgba(31,31,31,0.45);
  }
  #nav-progress-bar.is-loading {
    opacity: 1;
    transform: scaleX(0.7);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.15s ease;
  }
  #nav-progress-bar.is-done {
    opacity: 1;
    transform: scaleX(1);
    transition: transform 0.18s ease-out, opacity 0.3s ease 0.15s;
  }
  #nav-progress-bar.is-done.is-fade {
    opacity: 0;
  }

  /* Slightly slower default fade between pages so navigation feels intentional */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 320ms;
  }
</style>
<style>
  .nav-btn { background: #1f1f1f; color: #fff; font-weight: 700; font-size: 0.875rem; padding: 0.625rem 1.25rem; border-radius: 8px; transition: filter 0.15s; white-space: nowrap; }
  .nav-btn:hover { filter: brightness(1.08); }
  .nav-dropdown-wrap { position: relative; }
  .nav-dropdown { position: absolute; top: calc(100% + 12px); left: 0; width: 14rem; border-radius: 12px; overflow: hidden; opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0.2s; z-index: 60; background: #1f1f1f; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 16px 40px rgba(0,0,0,0.2); }
  .nav-dropdown-wrap:hover .nav-dropdown,
  .nav-dropdown-wrap:focus-within .nav-dropdown { opacity: 1; visibility: visible; }
  .nav-chevron { transition: transform 0.2s; display: inline-block; }
  .nav-dropdown-wrap:hover .nav-chevron { transform: rotate(180deg); }
  .nav-drop-item { display: block; padding: 0.75rem 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.8); transition: background 0.15s, color 0.15s; border-top: 1px solid rgba(255,255,255,0.08); }
  .nav-drop-item:first-child { border-top: none; }
  .nav-drop-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .mobile-dropdown > summary { list-style: none; cursor: pointer; }
  .mobile-dropdown > summary::-webkit-details-marker { display: none; }
  .mobile-dropdown[open] .mobile-chevron { transform: rotate(90deg); }
  .mobile-chevron { transition: transform 0.2s; }

  /* ── Light-theme override for the scrolled-mobile state (both nav variants) ── */
  .nav-light { border-bottom: 1px solid #e6e6e2; }
  .nav-light .field {
    background: #f4f4f0 !important;
    border: 1px solid #e6e6e2 !important;
  }
  .nav-light .field input { color: #1f1f1f !important; }
  .nav-light .field input::placeholder { color: #8a8a83 !important; }
  .nav-light .submit-icon {
    background: #1f1f1f !important;
    color: #fff !important;
  }
  .nav-light #t-signin-link,
  .nav-light #s-signin-link {
    display: inline-block !important;
    color: #1f1f1f !important;
    font-size: 0.875rem !important;
  }
  .nav-light #menu-toggle,
  .nav-light #solid-menu-toggle { color: #1f1f1f !important; }

  /* ── Mobile menu: slide in from the right ──
     Closed state lives in CSS (off-screen + hidden) and JS toggles `is-open`.
     `visibility` is delayed on close so the panel finishes sliding out before
     it's removed from the a11y/hit-testing tree. */
  .fs-drawer {
    transform: translateX(100%);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease,
                visibility 0s linear 0.3s;
  }
  .fs-drawer.is-open {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease,
                visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-drawer, .fs-drawer.is-open { transition: none; }
  }

  /* Desktop "Get My Offer" button (white text/border) needs a brand-blue
     pill treatment when the nav is in light mode. */
  .nav-light .field .desktop-cta {
    background: #1f1f1f !important;
    color: #ffffff !important;
    border-color: #1f1f1f !important;
  }
  .nav-light .field .desktop-cta:hover {
    background: #000000 !important;
    border-color: #000000 !important;
  }

  /* Smooth fade-in for the address form when the nav transitions into
     its scrolled state. */
  @keyframes nav-form-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #nav-offer-form-wrap,
  #solid-nav-offer-form-wrap {
    animation: nav-form-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Slower, smoother background swap. The Tailwind utility on the nav
     already does background transitions but we explicitly tune it here. */
  #main-nav,
  #solid-nav {
    transition: background-color 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease !important;
  }
  #nav-logo,
  #solid-nav-logo {
    transition: opacity 0.3s ease;
  }
</style>

<!-- Site-wide tap feedback (press animation + haptic on every control). -->
<TapFeedback />

<!-- Top progress bar — controlled by Astro View Transitions lifecycle below -->
<div id="nav-progress-bar" data-astro-transition-persist="nav-progress-bar"></div>

{variant === 'transparent' ? (
  <!-- ─── TRANSPARENT NAV (homepage) ─── -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" style="background: transparent;">
    <div class="max-w-[1500px] mx-auto px-6 h-20 flex items-center gap-3 md:gap-0">
      <div class="shrink-0 md:flex-1">
        <a href="/" class="inline-flex items-center">
          <img src="/logo-mark.png" alt="FlipSplit" class="h-11 md:hidden" />
          <img id="nav-logo" src="/wordmark-dark.png" alt="FlipSplit" class="hidden md:block h-9" />
        </a>
      </div>

      <div id="nav-links" class="hidden md:flex items-center gap-8 text-[15px] font-medium">
        <a href="/how-it-works/" class="text-white/90 hover:text-white transition-colors">Sell</a>
        <div class="nav-dropdown-wrap">
          <button class="flex items-center gap-1 text-white/90 hover:text-white transition-colors text-[15px] font-medium">
            Where We Buy <svg class="nav-chevron mt-0.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="nav-dropdown">
            <a href="/location-la-county/" class="nav-drop-item">Los Angeles County</a>
            <a href="/location-orange-county/" class="nav-drop-item">Orange County</a>
            <a href="/location-riverside-county/" class="nav-drop-item">Riverside County</a>
            <a href="/location-san-bernardino-county/" class="nav-drop-item">San Bernardino County</a>
            <a href="/location-san-diego-county/" class="nav-drop-item">San Diego County</a>
          </div>
        </div>
        <a href="/reviews/" class="text-white/90 hover:text-white transition-colors">Reviews</a>
      </div>

      <div id="nav-offer-form-wrap" class="hidden min-w-0 flex-1 md:flex-1 md:max-w-md md:mx-auto">
        <form action="/" method="get" class="w-full">
          <div class="field flex items-center rounded-xl overflow-hidden border border-white/20" style="background: rgba(255,255,255,0.1);">
            <input type="text" name="address" placeholder="Enter home address" class="flex-1 min-w-0 bg-transparent text-white text-sm placeholder:text-white/60 focus:outline-none px-3 md:px-4 py-2.5" />
            <!-- Compact icon submit (visible on mobile) -->
            <button type="submit" class="submit-icon md:hidden shrink-0 w-9 h-9 mr-1.5 flex items-center justify-center rounded-lg transition-transform active:scale-95" aria-label="Search">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
            <!-- Wider "Get My Offer" button (desktop only) -->
            <button type="submit" class="desktop-cta hidden md:inline-flex shrink-0 text-white text-xs font-bold px-4 py-2.5 transition-all hover:bg-white/10 whitespace-nowrap rounded-lg" style="border: 1.5px solid rgba(255,255,255,0.7); background: transparent;">
              Get My Offer
            </button>
          </div>
        </form>
      </div>

      <div id="nav-right" class="shrink-0 md:flex-1 ml-auto md:ml-0 flex items-center justify-end gap-3 md:gap-5">
        <a id="t-signin-link" href="/sign-in/" class="hidden md:inline-block text-white/90 hover:text-white transition-colors text-[15px] font-medium">Sign in</a>
        <ProfileMenu prefix="t" />
        <button id="menu-toggle" class="md:hidden p-2 text-white transition-colors" aria-label="Toggle menu">
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="fs-drawer fixed inset-0 bg-white z-[60] flex flex-col">
      <div class="flex items-center justify-between px-6 h-20 border-b border-[#e6e6e2] shrink-0">
        <a href="/"><img src="/wordmark-on-white.png" alt="FlipSplit" class="h-9" /></a>
        <button id="menu-close" class="p-2 text-[#1f1f1f]" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="t-mobile-profile" class="hidden items-center gap-3 px-6 py-5 border-b border-[#e6e6e2] shrink-0" style="background:#f6f7ed;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center overflow-hidden shrink-0" style="background:#1f1f1f;">
          <img id="t-mobile-profile-avatar" alt="" class="w-full h-full object-cover hidden" />
          <span id="t-mobile-profile-initial" class="text-sm font-bold text-white">U</span>
        </div>
        <p id="t-mobile-profile-email" class="font-semibold text-[#1f1f1f] truncate"></p>
      </div>
      <div class="flex-1 overflow-y-auto px-6">
        <a href="/how-it-works/" class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sell</a>
        <details class="mobile-dropdown border-b border-[#e6e6e2]">
          <summary class="flex items-center justify-between py-6 text-2xl font-medium text-[#1f1f1f] cursor-pointer">
            <span>Where We Buy</span>
            <svg class="mobile-chevron text-[#1f1f1f]" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
          </summary>
          <div class="pb-5 ml-1 space-y-1">
            <a href="/location-la-county/" class="mobile-nav-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Los Angeles County</a>
            <a href="/location-orange-county/" class="mobile-nav-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Orange County</a>
            <a href="/location-riverside-county/" class="mobile-nav-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Riverside County</a>
            <a href="/location-san-bernardino-county/" class="mobile-nav-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">San Bernardino County</a>
            <a href="/location-san-diego-county/" class="mobile-nav-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">San Diego County</a>
          </div>
        </details>
        <a href="/reviews/" class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Reviews</a>
        <a id="t-mobile-signin-link" href="/sign-in/" class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sign in</a>
        <div id="t-mobile-account-links" class="hidden">
          <a href={`${APP_URL}/settings`} class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Account</a>
          <a href="/faq/" class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Help center</a>
        </div>
        <button id="t-mobile-signout-btn" class="hidden w-full text-left flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sign out</button>
      </div>
      <div class="p-6 shrink-0">
        <a href="#get-offer" class="mobile-nav-link flex items-center justify-between gap-3 p-4 rounded-xl bg-[#f6f7ed] hover:bg-[#f4f4f0] transition-colors">
          <div>
            <div class="font-bold text-[#1f1f1f] text-base">Ready to get started?</div>
            <div class="text-sm text-[#1f1f1f] mt-0.5">Get your free offer in 24–48 hours</div>
          </div>
          <svg class="text-[#1f1f1f] shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <script>
    // ── Nav progress bar wired to Astro View Transitions lifecycle ──
    // Visible flash of progress + slight delay on every internal click so
    // navigation feels intentional. Bar element lives in Nav (persisted).
    {
      const showBar = () => {
        const bar = document.getElementById('nav-progress-bar');
        if (!bar) return;
        bar.classList.remove('is-done', 'is-fade');
        // force reflow so transition restarts
        // eslint-disable-next-line @typescript-eslint/no-unused-expressions
        bar.offsetWidth;
        bar.classList.add('is-loading');
      };
      const completeBar = () => {
        const bar = document.getElementById('nav-progress-bar');
        if (!bar) return;
        bar.classList.remove('is-loading');
        bar.classList.add('is-done');
        // brief moment at 100%, then fade
        setTimeout(() => bar.classList.add('is-fade'), 120);
        // and finally reset
        setTimeout(() => {
          bar.classList.remove('is-done', 'is-fade');
        }, 600);
      };
      document.addEventListener('astro:before-preparation', showBar);
      document.addEventListener('astro:after-swap', completeBar);
      document.addEventListener('astro:page-load', completeBar);
    }

    // Auth UI (profile icon / sign-out swap) is handled by the shared,
    // ClientRouter-safe handler at the bottom of this component, so it
    // re-applies after every navigation.

    // Scroll-driven state (show the address form past the hero) and the mobile
    // hamburger are both handled by the shared, ClientRouter-safe handler at the
    // bottom of this component.
  </script>
) : (
  <!-- ─── SOLID NAV (all other pages — mirrors homepage scroll behavior) ─── -->
  <nav id="solid-nav" class="sticky top-0 z-50 bg-white border-b border-[#e6e6e2] transition-all duration-300">
    <div class="max-w-[1500px] mx-auto px-6 h-16 flex items-center gap-3 md:gap-0">
      <div class="shrink-0 md:flex-1">
        <a href="/" class="inline-flex items-center">
          <img src="/logo-mark.png" alt="FlipSplit" class="h-11 md:hidden" />
          <img id="solid-nav-logo" src="/wordmark-on-white.png" alt="FlipSplit" class="hidden md:block h-9" />
        </a>
      </div>

      <div id="solid-nav-links" class="hidden md:flex items-center gap-8 text-[15px] text-[#1f1f1f] font-medium">
        <a href="/how-it-works/" class="hover:text-[#1f1f1f] transition-colors">Sell</a>
        <div class="nav-dropdown-wrap">
          <button class="flex items-center gap-1 text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors text-[15px] font-medium">
            Where We Buy <svg class="nav-chevron mt-0.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="nav-dropdown">
            <a href="/location-la-county/" class="nav-drop-item">Los Angeles County</a>
            <a href="/location-orange-county/" class="nav-drop-item">Orange County</a>
            <a href="/location-riverside-county/" class="nav-drop-item">Riverside County</a>
            <a href="/location-san-bernardino-county/" class="nav-drop-item">San Bernardino County</a>
            <a href="/location-san-diego-county/" class="nav-drop-item">San Diego County</a>
          </div>
        </div>
        <a href="/reviews/" class="hover:text-[#1f1f1f] transition-colors">Reviews</a>
      </div>

      <div id="solid-nav-offer-form-wrap" class="hidden min-w-0 flex-1 md:flex-1 md:max-w-md md:mx-auto">
        <form action="/" method="get" class="w-full">
          <div class="field flex items-center rounded-xl overflow-hidden border border-white/20" style="background: rgba(255,255,255,0.1);">
            <input type="text" name="address" placeholder="Enter home address" class="flex-1 min-w-0 bg-transparent text-white text-sm placeholder:text-white/60 focus:outline-none px-3 md:px-4 py-2.5" />
            <button type="submit" class="submit-icon md:hidden shrink-0 w-9 h-9 mr-1.5 flex items-center justify-center rounded-lg transition-transform active:scale-95" aria-label="Search">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
            <button type="submit" class="desktop-cta hidden md:inline-flex shrink-0 text-white text-xs font-bold px-4 py-2.5 transition-all hover:bg-white/10 whitespace-nowrap rounded-lg" style="border: 1.5px solid rgba(255,255,255,0.7); background: transparent;">
              Get My Offer
            </button>
          </div>
        </form>
      </div>

      <div id="solid-nav-right" class="shrink-0 md:flex-1 ml-auto md:ml-0 flex items-center justify-end gap-3 md:gap-5">
        <a id="s-signin-link" href="/sign-in/" class="hidden md:inline-block text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors text-[15px] font-medium">Sign in</a>
        <ProfileMenu prefix="s" />
        <button id="solid-menu-toggle" class="md:hidden p-2 text-[#1f1f1f]" aria-label="Toggle menu">
          <svg id="solid-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="solid-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div id="solid-mobile-menu" class="fs-drawer md:hidden fixed inset-0 bg-white z-[60] flex flex-col">
      <div class="flex items-center justify-between px-6 h-16 border-b border-[#e6e6e2] shrink-0">
        <a href="/"><img src="/wordmark-on-white.png" alt="FlipSplit" class="h-9" /></a>
        <button id="solid-menu-close" class="p-2 text-[#1f1f1f]" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="s-mobile-profile" class="hidden items-center gap-3 px-6 py-5 border-b border-[#e6e6e2] shrink-0" style="background:#f6f7ed;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center overflow-hidden shrink-0" style="background:#1f1f1f;">
          <img id="s-mobile-profile-avatar" alt="" class="w-full h-full object-cover hidden" />
          <span id="s-mobile-profile-initial" class="text-sm font-bold text-white">U</span>
        </div>
        <p id="s-mobile-profile-email" class="font-semibold text-[#1f1f1f] truncate"></p>
      </div>
      <div class="flex-1 overflow-y-auto px-6">
        <a href="/how-it-works/" class="solid-mobile-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sell</a>
        <details class="mobile-dropdown border-b border-[#e6e6e2]">
          <summary class="flex items-center justify-between py-6 text-2xl font-medium text-[#1f1f1f] cursor-pointer">
            <span>Where We Buy</span>
            <svg class="mobile-chevron text-[#1f1f1f]" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
          </summary>
          <div class="pb-5 ml-1 space-y-1">
            <a href="/location-la-county/" class="solid-mobile-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Los Angeles County</a>
            <a href="/location-orange-county/" class="solid-mobile-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Orange County</a>
            <a href="/location-riverside-county/" class="solid-mobile-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">Riverside County</a>
            <a href="/location-san-bernardino-county/" class="solid-mobile-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">San Bernardino County</a>
            <a href="/location-san-diego-county/" class="solid-mobile-link block text-base text-[#1f1f1f] hover:text-[#1f1f1f] transition-colors py-2">San Diego County</a>
          </div>
        </details>
        <a href="/reviews/" class="solid-mobile-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Reviews</a>
        <a id="s-mobile-signin-link" href="/sign-in/" class="solid-mobile-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sign in</a>
        <div id="s-mobile-account-links" class="hidden">
          <a href={`${APP_URL}/settings`} class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Account</a>
          <a href="/faq/" class="mobile-nav-link flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Help center</a>
        </div>
        <button id="s-mobile-signout-btn" class="hidden w-full text-left flex items-center justify-between py-6 border-b border-[#e6e6e2] text-2xl font-medium text-[#1f1f1f]">Sign out</button>
      </div>
      <div class="p-6 shrink-0">
        <a href="/request-offer/" class="solid-mobile-link flex items-center justify-between gap-3 p-4 rounded-xl bg-[#f6f7ed] hover:bg-[#f4f4f0] transition-colors">
          <div>
            <div class="font-bold text-[#1f1f1f] text-base">Ready to get started?</div>
            <div class="text-sm text-[#1f1f1f] mt-0.5">Get your free offer in 24–48 hours</div>
          </div>
          <svg class="text-[#1f1f1f] shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <script>
    // Auth UI, scroll-driven state, and the mobile hamburger are all handled by
    // the shared, ClientRouter-safe handler at the bottom of this component.
  </script>
)}

<!-- Shared, ClientRouter-safe nav interactivity for both nav variants.
     Listeners live on `document`/`window`, which persist across Astro view-
     transition swaps, and elements are re-queried on each event. A run-once
     guard stops them from stacking, since ClientRouter re-executes inline
     scripts on every navigation. This replaces the old approach of binding
     straight to elements on first load, which silently died (no hamburger, no
     scroll-reveal) on every page reached by in-app navigation. -->
<script>
  import { getSupabase } from '../lib/supabase';

  if (!(window as any).__fsNavWired) {
    (window as any).__fsNavWired = true;

    // ── Mobile hamburger open/close (delegated) ──
    const fsSetMenu = (menu: HTMLElement | null, open: boolean) => {
      if (!menu) return;
      menu.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const FS_MENUS = [
      { toggle: 'menu-toggle',       close: 'menu-close',       menu: 'mobile-menu' },
      { toggle: 'solid-menu-toggle', close: 'solid-menu-close', menu: 'solid-mobile-menu' },
    ];

    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      for (const m of FS_MENUS) {
        const menu = document.getElementById(m.menu);
        // Tap the hamburger → toggle that variant's menu.
        if (el.closest('#' + m.toggle)) {
          fsSetMenu(menu, !(menu?.classList.contains('is-open') ?? false));
          return;
        }
        // Tap the X, or any link inside an open menu → close it.
        const anchor = el.closest('a[href]');
        if (el.closest('#' + m.close) || (anchor && menu?.contains(anchor))) {
          fsSetMenu(menu, false);
          return;
        }
      }
    });

    // ── Scroll state: past the hero (480px) the bar goes white and reveals
    //    the address form. Re-queries elements each call so it targets the
    //    current page's nav after a ClientRouter swap. ──
    const fsApplyNavScroll = () => {
      const scrolled = window.scrollY > 480;

      // Transparent variant (homepage hero overlay).
      const nav = document.getElementById('main-nav');
      if (nav) {
        const logo = document.getElementById('nav-logo') as HTMLImageElement | null;
        const links = document.getElementById('nav-links');
        const form = document.getElementById('nav-offer-form-wrap');
        nav.classList.toggle('nav-light', scrolled);
        nav.style.background = scrolled ? '#ffffff' : 'transparent';
        if (logo) logo.src = scrolled ? '/wordmark-on-white.png' : '/wordmark-dark.png';
        if (links) links.style.display = scrolled ? 'none' : '';
        if (form) form.style.display = scrolled ? 'flex' : 'none';
      }

      // Solid variant (every other page).
      const solidNav = document.getElementById('solid-nav');
      if (solidNav) {
        const links = document.getElementById('solid-nav-links');
        const form = document.getElementById('solid-nav-offer-form-wrap');
        solidNav.classList.toggle('nav-light', scrolled);
        solidNav.style.background = scrolled ? '#ffffff' : '';
        if (links) links.style.display = scrolled ? 'none' : '';
        if (form) form.style.display = scrolled ? 'flex' : 'none';
      }
    };

    window.addEventListener('scroll', fsApplyNavScroll, { passive: true });
    window.addEventListener('resize', fsApplyNavScroll);
    // Re-apply on initial load and after every ClientRouter navigation.
    document.addEventListener('astro:page-load', fsApplyNavScroll);
    fsApplyNavScroll();

    // ── Auth UI: swap the "Sign in" link for a profile icon + sign-out when
    //    logged in. We subscribe once, cache the user, and re-apply to the
    //    (re-created) DOM on every navigation. Dropdown toggle, outside-click
    //    close, and sign-out are delegated so they survive ClientRouter swaps.
    //    Handles both nav variants by id prefix: 't' (transparent), 's' (solid).
    const fsSupabase = getSupabase();
    const fsAppUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.flipsplit.com';
    let fsUser: any = null;
    // Cached offer requests for the signed-in user. null = not fetched yet.
    let fsRequests: Array<{ id: string; address: string; status: string }> | null = null;

    // Initials: first letter of first + last name, uppercase. Falls back to the
    // first letter of the email so the avatar is never blank.
    const fsInitials = (u: any) => {
      const meta = u?.user_metadata ?? {};
      const name = (meta.full_name || [meta.first_name, meta.last_name].filter(Boolean).join(' ') || '').trim();
      const parts = name ? name.split(/\s+/).filter(Boolean) : [];
      if (parts.length) {
        return ((parts[0][0] || '') + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
      }
      return (u?.email?.[0] || 'U').toUpperCase();
    };

    // Status line under each address — mirrors the portal's own gates.
    const fsStatus = (row: any) => {
      if (row.offer_accepted_at) return 'Offer accepted';
      if (row.offer_amount_cents != null) return 'Offer ready';
      if (row.photos_submitted_at) return 'In review';
      return 'In progress';
    };

    const fsEsc = (v: string) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
      )[c]);

    // Street line only, matching the portal's address treatment.
    const fsStreet = (row: any) => {
      if (row.street) return row.street;
      const first = String(row.address || '').split(',')[0];
      return first.trim();
    };

    const fsHouseSvg =
      '<span class="fs-pm-prop__icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1f1f1f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"></path><path d="M5 9.5V21h14V9.5"></path></svg></span>';

    const fsRenderRequests = (p: string) => {
      const host = document.getElementById(`${p}-offer-list`);
      if (!host) return;
      if (fsRequests === null) {
        host.innerHTML = '<div class="px-3 py-3" style="font-size:13px;color:#8a8a83;">Loading…</div>';
        return;
      }
      if (!fsRequests.length) {
        host.innerHTML =
          '<div class="fs-pm-empty">No requests yet. <a href="/">Get your offer</a></div>';
        return;
      }
      // The href deliberately carries no session tokens — a copied or
      // middle-clicked link must never contain credentials. Tokens are
      // appended to the hash only on a genuine left-click, below.
      host.innerHTML = fsRequests.map((r) => (
        `<a class="fs-pm-prop" role="menuitem" data-fs-handoff="1" href="${fsEsc(fsAppUrl)}/?session_id=${encodeURIComponent(r.id)}">` +
        fsHouseSvg +
        `<span style="flex:1;min-width:0;">` +
        `<span class="fs-pm-prop__addr">${fsEsc(r.address)}</span>` +
        `<span class="fs-pm-prop__status">${fsEsc(r.status)}</span>` +
        `</span></a>`
      )).join('');
    };

    // Fetch the user's submitted offer requests once per sign-in. Deduped by
    // normalized address the same way the portal does, so repeated funnel runs
    // on one property don't show up as duplicates.
    const fsLoadRequests = async () => {
      if (!fsUser || fsUser.is_anonymous) { fsRequests = null; return; }
      const { data, error } = await fsSupabase
        .from('qualification_sessions')
        .select('id, address, street, offer_amount_cents, offer_accepted_at, photos_submitted_at, created_at')
        .eq('user_id', fsUser.id)
        .order('created_at', { ascending: false });
      if (error) { fsRequests = []; fsApplyAuth(); return; }
      const norm = (a: string) => (a || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
      const seen = new Set<string>();
      fsRequests = [];
      for (const row of (data || [])) {
        const key = norm(row.address) || row.id;
        if (seen.has(key)) continue;
        seen.add(key);
        fsRequests.push({ id: row.id, address: fsStreet(row) || 'Your property', status: fsStatus(row) });
      }
      fsApplyAuth();
    };

    const fsApplyAuthFor = (p: string) => {
      const wrap = document.getElementById(`${p}-profile-wrap`);
      if (!wrap) return; // this variant isn't the one rendered on this page
      const signin   = document.getElementById(`${p}-signin-link`);
      const initEl   = document.getElementById(`${p}-profile-initial`);
      const menu     = document.getElementById(`${p}-profile-menu`);
      const mSignin  = document.getElementById(`${p}-mobile-signin-link`);
      const mSignout = document.getElementById(`${p}-mobile-signout-btn`);
      const mProfile = document.getElementById(`${p}-mobile-profile`);
      const mInit    = document.getElementById(`${p}-mobile-profile-initial`);
      const mEmail   = document.getElementById(`${p}-mobile-profile-email`);
      const mExtras  = document.getElementById(`${p}-mobile-account-links`);

      const signedIn = !!fsUser && !fsUser.is_anonymous;
      if (signedIn) {
        // Hide "Sign in", show the profile button at md+ only. Use !important
        // because the `.nav-light #*-signin-link` scrolled-bar rule forces the
        // link visible with !important and would otherwise win over a plain
        // inline style — leaving "Sign in" showing for logged-in users.
        if (signin) signin.style.setProperty('display', 'none', 'important');
        wrap.classList.remove('hidden');
        wrap.style.display = window.innerWidth >= 768 ? 'block' : 'none';
        // Mobile menu: swap the Sign in link for the profile row + Sign out.
        mSignin?.classList.add('hidden');
        mSignout?.classList.remove('hidden');
        mProfile?.classList.remove('hidden');
        if (mProfile) mProfile.style.display = 'flex';
        mExtras?.classList.remove('hidden');
        const email = fsUser.email || '';
        if (mEmail) mEmail.textContent = email;
        const initial = fsInitials(fsUser);
        if (initEl) initEl.textContent = initial;
        if (mInit) mInit.textContent = initial;
        fsRenderRequests(p);
      } else {
        if (signin) signin.style.removeProperty('display');
        wrap.classList.add('hidden');
        wrap.style.display = '';
        mSignin?.classList.remove('hidden');
        mSignout?.classList.add('hidden');
        mProfile?.classList.add('hidden');
        if (mProfile) mProfile.style.display = '';
        mExtras?.classList.add('hidden');
        menu?.classList.add('hidden');
        // Tell /sign-in/ where to put them back. Signing in is not a request to
        // leave the page they're reading — it just makes them signed in on it.
        // Re-read per navigation because ClientRouter swaps the page under us.
        const back = window.location.pathname + window.location.search;
        const href = `/sign-in/?next=${encodeURIComponent(back)}`;
        signin?.setAttribute('href', href);
        mSignin?.setAttribute('href', href);
      }
    };

    const fsApplyAuth = () => { fsApplyAuthFor('t'); fsApplyAuthFor('s'); };

    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;

      // ── Cross-origin sign-in handoff ──────────────────────────────────
      // The portal is a separate origin, so it has its own localStorage and
      // its own Supabase session. Without this, a user signed in here lands
      // there as whoever the portal last saw — or as nobody.
      //
      // Tokens ride in the URL *hash*: fragments are never sent to a server
      // and never appear in a Referer header. The portal strips them before
      // it does anything else. Same shape as Supabase's own OAuth redirect.
      //
      // Only plain left-clicks are intercepted. Cmd/ctrl/middle-click falls
      // through to the token-free href, so a link opened in a new tab or
      // copied to the clipboard never carries credentials.
      const handoff = el.closest('a[data-fs-handoff]') as HTMLAnchorElement | null;
      if (handoff) {
        const me = e as MouseEvent;
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button !== 0) return;
        e.preventDefault();
        const href = handoff.getAttribute('href') || '';
        fsSupabase.auth.getSession().then(({ data }) => {
          const s = data.session;
          const url = (s?.access_token && s?.refresh_token)
            ? `${href}#fs_at=${encodeURIComponent(s.access_token)}&fs_rt=${encodeURIComponent(s.refresh_token)}`
            : href;
          window.location.assign(url);
        }, () => window.location.assign(href));
        return;
      }

      // Profile button → toggle that variant's dropdown.
      const btn = el.closest('#t-profile-btn, #s-profile-btn') as HTMLElement | null;
      if (btn) {
        const p = btn.id.charAt(0);
        const menu = document.getElementById(`${p}-profile-menu`);
        const willShow = menu?.classList.contains('hidden') ?? false;
        menu?.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(willShow));
        return;
      }
      // Any sign-out button (desktop dropdown or mobile menu).
      if (el.closest('#t-signout-btn, #s-signout-btn, #t-mobile-signout-btn, #s-mobile-signout-btn')) {
        fsSupabase.auth.signOut().then(() => window.location.assign('/'));
        return;
      }
      // Click anywhere outside an open dropdown → close it.
      for (const p of ['t', 's']) {
        const wrap = document.getElementById(`${p}-profile-wrap`);
        if (wrap && !wrap.contains(el)) {
          document.getElementById(`${p}-profile-menu`)?.classList.add('hidden');
          document.getElementById(`${p}-profile-btn`)?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    // Escape closes an open popover and returns focus to its trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      for (const p of ['t', 's']) {
        const menu = document.getElementById(`${p}-profile-menu`);
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          const btn = document.getElementById(`${p}-profile-btn`);
          btn?.setAttribute('aria-expanded', 'false');
          (btn as HTMLElement | null)?.focus();
        }
      }
    });

    // Keep the desktop profile button from showing at mobile widths.
    window.addEventListener('resize', () => {
      for (const p of ['t', 's']) {
        const wrap = document.getElementById(`${p}-profile-wrap`);
        if (wrap && wrap.style.display && wrap.style.display !== '') {
          wrap.style.display = window.innerWidth >= 768 ? 'block' : 'none';
        }
      }
    });

    const fsOnUser = (u: any) => {
      const changed = (fsUser?.id || null) !== (u?.id || null);
      fsUser = u;
      if (changed) fsRequests = null;
      fsApplyAuth();
      if (changed && u && !u.is_anonymous) fsLoadRequests();
    };

    fsSupabase.auth.getUser().then(({ data }) => fsOnUser(data.user));
    fsSupabase.auth.onAuthStateChange((_e, session) => fsOnUser(session?.user || null));
    document.addEventListener('astro:page-load', fsApplyAuth);
  }
</script>
